{
  "pages": [
    "pages/splash/splash",
    "pages/index/index",
    "pages/today/today",
    "pages/plan/plan",
    "pages/more/more",
    "pages/myguides/myguides",
    "pages/help/help"
  ],
  "window": {
    "navigationBarTitleText": "旅行攻略",
    "navigationBarBackgroundColor": "#eaeff7",
    "navigationBarTextStyle": "black",
    "backgroundColor": "#eaeff7",
    "backgroundTextStyle": "dark"
  },
  "tabBar": {
    "color": "#5b6b82",
    "selectedColor": "#d4a94e",
    "backgroundColor": "#ffffff",
    "borderStyle": "white",
    "list": [
      {
        "pagePath": "pages/index/index",
        "text": "出发",
        "iconPath": "images/tab-light-index.png",
        "selectedIconPath": "images/tab-index-active.png"
      },
      {
        "pagePath": "pages/today/today",
        "text": "今天",
        "iconPath": "images/tab-light-today.png",
        "selectedIconPath": "images/tab-today-active.png"
      },
      {
        "pagePath": "pages/plan/plan",
        "text": "行程",
        "iconPath": "images/tab-light-plan.png",
        "selectedIconPath": "images/tab-plan-active.png"
      },
      {
        "pagePath": "pages/more/more",
        "text": "更多",
        "iconPath": "images/tab-light-more.png",
        "selectedIconPath": "images/tab-more-active.png"
      }
    ]
  },
  "style": "v2",
  "sitemapLocation": "sitemap.json",
  "lazyCodeLoading": "requiredComponents",
  "subPackages": [
    {
      "root": "subpkg",
      "pages": [
        "map/map",
        "food/food",
        "ledger/ledger",
        "prep/prep",
        "assistant/assistant",
        "guide/guide",
        "toolkit/toolkit",
        "spotsearch/spotsearch"
      ]
    },
    {
      "root": "subdata",
      "pages": [
        "boost/boost"
      ]
    },
    {
      "root": "subdata2",
      "pages": ["keep/keep"]
    },
    {
      "root": "subdata3",
      "pages": ["keep/keep"]
    },
    {
      "root": "subai",
      "pages": [
        "deep/deep"
      ]
    }
  ],
  "preloadRule": {
    "pages/index/index": {
      "network": "all",
      "packages": ["subpkg"]
    },
    "pages/plan/plan": {
      "network": "wifi",
      "packages": ["subdata"]
    }
  }
}
