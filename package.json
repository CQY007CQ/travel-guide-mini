{
  "name": "travel-guide-mini-toolchain",
  "private": true,
  "description": "旅行攻略生成器（晨的旅行助手）小程序 —— 构建与回归工具链。小程序代码本身不经 npm 构建，此处只声明 tools/ 用到的 Node 依赖。",
  "scripts": {
    "check": "./allcheck.sh",
    "apply": "node tools/_apply-safe.mjs",
    "pack": "node tools/pack-data.mjs",
    "minify": "node tools/build-min.mjs",
    "check-deps": "node tools/check-deps.mjs",
    "release-check": "node tools/verify-release.mjs"
  },
  "devDependencies": {
    "terser": "^5.51.2"
  },
  "engines": {
    "node": ">=18"
  }
}
