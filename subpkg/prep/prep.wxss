.page { padding-bottom: 80rpx; }
.note { font-size: calc(24rpx * var(--fs, 1)); line-height: 1.7; }
.tk-sum { font-size: calc(22rpx * var(--fs, 1)); color: var(--t3, #8fa3bc); margin: 2rpx 0 8rpx; }
.tk-head { margin: 4rpx 0 12rpx; }
.tk-est { font-size: calc(22rpx * var(--fs, 1)); color: var(--t2, #c9d4e4); margin-bottom: 10rpx; }
.tk-bar { height: 10rpx; border-radius: 99rpx; background: rgba(var(--ln-rgb, 148,163,184), .14); overflow: hidden; }
.tk-fill { height: 100%; border-radius: 99rpx; background: linear-gradient(90deg, #5fb98a, #a3e0a0); transition: width .3s; }
.tk-item { padding: 20rpx 6rpx; border-bottom: 1rpx solid rgba(var(--ln-rgb, 148,163,184),.07); border-radius: 14rpx; }
.tk-item:active { background: rgba(var(--ln-rgb, 138,165,192),.04); }
.tk-item:last-child { border-bottom: none; }
.tk-row { display: flex; align-items: flex-start; }
.tk-dot { width: 42rpx; height: 42rpx; border-radius: 50%; border: 2rpx solid rgba(var(--ln-rgb, 148,163,184),.5); box-sizing: border-box;
  display: flex; align-items: center; justify-content: center; margin: 2rpx 18rpx 0 0; flex-shrink: 0;
  color: #0b0f14; font-size: calc(24rpx * var(--fs, 1)); font-weight: 800; transition: all .15s; }
.tk-dot.on { background: linear-gradient(135deg, #37c285, #2aa374); border-color: #37c285;
  box-shadow: 0 6rpx 16rpx rgba(55,194,133,.35); }
.tk-main { flex: 1; min-width: 0; }
.tk-name-line { display: flex; align-items: center; flex-wrap: wrap; }
.tk-name { font-size: calc(27rpx * var(--fs, 1)); color: var(--t1, #eaeff7); }
.tk-name.done { color: var(--t3, #7d92ab); text-decoration: line-through; }
.tk-seg { font-size: calc(18rpx * var(--fs, 1)); color: var(--green, #b9cdc0); background: rgba(96,192,140,.16); border-radius: 6rpx; padding: 2rpx 10rpx; margin-left: 10rpx; }
.tk-book { font-size: calc(19rpx * var(--fs, 1)); color: var(--red, #e56a6a); border: 1rpx solid rgba(229,106,106,.4); border-radius: 99rpx; padding: 2rpx 12rpx; margin-left: 10rpx; }
.tk-where { display: block; font-size: calc(21rpx * var(--fs, 1)); color: var(--t3, #8fa3bc); margin-top: 6rpx; }
.tk-price { font-size: calc(25rpx * var(--fs, 1)); color: var(--chip-tx, #d4a94e); font-weight: 700; margin-left: 20rpx; flex-shrink: 0; }
.tk-ops { display: flex; flex-wrap: wrap; align-items: center; margin: 12rpx 0 0 60rpx; gap: 12rpx; }
.tk-op { font-size: calc(21rpx * var(--fs, 1)); color: var(--t3, #8fa3bc); border: 1rpx solid rgba(var(--ln-rgb, 148,163,184),.3); border-radius: 99rpx; padding: 4rpx 18rpx; }
.tk-op:active { opacity: .7; }
.tk-op.set { color: var(--chip-tx, #d4a94e); border-color: rgba(212,169,78,.5); background: rgba(212,169,78,.08); }
.tk-op-note { font-size: calc(21rpx * var(--fs, 1)); color: var(--t2, #c9d4e4); border: 1rpx dashed rgba(var(--ln-rgb, 148,163,184),.35); border-radius: 99rpx; padding: 4rpx 18rpx; }
.tk-note { margin: 12rpx 0 0 60rpx; font-size: calc(23rpx * var(--fs, 1)); color: var(--t2, #c9d4e4); background: rgba(var(--ln-rgb, 148,163,184),.08);
  border-radius: 10rpx; padding: 10rpx 18rpx; height: auto; }
.tip-inner { font-size: calc(21rpx * var(--fs, 1)); margin-top: 14rpx; color: var(--blue, #7db4e8);
  background: rgba(125,180,232,.06); border: 1rpx dashed rgba(125,180,232,.2);
  border-radius: 12rpx; padding: 14rpx 18rpx; line-height: 1.6; }
.tip-line { font-size: calc(25rpx * var(--fs, 1)); color: var(--t3, #8fa3bc); line-height: 1.75; padding: 16rpx 6rpx; border-bottom: 1rpx solid rgba(var(--ln-rgb, 148,163,184),.06); }
.tip-line:last-child { border-bottom: none; }
.duty { display: flex; padding: 18rpx 6rpx; border-bottom: 1rpx solid rgba(var(--ln-rgb, 148,163,184),.07); }
.duty:last-child { border-bottom: none; }
.duty-who { width: 180rpx; font-size: calc(27rpx * var(--fs, 1)); font-weight: 700; color: var(--chip-tx, #d4a94e); flex-shrink: 0; }
.duty-list { flex: 1; display: flex; flex-direction: column; }
.duty-item { font-size: calc(24rpx * var(--fs, 1)); color: var(--t2, #c9d4e4); line-height: 1.9; }

/* 应急电话 */
.sos-grid { display: flex; flex-wrap: wrap; gap: 14rpx; margin-top: 14rpx; padding: 0 26rpx; }
.sos-it { width: calc((100% - 28rpx) / 3); display: flex; flex-direction: column; align-items: center;
  padding: 18rpx 0; border-radius: 16rpx; background: rgba(var(--ln-rgb, 148,163,184),.09); }
.sos-it:active { background: rgba(212,169,78,.16); }
.sos-n { font-size: calc(32rpx * var(--fs, 1)); font-weight: 800; color: var(--chip-tx, #d4a94e); }
.sos-l { font-size: calc(20rpx * var(--fs, 1)); color: var(--t3, #8fa3bc); margin-top: 4rpx; }

/* ===== v1.5 · 智能行李清单 ===== */
.pk-sum { font-size: calc(22rpx * var(--fs, 1)); color: var(--t2, #c9d4e4); margin: 8rpx 0 10rpx; }
.pk-bar { height: 10rpx; border-radius: 99rpx; background: rgba(var(--ln-rgb, 148,163,184), .14); overflow: hidden; }
.pk-fill { height: 100%; border-radius: 99rpx; background: linear-gradient(90deg, #d4a94e, #e8c05e); transition: width .3s; }
.pk-gt { font-size: calc(22rpx * var(--fs, 1)); font-weight: 800; color: var(--t2, #c9d4e4); margin: 22rpx 0 4rpx; padding-left: 10rpx;
  border-left: 5rpx solid rgba(212,169,78,.55); }
.pk-item { display: flex; align-items: flex-start; padding: 14rpx 8rpx;
  border-bottom: 1rpx solid rgba(var(--ln-rgb, 148,163,184), .07); }
.pk-item:active { background: rgba(var(--ln-rgb, 138,165,192), .05); border-radius: 12rpx; }
.pk-item.done { opacity: .5; }
.pk-item.done .pk-tx { text-decoration: line-through; }
.pk-box { width: 40rpx; color: var(--chip-tx, #d4a94e); font-size: calc(28rpx * var(--fs, 1)); }
.pk-tx { font-size: calc(26rpx * var(--fs, 1)); line-height: 1.45; flex: 1; color: var(--t1, #eaeff7); }

/* ===== v1.7 · 证件与出行必备 ===== */
.doc-n { font-size: calc(21rpx * var(--fs, 1)); font-weight: 700; color: var(--gold-tx, #d4a94e); }
.doc-item {
  display: flex; align-items: flex-start; gap: 14rpx;
  padding: 12rpx 0; border-bottom: 1rpx solid rgba(var(--ln-rgb, 148, 163, 184), .08);
}
.doc-item:last-child { border-bottom: none; }
.doc-txt { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 2rpx; }
.doc-t { font-size: calc(25rpx * var(--fs, 1)); font-weight: 600; color: var(--t1, #eaeff7); }
.doc-x { font-size: calc(20rpx * var(--fs, 1)); line-height: 1.5; }
.doc-item.done .doc-t { color: var(--t3, #8fa3bc); text-decoration: line-through; }


/* ===== v1.8.3 · 证件段进度条与勾选（此前缺定义，进度条不可见） ===== */
.box {
  width: 40rpx; height: 40rpx; flex-shrink: 0; margin-top: 2rpx;
  border: 2rpx solid rgba(var(--ln-rgb, 148, 163, 184), .45);
  border-radius: 10rpx; box-sizing: border-box;
  display: flex; align-items: center; justify-content: center;
  color: #14100a; font-size: calc(28rpx * var(--fs, 1)); font-weight: 800; line-height: 1;
}
.box.on {
  background: linear-gradient(135deg, #e2b65c, #b8892f);
  border-color: transparent;
}
.prog { display: flex; align-items: center; gap: 18rpx; margin-top: 16rpx; }
.bar { flex: 1; height: 10rpx; border-radius: 10rpx; background: rgba(var(--ln-rgb, 148, 163, 184),.14); overflow: hidden; }
.fill { height: 100%; border-radius: 10rpx;
  background: linear-gradient(90deg, #e2b65c, #d4a94e);
  box-shadow: 0 0 12rpx rgba(212,169,78,.4); }
.sp-tip { font-size: calc(20rpx * var(--fs, 1)); margin: 12rpx 26rpx 0; line-height: 1.5; }
.sos-card { border-color: rgba(229, 106, 106, .25); }
