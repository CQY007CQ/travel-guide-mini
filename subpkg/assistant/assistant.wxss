.page { display: flex; flex-direction: column; min-height: 100vh; box-sizing: border-box; padding-bottom: 24rpx; }
.head { margin-bottom: 24rpx; }
.h2 { font-size: calc(32rpx * var(--fs, 1)); }
.h2 .ic { width: 36rpx; height: 36rpx; vertical-align: -4rpx; margin-right: 10rpx; }
.ctx { font-size: calc(23rpx * var(--fs, 1)); color: var(--t3, #8fa3bc); margin: 10rpx 0 18rpx; line-height: 1.6; }

/* 一键查：卡片网格（2 列） */
.tiles { display: flex; flex-wrap: wrap; margin: 0 -10rpx 18rpx; }
.tile { width: calc(25% - 20rpx); margin: 0 10rpx 18rpx; padding: 18rpx 6rpx; border-radius: 16rpx;
  background: var(--panel, #18233a); border: 1rpx solid rgba(var(--ln-rgb,148,163,184),.12);
  display: flex; flex-direction: column; align-items: center; box-shadow: 0 4rpx 16rpx rgba(3,7,18,.2); }
.tile:active { background: rgba(var(--ln-rgb,148,163,184),.08); }
.tile-ic { width: 44rpx; height: 44rpx; margin-bottom: 8rpx; }
.tile-t { font-size: calc(22rpx * var(--fs, 1)); color: var(--t1, #dce5f0); text-align: center; line-height: 1.3; }

/* 自由查：搜索框 */
.search { display: flex; align-items: center; padding: 8rpx 0 4rpx; }
.inp { flex: 1; background: var(--card, #131d31); border: 1rpx solid rgba(var(--ln-rgb,148,163,184),.18); border-radius: 999rpx;
  padding: 16rpx 26rpx; font-size: calc(26rpx * var(--fs, 1)); color: var(--t1, #eaeff7); box-shadow: 0 8rpx 24rpx rgba(3,7,18,.3); }
.btn { margin-left: 14rpx; background: linear-gradient(135deg, #e2b65c, #d4a94e 45%, #b8892f); color: #14100a;
  font-weight: 800; border-radius: 999rpx; padding: 16rpx 32rpx; font-size: calc(26rpx * var(--fs, 1));
  box-shadow: 0 8rpx 22rpx rgba(212,169,78,.2); }
.btn:active { opacity: .85; }

/* 结果区 */
.result .r-q { font-size: calc(23rpx * var(--fs, 1)); color: var(--t3, #8fa3bc); margin-bottom: 12rpx; }
.result .r-a { font-size: calc(27rpx * var(--fs, 1)); color: var(--t1, #dce5f0); line-height: 1.7; white-space: pre-wrap;
  word-break: break-word; padding: 18rpx 22rpx; background: var(--panel, #18233a);
  border: 1rpx solid rgba(var(--ln-rgb,148,163,184),.12); border-radius: 18rpx; }

/* 收藏行 */
.keep-line { display: flex; flex-wrap: wrap; gap: 12rpx; margin-top: 16rpx; }
.keep-btn { font-size: calc(22rpx * var(--fs, 1)); color: var(--t3, #8fa3bc); border: 1rpx dashed rgba(var(--ln-rgb,148,163,184),.35);
  border-radius: 999rpx; padding: 6rpx 20rpx; }
.keep-btn:active { color: var(--chip-tx, #d4a94e); }
.keep-btn-2 { border-style: solid; }

/* 收藏列表 */
.keeps .keep-it { font-size: calc(24rpx * var(--fs, 1)); color: var(--t2, #c9d4e4); line-height: 1.6; padding: 12rpx 0;
  border-bottom: 1rpx solid rgba(var(--ln-rgb,148,163,184),.06); white-space: pre-wrap; word-break: break-word; }
.keep-clear { font-size: calc(24rpx * var(--fs, 1)); color: var(--red, #e56a6a); text-align: right; padding-top: 12rpx; }

/* ══ v1.19.31 · 查景点模式 ══ */
.mode-tip { display: flex; align-items: center; gap: 12rpx; margin: 6rpx 0 14rpx;
  background: rgba(212,169,78,.12); border: 1rpx solid rgba(212,169,78,.3); border-radius: 14rpx; padding: 12rpx 16rpx; }
.mode-tip text { flex: 1; font-size: calc(22rpx * var(--fs, 1)); color: var(--chip-tx, #d4a94e); line-height: 1.5; }
.mode-exit { flex: none; font-size: calc(22rpx * var(--fs, 1)); color: var(--chip-tx, #d4a94e);
  border: 1rpx solid rgba(212,169,78,.45); border-radius: 999rpx; padding: 4rpx 18rpx; }
.mode-exit:active { background: rgba(212,169,78,.18); }

/* 查景点结果卡 */
.spot { margin-bottom: 24rpx; }
.spot .spot-city { font-size: calc(24rpx * var(--fs, 1)); color: var(--t3, #8fa3bc); font-weight: 400; }
.spot-sec { padding: 14rpx 0; border-top: 1rpx solid rgba(var(--ln-rgb,148,163,184),.08); }
.spot-sec:first-of-type { border-top: none; padding-top: 4rpx; }
.spot-lab { font-size: calc(23rpx * var(--fs, 1)); color: var(--chip-tx, #d4a94e); font-weight: 700; margin-bottom: 8rpx; }
.spot-txt { font-size: calc(27rpx * var(--fs, 1)); color: var(--t1, #dce5f0); line-height: 1.75; white-space: pre-wrap; word-break: break-word; }
.spot-tag { display: inline-block; margin-left: 12rpx; font-size: calc(20rpx * var(--fs, 1)); color: #fff;
  background: var(--red, #e56a6a); border-radius: 8rpx; padding: 2rpx 12rpx; vertical-align: 2rpx; }
.spot-empty { font-size: calc(25rpx * var(--fs, 1)); color: var(--t3, #8fa3bc); line-height: 1.7; padding: 8rpx 0; }

/* 查景点：当前行程景点快速入口 */
.pspots { margin: 2rpx 0 16rpx; }
.ps-title { font-size: calc(22rpx * var(--fs, 1)); color: var(--t3, #8fa3bc); margin-bottom: 10rpx; }
.ps-row { display: flex; flex-wrap: wrap; margin: 0 -8rpx; }
.ps-chip { margin: 0 8rpx 14rpx; padding: 12rpx 22rpx; border-radius: 999rpx;
  background: var(--panel, #18233a); border: 1rpx solid rgba(var(--ln-rgb,148,163,184),.18);
  font-size: calc(24rpx * var(--fs, 1)); color: var(--t1, #dce5f0); line-height: 1.2; }
.ps-chip:active { background: rgba(212,169,78,.16); border-color: rgba(212,169,78,.4); color: var(--chip-tx, #d4a94e); }