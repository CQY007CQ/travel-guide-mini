<view class="page {{td ? 'td' : ''}} fz{{fz}}">
  <view class="tk-head">
    <view class="tk-title">旅行百宝箱</view>
    <view class="tk-sub dim">当前城市：{{cityName}} {{hasPlan ? '· 有行程' : '· 未生成行程'}}</view>
  </view>

  <view class="tk-hint dim" wx:if="{{!hasPlan}}">行程类工具会提示先回「出发」页生成攻略；城市灵感池随时可用。</view>

  <!-- AI 自由问答（云端强模型优先 · 离线兜底 · 结果复用下方「生成结果」区） -->
  <view class="card ai-tk">
    <view class="ai-h"><image lazy-load class="ic" src="/images/icons/sparkle.png"/><text class="ai-t">AI 自由问答</text>
      <text class="ai-badge" wx:if="{{out && out.k === 'ai'}}">AI 生成</text></view>
    <view class="ai-row">
      <input class="ai-inp" placeholder="随便问：这城玩几天合适？带老人怎么排？" value="{{aiQ}}" bindinput="onAIInput" bindconfirm="askAI" confirm-type="send"/>
      <view class="ai-btn {{aiLoading ? 'ai-busy' : ''}}" bindtap="askAI">{{aiLoading ? '思考中…' : '问'}}</view>
    </view>
    <view class="ai-tip dim">回答会带上当前城市与行程上下文；无网络时自动回落本地规则库，结果可复制 / 收藏。</view>
    <view class="ai-copy" bindtap="aiClearChat">清空会话</view>
  </view>

  <view class="group" wx:for="{{groups}}" wx:key="title" wx:for-item="g" wx:for-index="gi">
    <view class="group-title g-tap" data-gi="{{gi}}" bindtap="toggleGroup">
      <text class="g-name">{{g.title}}</text>
      <text class="g-cnt dim">{{g.items.length}}</text>
      <text class="g-chev">{{openMap[gi] ? '▴' : '▾'}}</text>
    </view>
    <view class="card" wx:if="{{openMap[gi]}}">
      <view class="tk-item" wx:for="{{g.items}}" wx:key="k" wx:for-item="it" data-k="{{it.k}}" bindtap="run">
        <view class="m-txt">
          <view class="m-t">{{it.t}}</view>
          <view class="m-d dim">{{it.d}}</view>
        </view>
        <text class="arrow">›</text>
      </view>
    </view>
  </view>

  <view class="group" wx:if="{{out}}">
    <view class="group-title">生成结果</view>
    <view class="card">
      <view class="tk-out" user-select="{{true}}">{{out.txt}}</view>
      <view class="tk-acts">
        <view class="tk-act" bindtap="copyOut">复制结果</view>
        <view class="tk-act" bindtap="favOut">收藏</view>
        <view class="tk-act on" wx:if="{{outAddable}}" bindtap="addToWish">加入想玩</view>
      </view>
    </view>
  </view>

  <!-- v1.19 P2-9：工具结果闭环 —— 收藏后可回看 / 复制 / 删除 -->
  <view class="group" wx:if="{{favs.length}}">
    <view class="group-title fav-h" bindtap="toggleFavList">
      <text>我的收藏（{{favs.length}}）</text>
      <text class="fav-che">{{favOpen ? '收起 ▴' : '展开 ▾'}}</text>
    </view>
    <block wx:if="{{favOpen}}">
      <view class="card fav" wx:for="{{favs}}" wx:key="ts">
        <view class="fav-top" bindtap="expandFav" data-i="{{index}}">
          <view class="fav-meta">
            <text class="fav-t">{{item.toolT}}</text>
            <text class="fav-c dim">{{item.city}}</text>
          </view>
          <text class="fav-x" catchtap="delFav" data-i="{{index}}">✕</text>
        </view>
        <view class="fav-txt" wx:if="{{favIdx === index}}" user-select="{{true}}">{{item.txt}}</view>
        <view class="fav-txt dim" wx:else>{{item.snippet}}…</view>
      </view>
    </block>
  </view>

  <view class="tk-foot dim">共 {{toolTotal}} 个灵感 / 体检 / 文案 / 百科 / 实用工具</view>
</view>
