<view class="page {{td ? 'td' : ''}} fz{{fz}}">

  <!-- v1.8.4 A9：阅读字号调节 -->
  <view class="fz-bar">
    <text class="fz-btn {{fz === 1 ? 'on' : ''}}" bindtap="fzMinus">A⁻ 标准</text>
    <view class="fz-nums"><text class="fz-dot {{fz >= 1 ? 'on' : ''}}"></text><text class="fz-dot {{fz >= 2 ? 'on' : ''}}"></text><text class="fz-dot {{fz >= 3 ? 'on' : ''}}"></text></view>
    <text class="fz-btn {{fz === 3 ? 'on' : ''}}" bindtap="fzPlus">A⁺ 放大</text>
  </view>

  <!-- 一句话定位 -->
  <view class="g-hero card">
    <view class="gh-t">一份能直接照着走的行程，从出发前到旅途结束都能用</view>
    <view class="gh-s">选目的地 → 生成逐日攻略 · 全程离线可用 · 数据只存在你手机里</view>
  </view>

  <!-- 顶部 tab -->
  <view class="g-seg">
    <view class="g-seg-it {{tab === index ? 'on' : ''}}" wx:for="{{tabs}}" wx:key="*this"
          data-t="{{index}}" bindtap="onTab">{{item}}</view>
  </view>

  <!-- ═══════════ ① 一分钟上手 ═══════════ -->
  <block wx:if="{{tab === 0}}">
    <view class="g-card card">
      <view class="g-title"><view class="gt-num">1</view>生成：去「出发」页</view>
      <view class="g-item" data-url="/pages/index/index" bindtap="go">
        <text class="gi-t">选目的地</text>
        <text class="gi-x">单座城市、整省精华、或 2-4 城一条线串着玩</text>
      </view>
      <view class="g-item">
        <text class="gi-t">玩几天 + 出发日期</text>
        <text class="gi-x">默认 4 天；天数上限按目的地真实可玩量自动给出，选超了会自动收敛并提示；「高级设置」里可挑节奏、模式、预算、人数、名山过夜</text>
      </view>
      <view class="g-item">
        <text class="gi-t">没想好去哪？摇个盲盒</text>
        <text class="gi-x">「出发」页点「换个目的地」一次给 3 个随机目的地，摇到满意就生成（A8 目的地盲盒）</text>
      </view>
      <view class="g-item">
        <text class="gi-t">点生成</text>
        <text class="gi-x">一份按天排好的行程就出来了，自动跳转「行程」页；还能一键加入手机日历</text>
      </view>
    </view>

    <view class="g-card card">
      <view class="g-title"><view class="gt-num">2</view>出发前：看「今天」页</view>
      <view class="g-item" data-url="/pages/today/today" bindtap="go">
        <text class="gi-t">它自动告诉你要干嘛</text>
        <text class="gi-x">按离出发的天数给出待办：订车票酒店 → 抢预约门票 → 收拾行李</text>
      </view>
      <view class="g-item" data-url="/pages/today/today" bindtap="go">
        <text class="gi-t">自动行李清单</text>
        <text class="gi-x">按天数、季节、山海古镇特色生成，点一下打勾</text>
      </view>
      <view class="g-item" data-url="/pages/plan/plan" bindtap="go">
        <text class="gi-t">排太满了？</text>
        <text class="gi-x">行程页跑一遍「行程体检」，太满的点「一键减负」自动精简</text>
      </view>
      <view class="g-item" data-url="/subpkg/prep/prep" bindtap="go">
        <text class="gi-t">要预约的景点</text>
        <text class="gi-x">去「出行准备」把票订了、勾「已订」，别到门口才约不上</text>
      </view>
    </view>

    <view class="g-card card">
      <view class="g-title"><view class="gt-num">3</view>旅途中：跟着「今天」走</view>
      <view class="g-item">
        <text class="gi-t">现在该玩什么</text>
        <text class="gi-x">「今天」页实时显示进行中的安排与下一步，还能顺手记账、写手记</text>
      </view>
      <view class="g-item" data-url="/pages/plan/plan" bindtap="go">
        <text class="gi-t">要去某个点 / 导航</text>
        <text class="gi-x">在「行程」页点条目行尾的罗盘，或在「地图」页点当天点位/标记，直接唤起微信导航</text>
      </view>
      <view class="g-item">
        <text class="gi-t">随手记账</text>
        <text class="gi-x">一句话输入「打车 32」「门票 80」，自动归类；多人同行还能 AA 结算</text>
      </view>
      <view class="g-item">
        <text class="gi-t">行程临时想改</text>
        <text class="gi-x">行程页点任意一天：换一个景点 / 删掉 / 上移下移 / 加个景点</text>
      </view>
    </view>

    <view class="g-card card">
      <view class="g-title"><view class="gt-num">4</view>回来后：去「更多」页</view>
      <view class="g-item">
        <text class="gi-t">旅行小结</text>
        <text class="gi-x">天数 / 景点 / 打卡 / 总花费一目了然；账本对比预算看超没超</text>
      </view>
      <view class="g-item">
        <text class="gi-t">足迹与成就</text>
        <text class="gi-x">玩过的景点点过打卡，就点亮城市足迹、解锁徽章</text>
      </view>
    </view>

    <view class="g-tip dim">底部四个频道建议按「出发 → 今天 → 行程 → 更多」的顺序逛一遍，功能都在里面。</view>
  </block>

  <!-- ═══════════ ② 功能地图 ═══════════ -->
  <block wx:if="{{tab === 1}}">
    <!-- 四个频道 -->
    <view class="g-card card">
      <view class="g-title small">四个底部频道</view>
      <view class="g-item" data-url="/pages/index/index" bindtap="go">
        <text class="gi-t">出发</text>
        <text class="gi-x">生成攻略的总入口。三种玩法：单城深度 / 全省精华 / 多站串联；支持收藏回填、最近再查</text>
      </view>
      <view class="g-item" data-url="/pages/today/today" bindtap="go">
        <text class="gi-t">今天</text>
        <text class="gi-x">行程的「指挥台」：出发前给待办，途中告诉你现在玩什么，结束后给成绩单</text>
      </view>
      <view class="g-item" data-url="/pages/plan/plan" bindtap="go">
        <text class="gi-t">行程</text>
        <text class="gi-x">逐日攻略正文：时间线、景点介绍、导航、想玩标记、打卡、手动调序都在这里</text>
      </view>
      <view class="g-item" data-url="/pages/more/more" bindtap="go">
        <text class="gi-t">更多</text>
        <text class="gi-x">全部工具与个人中心：地图导引、美食名店、本地速查、旅行百宝箱、出行准备、账本、存档足迹小结、外观与备份</text>
      </view>
    </view>

    <!-- 更多页里的功能 -->
    <view class="g-card card">
      <view class="g-title small">工具（在「更多」页，也可在首页快捷入口直达）</view>
      <view class="g-item" data-url="/subpkg/map/map" bindtap="go">
        <text class="gi-t">地图导引</text>
        <text class="gi-x">按天标点 + 行进连线，景点 / 美食 / 住宿三图层，点标记一键开导航</text>
      </view>
      <view class="g-item" data-url="/subpkg/food/food" bindtap="go">
        <text class="gi-t">美食名店</text>
        <text class="gi-x">必吃清单 + 当地名店，按你的预算档把合价位的店排在前面，可直接导航</text>
      </view>
      <view class="g-item" data-url="/subpkg/assistant/assistant" bindtap="go">
        <text class="gi-t">本地速查</text>
        <text class="gi-x">天气穿衣 / 必吃美食 / 门票预约 / 住宿建议 / 预算 / 交通 / 避坑 / 今天安排，8 个一键查卡片，也能自由输入关键词，结果可收藏，全程不耗流量</text>
      </view>
      <view class="g-item" data-url="/subpkg/prep/prep" bindtap="go">
        <text class="gi-t">出行准备</text>
        <text class="gi-x">票价与预约跟踪、证件清单、酒店比价建议、团队分工、应急电话</text>
      </view>
      <view class="g-item" data-url="/subpkg/ledger/ledger" bindtap="go">
        <text class="gi-t">记账 · AA</text>
        <text class="gi-x">一句话记账、每日额度、预算对照、AA 结算、月度汇总、汇率换算、凭证拍照</text>
      </view>
    </view>

    <view class="g-card card">
      <view class="g-title small">个人数据（「更多」页下半部分）</view>
      <view class="g-item">
        <text class="gi-t">行程存档</text>
        <text class="gi-x">换计划不丢行程，自动存档最多 10 份，随时一键恢复</text>
      </view>
      <view class="g-item">
        <text class="gi-t">想玩清单 / 旅行足迹 / 旅行手记 / 旅行小结 / 旅行成就</text>
        <text class="gi-x">想去的勾上优先排；玩过点打卡点亮足迹；每天一句手记；结束后看小结与徽章</text>
      </view>
      <view class="g-item">
        <text class="gi-t">去哪儿好呢 / 足迹热力图 / 深色模式</text>
        <text class="gi-x">灵感随机推荐目的地；看点亮过哪些省；夜间自动深色护眼</text>
      </view>
      <view class="g-item">
        <text class="gi-t">备份 / 恢复</text>
        <text class="gi-x">一键复制全量备份到剪贴板，换机后粘贴即还原，数据全程不出手机</text>
      </view>
    </view>
  </block>

  <!-- ═══════════ ③ 进阶技巧 ═══════════ -->
  <block wx:if="{{tab === 2}}">
    <view class="g-card card">
      <view class="g-title small">把行程排得更合心意</view>
      <view class="g-item">
        <text class="gi-t">想去的先勾上</text>
        <text class="gi-x">「出发」页展开想玩景点池勾选（或行程页点星），生成时会优先安排；勾得足够多可开「只玩勾选的」</text>
      </view>
      <view class="g-item">
        <text class="gi-t">没排上的想玩怎么办</text>
        <text class="gi-x">行程页顶部「想玩优先重排 / 只玩想玩」一键重排；单天也能「＋加个景点」或长按自己写一个</text>
      </view>
      <view class="g-item">
        <text class="gi-t">临时微调</text>
        <text class="gi-x">点开任意条目可「换一个 / 删掉 / 百科 / 打卡 / 调序」；换与删会自动重写整天的行文顺序</text>
      </view>
      <view class="g-item">
        <text class="gi-t">排太满？</text>
        <text class="gi-x">行程体检会提醒，点「一键减负」自动把每天砍到 5 个点内</text>
      </view>
    </view>

    <view class="g-card card">
      <view class="g-title small">预算与记账</view>
      <view class="g-item">
        <text class="gi-t">预算档怎么选</text>
        <text class="gi-x">经济 / 舒适 / 高端影响住宿档位与美食排序；选「自定义总预算」输入全程总金额，自动分摊到每人每天</text>
      </view>
      <view class="g-item">
        <text class="gi-t">机票 / 火车票的钱怎么算</text>
        <text class="gi-x">预算参考只按当地「吃住玩」算，新行程起始已花为 0、不含往返路费。你实际买的机票 / 火车票、打车费等，出发后在「记账」随手记一笔（自动归「交通」）即计入已花，预算条实时对照</text>
      </view>
      <view class="g-item">
        <text class="gi-t">多人 AA</text>
        <text class="gi-x">记每笔时填付款人与 AA 人数，「更多 → 记账」里一键算出谁该转给谁</text>
      </view>
      <view class="g-item">
        <text class="gi-t">花钱有数</text>
        <text class="gi-x">每日额度看当天超没超、花费预测看照此节奏全程要花多少，超支前就收一收</text>
      </view>
    </view>

    <view class="g-card card">
      <view class="g-title small">旅行中的小帮手</view>
      <view class="g-item">
        <text class="gi-t">把行程带进系统日历</text>
        <text class="gi-x">行程页点「一键加入日历」直接写入手机系统日历，并提前 1 小时提醒（旧版微信不支持时会自动退回复制日历文件的方式）</text>
      </view>
      <view class="g-item">
        <text class="gi-t">打卡点亮足迹</text>
        <text class="gi-x">玩一个点一个，积累城市足迹与成就徽章，也方便回来写小结</text>
      </view>
      <view class="g-item">
        <text class="gi-t">临时没网也能用</text>
        <text class="gi-x">行程、账本、速查、清单全部离线可用；只有「天气卡」与跳转百科需要联网</text>
      </view>
    </view>

    <view class="g-card card">
      <view class="g-title small">玩得更广</view>
      <view class="g-item">
        <text class="gi-t">多站串联 / 全省精华</text>
        <text class="gi-x">想一条线走多城：切「多站串联」加城市，每站各配天数；想逛一整省点「全省精华」</text>
      </view>
      <view class="g-item">
        <text class="gi-t">收藏的城市</text>
        <text class="gi-x">「更多 → 去哪儿好呢」里有「串起收藏 N 城」，收藏过的目的地一键变一条行程</text>
      </view>
      <view class="g-item">
        <text class="gi-t">换方案 / 换一档节奏</text>
        <text class="gi-x">行程页「换方案」在轻松休闲 / 平衡舒适 / 特种兵打卡三档间循环，同一天数重新排布</text>
      </view>
    </view>

    <view class="g-card card">
      <view class="g-title small">实用玩法 · 一看就会</view>
      <view class="g-item">
        <text class="gi-t">挑日子出行：人流早知道</text>
        <text class="gi-x">行程页顶部按出发日期提示「五一/国庆/暑假/周末」人流档，错峰更舒服</text>
      </view>
      <view class="g-item">
        <text class="gi-t">穿什么：按月与按天</text>
        <text class="gi-x">「今天」页按出行月份给出穿衣清单；当天气温拉取成功时按实时温度细化到外套/防晒</text>
      </view>
      <view class="g-item">
        <text class="gi-t">按饭点找吃的</text>
        <text class="gi-x">「美食名店」页可切「早餐 / 正餐 / 夜宵」，想吃哪顿看哪档</text>
      </view>
      <view class="g-item">
        <text class="gi-t">账本各算各的</text>
        <text class="gi-x">多份行程的账互不混（按「城市·天数」隔离），外币开销自动折算人民币，还能单独记「谁借谁还」</text>
      </view>
      <view class="g-item">
        <text class="gi-t">花钱有凭证</text>
        <text class="gi-x">「记账」每笔可拍小票留底，账单明细里点凭证即看</text>
      </view>
      <view class="g-item">
        <text class="gi-t">动线顺不顺、哪天太赶</text>
        <text class="gi-x">「地图」页显示当天动线评分与总里程；行程页每天有参考时长卡，超 12 小时提醒减负</text>
      </view>
      <view class="g-item">
        <text class="gi-t">回顾与沉淀</text>
        <text class="gi-x">「更多」页有旅行年鉴（全量聚合）与足迹热力图（34 省宫格）；给城市打分存小贴士，回访时回显；首页顶部显示待预约提醒</text>
      </view>
      <view class="g-item">
        <text class="gi-t">同行人协作</text>
        <text class="gi-x">「更多 → 行程协作」把整份行程+想玩复制给对方，TA 粘贴后想玩并入、行程存入「我的行程」</text>
      </view>
    </view>
    <view class="g-card card">
      <view class="g-title small">实用玩法 · 细节贴心</view>
      <view class="g-item">
        <text class="gi-t">行程体检更懂你</text>
        <text class="gi-x">预算档和这座城市消费对不对得上、天数是不是排太长（顺路能加哪几城）、全程门票大概多少——行程页「体检」一并告诉你</text>
      </view>
      <view class="g-item">
        <text class="gi-t">长行程别翻到底</text>
        <text class="gi-x">行程页顶部新增天数条，随页面吸顶；点「D3」直接跳到第 3 天，当天标红点「今」</text>
      </view>
      <view class="g-item">
        <text class="gi-t">账本更顺手</text>
        <text class="gi-x">本周花销独立一格；分类记住上次用的；删错了 6 秒内可撤销；「导出」里可一键复制本周账单对账</text>
      </view>
      <view class="g-item">
        <text class="gi-t">想玩清单会标状态</text>
        <text class="gi-x">「更多」页想玩条目上：已排进当前行程 → 蓝「已排」，打过分 → 灰「去过」</text>
      </view>
      <view class="g-item">
        <text class="gi-t">足迹会说话</text>
        <text class="gi-x">「更多 → 旅行足迹」可一键复制足迹清单发朋友圈；点城市 chips 看在这座城打过卡的地方</text>
      </view>
      <view class="g-item">
        <text class="gi-t">行程结束好好道别</text>
        <text class="gi-x">「今天」页在行程结束后引导你回「我的」：看旅行年鉴、给这座城留一条经验</text>
      </view>
      <view class="g-item">
        <text class="gi-t">关于与备份</text>
        <text class="gi-x">「更多」页底部点版本号可看「关于」（说明数据不上传）；本地数据攒多了，备份入口会提醒你导出一份</text>
      </view>
     </view>
    <view class="g-card card">
      <view class="g-title small">这一轮重点 · 票价 / 预约 / 景点介绍</view>
      <view class="g-item">
        <text class="gi-t">参考票价，收费免费一眼清</text>
        <text class="gi-x">「出行准备」里按景点列出参考票价，收费与免费一目了然；收费门票会自动算进全程总预算，不用自己再加</text>
      </view>
      <view class="g-item">
        <text class="gi-t">要预约的，提前帮你盯着</text>
        <text class="gi-x">标「需预约」的景点给出官方渠道（如官方小程序名）和提前量提示；有官方链接的可点「复制预约链接」到浏览器直接打开。「今天」页与行程体检会提醒哪些还没订，去「出行准备」定预约日、勾「已订」就行</text>
      </view>
      <view class="g-item">
        <text class="gi-t">预约时间表，按提前量排好</text>
        <text class="gi-x">「更多 → 旅行百宝箱 → 预约时间表」把要约的景点按「该提前几天」排好序，告诉你哪天约哪家最稳，热门景区现场常无余票</text>
      </view>
      <view class="g-item">
        <text class="gi-t">景点介绍随行可读</text>
        <text class="gi-x">热门景点在行程页点开就有实用介绍与游玩动线，离线也能看；想深挖背景点「百科」在线查（需联网）</text>
      </view>
    </view>
    <view class="g-card card">
