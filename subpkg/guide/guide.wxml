<view class="page {{td ? 'td' : ''}} fz{{fz}}">
  <ai-entry topic="guide" />

  <!-- 阅读字号调节（强光下走路看、老人使用都需要） -->
  <view class="fz-bar">
    <text class="fz-btn {{fz === 1 ? 'on' : ''}}" bindtap="fzMinus">A⁻ 标准</text>
    <view class="fz-nums"><text class="fz-dot {{fz >= 1 ? 'on' : ''}}"></text><text class="fz-dot {{fz >= 2 ? 'on' : ''}}"></text><text class="fz-dot {{fz >= 3 ? 'on' : ''}}"></text></view>
    <text class="fz-btn {{fz === 3 ? 'on' : ''}}" bindtap="fzPlus">A⁺ 放大</text>
  </view>

  <view class="g-hero card">
    <view class="gh-t">选目的地 → 生成 → 出发照着走</view>
    <view class="gh-s">全程有 AI 助手随行问答 · 拍照识物即拍即科普</view>
  </view>

  <!-- AI 能力快捷入口：本页主推，两个大按钮直达，不用展开就能点 -->
  <view class="g-ai-quick">
    <view class="g-ai-btn" data-url="/subpkg/assistant/assistant" catchtap="go">
      <text class="g-ai-ic">✦</text>
      <view class="g-ai-tx"><text class="g-ai-t">AI 助手</text><text class="g-ai-d">随行问答 · 一句话生成</text></view>
      <text class="g-ai-ar">›</text>
    </view>
    <view class="g-ai-btn" data-url="/subpkg/lens/lens" catchtap="go">
      <text class="g-ai-ic">★</text>
      <view class="g-ai-tx"><text class="g-ai-t">拍照识物</text><text class="g-ai-d">拍植物地标 · 云端识别科普</text></view>
      <text class="g-ai-ar">›</text>
    </view>
  </view>

  <!-- 分组速查条：默认全收起，一次只展开一条 -->
  <block wx:for="{{groups}}" wx:key="g" wx:for-item="grp" wx:for-index="gi">
    <view class="g-group-t">{{grp.g}}</view>
    <view class="g-list card">
      <view class="g-row {{open === it.k ? 'on' : ''}}" wx:for="{{grp.items}}" wx:key="k" wx:for-item="it"
            data-k="{{it.k}}" bindtap="onTopic">
        <view class="g-row-h">
          <text class="g-row-t">{{it.t}}</text>
          <text class="g-row-ar">{{open === it.k ? '−' : '+'}}</text>
        </view>
        <view class="g-row-d" wx:if="{{open === it.k}}">
          <text class="g-row-x">{{it.d}}</text>
          <text class="g-row-go" wx:if="{{it.url}}" data-url="{{it.url}}" catchtap="go">去看看 ›</text>
        </view>
      </view>
    </view>
  </block>

  <!-- 离线数据规模：v1.20.6 从「旅途应急」页迁入，作为「了解本 App」的透明说明 -->
  <view class="g-group-t">关于数据</view>
  <view class="card g-corpus" wx:if="{{corpus}}">
    <view class="g-corpus-h">离线数据规模</view>
    <view class="cp-head">{{corpus.headline}}</view>
    <view class="cp-grid">
      <view class="cp-n"><text class="cp-v">{{corpus.cities}}</text><text class="cp-l">真实城市</text></view>
      <view class="cp-n"><text class="cp-v">{{corpus.cityEntries}}</text><text class="cp-l">城市池条目</text></view>
      <view class="cp-n"><text class="cp-v">{{corpus.spots}}</text><text class="cp-l">景点</text></view>
      <view class="cp-n"><text class="cp-v">{{corpus.foods}}</text><text class="cp-l">有美食店城</text></view>
      <view class="cp-n"><text class="cp-v gold">{{corpus.hospitals}}</text><text class="cp-l">具名医院</text></view>
      <view class="cp-n"><text class="cp-v">{{corpus.approxCities}}</text><text class="cp-l">搜索降级城</text></view>
      <view class="cp-n"><text class="cp-v">{{corpus.provinces}}</text><text class="cp-l">省级区</text></view>
    </view>
    <view class="cp-tip dim">城市池 {{corpus.cityEntries}} 条 = {{corpus.cities}} 座不同城市 + {{corpus.aliasEntries}} 条全称别名（如「阿坝 / 阿坝藏族羌族自治州」指向同一地）。其中 {{corpus.foods}} 城有真实美食店、{{corpus.spotCities}} 城有景点坐标；未收录具体店铺或坐标的城市走城心降级，不编造店名与坐标。</view>
    <view class="cp-sec" wx:if="{{corpus.climate.length}}">
      <view class="cp-h">气候带分布</view>
      <view class="cp-row" wx:for="{{corpus.climate}}" wx:key="k">
        <view class="cp-lab">{{item.label}}<text class="cp-amt"> {{item.n}}</text></view>
        <view class="cp-bar"><view class="cp-fill" style="width:{{item.pct}}%"></view></view>
      </view>
    </view>
    <view class="cp-chips" wx:if="{{corpus.region.length}}">
      <text class="cp-chip" wx:for="{{corpus.region}}" wx:key="k">{{item.label}} {{item.n}}</text>
    </view>
    <view class="cp-tip dim">全部为随包下发的离线结构化数据，无需联网即可规划</view>
  </view>

  <view class="g-foot">v{{ver}} · {{total}} 条 · 点标题展开 · 随时可从「更多」页打开本页</view>

</view>
