/* 全站统一 AI 悬浮入口：固定右下，金色主题，层级高于内容但不挡关键操作 */
.ai-fab {
  position: fixed; right: 22rpx; bottom: 40rpx; z-index: 60;
  display: flex; align-items: center; justify-content: center;
  padding: 16rpx 26rpx; border-radius: 999rpx;
  background: linear-gradient(135deg, #e2b65c, #d4a94e 45%, #b8892f);
  color: #14100a; font-size: calc(26rpx * var(--fs, 1)); font-weight: 800;
  box-shadow: 0 8rpx 24rpx rgba(212, 169, 78, .35);
  border: 1rpx solid rgba(255, 255, 255, .25);
}
.ai-fab:active { opacity: .85; }
.ai-fab-t { line-height: 1; white-space: nowrap; }

/* v1.20.7：inline 形态 —— 内嵌胶囊/横条，金色描边，与首页 .head-guide 同语言，不悬浮不压 tabBar */
.ai-inline {
  display: flex; align-items: center; gap: 8rpx;
  padding: 14rpx 24rpx; border-radius: 999rpx;
  background: linear-gradient(135deg, rgba(226,182,92,.16), rgba(212,169,78,.10));
  border: 1rpx solid rgba(212,169,78,.45);
  color: var(--gold-tx, #8f6a1f);
  font-size: calc(24rpx * var(--fs, 1)); font-weight: 800;
  box-shadow: 0 4rpx 14rpx rgba(212,169,78,.18);
}
.ai-inline:active { background: rgba(212,169,78,.26); }
.ai-inline-ic { font-size: calc(28rpx * var(--fs, 1)); line-height: 1; }
.ai-inline-t { white-space: nowrap; }
.ai-inline-ar { margin-left: 2rpx; opacity: .7; font-weight: 900; }
