<view class="page {{td ? 'td' : ''}} fz{{fz}}">

  <view class="head">
    <view class="h-title">按标签找景点</view>
    <view class="h-sub">用更多词条标注了每个景点，说说你想怎么玩，精确锁定目的地</view>
  </view>

  <!-- 搜索框 -->
  <view class="card search-bar">
    <image class="s-ic" src="/images/icons/search.png"/>
    <input class="s-inp" value="{{qText}}" placeholder="输入关键词，如：雪山 / 古镇 / 免费 / 带娃" confirm-type="search" bindinput="onInput" bindconfirm="onSearch"/>
    <view class="s-go" bindtap="onSearch">搜索</view>
  </view>

  <!-- 示例 -->
  <scroll-view scroll-x class="ex-scroll" show-scrollbar="{{false}}">
    <view class="ex-chip" wx:for="{{examples}}" wx:key="t" data-q="{{item.q}}" bindtap="onExample">{{item.t}}</view>
  </scroll-view>

  <!-- 范围 -->
  <view class="scope-row">
    <view class="scope-chip {{scope === item.k ? 'on' : ''}}" wx:for="{{scopeOptions}}" wx:key="k"
          data-k="{{item.k}}" data-type="{{item.type}}" bindtap="onScope">{{item.t}}</view>
    <view class="scope-clear" wx:if="{{showClear}}" bindtap="onClear">清空</view>
  </view>

  <!-- 已选标签 -->
  <view class="card" wx:if="{{activeTags.length}}">
    <view class="dim-h">已选标签 · {{activeTags.length}}</view>
    <view class="tag-wrap">
      <text class="tag-on" wx:for="{{activeTags}}" wx:key="*this">{{item}}</text>
    </view>
  </view>

  <!-- 维度标签组 -->
  <view class="card" wx:for="{{dimGroups}}" wx:for-item="g" wx:key="dim">
    <view class="dim-h">{{g.label}}</view>
    <view class="tag-wrap">
      <view class="tag {{c.on ? 'on' : ''}}" wx:for="{{g.chips}}" wx:for-item="c" wx:key="key"
            data-key="{{c.key}}" bindtap="onTagTap">{{c.label}}</view>
    </view>
  </view>

  <!-- 结果与空态 -->
  <view class="card" wx:if="{{results.length}}">
    <view class="rs-stat">{{stat}}</view>
    <view class="rs-card" wx:for="{{results}}" wx:for-item="rs" wx:key="name">
      <view class="rs-top">
        <text class="rs-name">{{rs.name}}</text>
        <text class="rs-geo">{{rs.city}} · {{rs.province}}</text>
      </view>
      <view class="rs-tags" wx:if="{{rs.reasons.length}}">
        <text class="rs-tag" wx:for="{{rs.reasons}}" wx:for-item="rsn" wx:key="*this">{{rsn}}</text>
      </view>
      <view class="rs-note" wx:if="{{rs.note}}">{{rs.note}}</view>
      <view class="rs-ops">
        <view class="rs-btn {{rs.hasCoord ? '' : 'rs-dis'}}" data-lat="{{rs.lat}}" data-lon="{{rs.lon}}" data-name="{{rs.name}}" data-city="{{rs.city}}" bindtap="onLocate">看位置</view>
        <view class="rs-btn rs-ghost" data-name="{{rs.name}}" bindtap="onCopy">复制名称</view>
      </view>
    </view>
  </view>

  <view class="card empty" wx:if="{{!results.length && mode === 'empty'}}">
    <view class="em-t">{{hint}}</view>
  </view>
  <view class="card empty" wx:if="{{!results.length && mode !== 'empty'}}">
    <view class="em-t">{{hint}}</view>
  </view>

  <view class="ver dim">旅行攻略生成器</view>
</view>
