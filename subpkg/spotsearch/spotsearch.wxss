/* 按标签找景点 —— 复用全局主题变量（浅/深双主题） */
.page { padding: 20rpx 22rpx 60rpx; box-sizing: border-box; min-height: 100%; }

.head { padding: 12rpx 8rpx 18rpx; }
.h-title { font-size: calc(40rpx * var(--fs, 1)); font-weight: 700; color: var(--t1); letter-spacing: 1rpx; }
.h-sub { margin-top: 8rpx; font-size: calc(24rpx * var(--fs, 1)); color: var(--dim); line-height: 1.5; }

.card {
  background: var(--card);
  border-radius: 20rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: var(--card-shadow);
}

/* 搜索框 */
.search-bar { display: flex; align-items: center; padding: 14rpx 18rpx; }
.s-ic { width: 34rpx; height: 34rpx; margin-right: 14rpx; opacity: .7; }
.s-inp { flex: 1; font-size: calc(28rpx * var(--fs, 1)); color: var(--t1); }
.s-go {
  margin-left: 14rpx; padding: 10rpx 26rpx; border-radius: 999rpx;
  background: var(--gold); color: var(--on-gold);
  font-size: calc(26rpx * var(--fs, 1)); font-weight: 600;
}

/* 示例 */
.ex-scroll { white-space: nowrap; margin-bottom: 18rpx; }
.ex-chip {
  display: inline-block; padding: 10rpx 22rpx; margin-right: 14rpx;
  background: var(--well); color: var(--acc); border-radius: 999rpx;
  font-size: calc(24rpx * var(--fs, 1)); border: 1rpx solid rgba(var(--ln-rgb), .12);
}

/* 范围 */
.scope-row { display: flex; align-items: center; flex-wrap: wrap; margin-bottom: 18rpx; }
.scope-chip {
  padding: 10rpx 22rpx; margin: 0 12rpx 12rpx 0;
  background: var(--well); color: var(--t2); border-radius: 999rpx;
  font-size: calc(24rpx * var(--fs, 1));
}
.scope-chip.on { background: var(--gold); color: var(--on-gold); font-weight: 600; }
.scope-clear { padding: 10rpx 22rpx; color: var(--red); font-size: calc(24rpx * var(--fs, 1)); }

/* 维度标签 */
.dim-h { font-size: calc(26rpx * var(--fs, 1)); color: var(--t2); font-weight: 600; margin-bottom: 16rpx; }
.tag-wrap { display: flex; flex-wrap: wrap; }
.tag {
  padding: 12rpx 22rpx; margin: 0 14rpx 14rpx 0;
  background: var(--well); color: var(--t2); border-radius: 12rpx;
  font-size: calc(25rpx * var(--fs, 1)); border: 1rpx solid rgba(var(--ln-rgb), .10);
}
.tag.on { background: var(--gold); color: var(--on-gold); font-weight: 600; border-color: transparent; }
.tag-on {
  padding: 12rpx 22rpx; margin: 0 14rpx 14rpx 0;
  background: rgba(var(--ln-rgb), .10); color: var(--acc); border-radius: 12rpx;
  font-size: calc(25rpx * var(--fs, 1));
}

/* 结果 */
.rs-stat { font-size: calc(25rpx * var(--fs, 1)); color: var(--gold-tx); font-weight: 600; margin-bottom: 14rpx; }
.rs-card {
  padding: 18rpx; border-radius: 16rpx; margin-bottom: 16rpx;
  background: var(--well); border: 1rpx solid rgba(var(--ln-rgb), .08);
}
.rs-top { display: flex; align-items: baseline; justify-content: space-between; }
.rs-name { font-size: calc(30rpx * var(--fs, 1)); font-weight: 700; color: var(--t1); }
.rs-geo { font-size: calc(22rpx * var(--fs, 1)); color: var(--dim); }
.rs-tags { display: flex; flex-wrap: wrap; margin-top: 10rpx; }
.rs-tag {
  padding: 4rpx 14rpx; margin: 0 10rpx 8rpx 0; border-radius: 999rpx;
  background: rgba(var(--ln-rgb), .10); color: var(--acc);
  font-size: calc(21rpx * var(--fs, 1));
}
.rs-note { margin-top: 8rpx; font-size: calc(23rpx * var(--fs, 1)); color: var(--t3); line-height: 1.5; }
.rs-ops { display: flex; margin-top: 14rpx; }
.rs-btn {
  padding: 10rpx 24rpx; margin-right: 14rpx; border-radius: 999rpx;
  background: var(--gold); color: var(--on-gold); font-size: calc(24rpx * var(--fs, 1)); font-weight: 600;
}
.rs-btn.rs-ghost { background: transparent; color: var(--t2); border: 1rpx solid rgba(var(--ln-rgb), .18); }
.rs-btn.rs-dis { opacity: .45; }

.empty { text-align: center; padding: 48rpx 24rpx; }
.em-t { font-size: calc(25rpx * var(--fs, 1)); color: var(--dim); line-height: 1.6; }

.ver { text-align: center; color: var(--dim); font-size: calc(22rpx * var(--fs, 1)); margin-top: 20rpx; }
