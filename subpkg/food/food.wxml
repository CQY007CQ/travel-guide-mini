<view class="page {{td ? 'td' : ''}} fz{{fz}}">
  <view wx:if="{{!hasPlan}}" class="empty">
    <view class="em-ic"><image lazy-load class="em-img" src="/images/icons/food.png"/></view>
    <view class="em-t">先去生成攻略</view>
    <view class="em-s">这里会显示目的地的必吃清单与地道名店</view>
  </view>

  <block wx:if="{{hasPlan}}">
    <!-- 多站行程：城市切换条（默认定位今天所在站） -->
    <scroll-view wx:if="{{segs.length > 1}}" scroll-x class="segs-scroll" show-scrollbar="{{false}}">
      <view class="segs">
        <view class="seg-chip {{fIdx === item.i ? 'on' : ''}}" wx:for="{{segs}}" wx:key="i"
              data-i="{{item.i}}" bindtap="onCityTap">
          {{item.i + 1}}. {{item.name}}
        </view>
      </view>
    </scroll-view>

    <!-- v1.8.4 A3：早餐 / 正餐 / 夜宵 时段切换 -->
    <view class="card slot-bar">
      <view class="slot-chip {{slotFilter === item.k ? 'on' : ''}}" wx:for="{{slots}}" wx:key="k"
            data-k="{{item.k}}" bindtap="onSlot">{{item.t}}</view>
    </view>

    <view class="card">
      <view class="h3">必吃清单 · {{cityName}}<text class="dim u-fs20" wx:if="{{slotFilter !== 'all'}}">（{{foodN}} 项）</text></view>
      <view class="food-tags">
        <block wx:for="{{foods}}" wx:key="n">
          <text class="tag {{item.on ? 'on' : ''}}" data-n="{{item.n}}" bindtap="onDish">{{item.n}}<text wx:if="{{item.tag}}" class="tag-sub">{{item.tag}}</text></text>
        </block>
      </view>
      <view wx:if="{{slotFilter !== 'all' && !foodN}}" class="note dim">这个时段没有明确代表，看看「全部」里的其它推荐</view>
      <view wx:if="{{note}}" class="note">{{note}}</view>
      <view class="dish-hint">点菜名，看看有哪些店做这道菜</view>
    </view>

    <view class="card">
      <view class="h3 h3-row"><image lazy-load class="ic" src="/images/icons/trophy.png"/>地道名店推荐 <text class="dim u-fs20">（{{shopHead}}）</text></view>
      <view wx:if="{{budgetTxt}}" class="budget-tip"><image lazy-load class="ic ic-sm" src="/images/icons/wallet.png"/>{{budgetTxt}}</view>
      <view wx:if="{{shopSrc}}" class="budget-tip"><image lazy-load class="ic ic-sm" src="/images/icons/target.png"/>{{shopSrc}}</view>
      <view wx:if="{{dishNote}}" class="budget-tip"><image lazy-load class="ic ic-sm" src="/images/icons/search.png"/>{{dishNote}}</view>
      <view wx:if="{{!shops.length}}" class="dim note">{{emptyShopTx}}</view>
      <view class="shop {{item.hit ? 'hit' : ''}}" wx:for="{{shops}}" wx:key="id"
            data-lat="{{item.lat}}" data-lon="{{item.lon}}" data-shop="{{item.shop}}" data-addr="{{item.addr}}"
            bindtap="onShopNav">
        <view class="shop-top">
          <text class="shop-name">{{item.shop}}</text>
          <text wx:if="{{item.band}}" class="band-tag band-{{item.bandKey}}">{{item.band}}</text>
          <text wx:if="{{item.rep}}" class="rep-tag rep-{{item.repKey}}">{{item.rep}}</text>
          <text class="shop-price">{{item.price}}</text>
        </view>
        <view class="shop-sub">{{item.sub}}</view>
        <view wx:if="{{item.menu.length}}" class="menu">
          <text class="menu-h">招牌菜</text>
          <view class="menu-row" wx:for="{{item.menu}}" wx:for-item="m" wx:key="n">
            <text class="menu-n">{{m.n}}</text><text class="menu-p">{{m.p}}</text>
          </view>
          <text class="menu-foot dim">到店以实价为准</text>
        </view>
        <view wx:else class="menu-empty dim">菜单整理中…</view>
        <view wx:if="{{item.note}}" class="shop-note"><text class="note-tag">编辑点评</text>{{item.note}}</view>
      </view>
    </view>

    <!-- AI 吃什么（云端强模型优先 · 离线兜底） -->
    <view class="card ai-food">
      <view class="ai-h">
        <image lazy-load class="ic" src="/images/icons/sparkle.png"/>
        <text class="ai-t">AI 吃什么</text>
        <text class="ai-badge" wx:if="{{aiSource}}">AI 生成</text>
        <view class="ai-btn {{aiLoading ? 'ai-busy' : ''}}" bindtap="askFoodAI">{{aiLoading ? '思考中…' : (aiText ? '再问一次' : '生成')}}</view>
      </view>
      <view class="ai-body" wx:if="{{aiText}}">{{aiText}}</view>
      <view class="ai-copy" wx:if="{{aiText}}" bindtap="aiCopy">复制回答</view>
      <view class="ai-copy" bindtap="aiClearChat">清空会话</view>
      <view class="ai-tip" wx:else>基于本地收录的真实必吃清单与名店给 3 条点餐建议；不编造店名和价格，无网络时自动回落离线规则库。</view>
      <view class="ai-err" wx:if="{{aiErr}}">{{aiErr}}</view>
    </view>
  </block>
</view>
