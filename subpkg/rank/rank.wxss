/* rank 页面样式
 * 刻意复用 app.wxss 的设计令牌（--card / --gold / --t2 / --ln …）与既有类
 * （.card / .h3 / .dim / .tag / .btn-primary / .empty），
 * 只新增排行榜专有的类，避免同一个视觉概念出现两套写法。 */

.rk-tabs {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  margin: 10px 0 8px;
}
.rk-tab {
  padding: 7px 12px;
  border-radius: 999px;
  border: 1px solid var(--ln, rgba(148, 163, 184, .18));
  background: var(--well, #fff);
  color: var(--t2, #5b6b82);
  font-size: 13px;
  line-height: 1.2;
}
.rk-tab.on {
  background: var(--gold, #d4a94e);
  border-color: var(--gold, #d4a94e);
  color: var(--on-gold, #fff);
  font-weight: 600;
}
.rk-desc { margin-top: 4px; font-size: 12px; line-height: 1.6; }

/* 我在哪 */
.rk-mecard { text-align: center; }
.rk-mehead {
  display: flex; align-items: center; justify-content: center;
  gap: 8px; margin-bottom: 6px;
}
.rk-menm { font-size: 15px; color: var(--t2, #5b6b82); }
.rk-rename {
  width: 92px; font-size: 12px; text-align: center;
  border-bottom: 1px dashed var(--ln, rgba(148, 163, 184, .28));
  color: var(--t1, #18233a);
}
.rk-mebig { display: flex; align-items: baseline; justify-content: center; gap: 8px; }
.rk-myval {
  font-size: 42px; font-weight: 700; line-height: 1.05;
  color: var(--gold-tx, #8f6a1f);
  font-variant-numeric: tabular-nums;
}
.rk-mylab { font-size: 13px; color: var(--t3, #64748b); }
.rk-memetric { font-size: 13px; color: var(--t2, #5b6b82); margin-top: 4px; }
.rk-meacts { display: flex; gap: 10px; justify-content: center; margin-top: 12px; }

/* 小动作按钮 */
.rk-mini {
  padding: 6px 12px;
  border-radius: 999px;
  border: 1px solid var(--ln, rgba(148, 163, 184, .18));
  background: var(--well, #fff);
  color: var(--t2, #5b6b82);
  font-size: 12px;
  line-height: 1.2;
}
.rk-del { color: var(--red, #cc3d3d); border-color: var(--red, #cc3d3d); }

/* 榜单行 */
.rk-row {
  display: flex; align-items: center; gap: 10px;
  padding: 11px 2px;
  border-bottom: 1px solid var(--ln-soft, rgba(148, 163, 184, .10));
}
.rk-row:last-of-type { border-bottom: none; }
.rk-no {
  flex: 0 0 26px; text-align: center;
  font-size: 13px; font-weight: 700;
  color: var(--t3, #64748b);
  font-variant-numeric: tabular-nums;
}
.rk-no-1 { color: var(--gold, #d4a94e); font-size: 16px; }
.rk-no-2 { color: var(--t2, #5b6b82); font-size: 16px; }
.rk-no-3 { color: var(--t4, #7d92ab); font-size: 16px; }
.rk-main { flex: 1 1 auto; min-width: 0; }
.rk-nm { font-size: 14px; color: var(--t1, #18233a); }
.rk-tagme { margin-left: 6px; }
.rk-sub { font-size: 11.5px; margin-top: 2px; }
.rk-val {
  flex: 0 0 auto; text-align: right;
  font-size: 16px; font-weight: 700;
  color: var(--gold-tx, #8f6a1f);
  font-variant-numeric: tabular-nums;
}
.rk-unit { font-size: 11px; font-weight: 400; color: var(--t3, #64748b); }
.rk-ops { flex: 0 0 auto; display: flex; flex-direction: column; gap: 6px; }
.rk-note { font-size: 11.5px; margin-top: 10px; line-height: 1.6; }

.rk-input {
  margin-top: 10px;
  padding: 11px 12px;
  border-radius: 10px;
  border: 1px solid var(--ln, rgba(148, 163, 184, .18));
  background: var(--well, #fff);
  color: var(--t1, #18233a);
  font-size: 14px;
}
.rk-addbtn { margin-top: 12px; }
.rk-msg {
  margin-top: 8px;
  font-size: 12.5px;
  color: var(--gold-tx, #8f6a1f);
}
