.page { padding-bottom: 80rpx; }
.day-nav { display: flex; align-items: center; justify-content: space-between; margin: 20rpx 24rpx 6rpx; }
.dn-btn {
  width: 72rpx; height: 72rpx; border-radius: 22rpx; display: flex; align-items: center; justify-content: center;
  background: rgba(212,169,78,.12); border: 1rpx solid rgba(212,169,78,.3); color: var(--chip-tx, #d4a94e); font-size: calc(40rpx * var(--fs, 1));
  box-shadow: 0 8rpx 20rpx rgba(3,7,18,.3);
}
.dn-btn:active { background: rgba(212,169,78,.3); }
.dn-txt { font-size: calc(30rpx * var(--fs, 1)); font-weight: 800; }

/* 图层切换 */
.layer-bar { display: flex; gap: 14rpx; padding: 12rpx 24rpx 0; }
.layer-chip { flex: 1; text-align: center; padding: 16rpx 0; font-size: calc(24rpx * var(--fs, 1)); color: var(--t2, #c9d4e4);
  background: rgba(var(--ln-rgb, 148,163,184),.04); border: 1rpx solid rgba(var(--ln-rgb, 148,163,184),.2); border-radius: 18rpx; }
.layer-chip:active { opacity: .7; }
.layer-chip.on { color: #14100a; background: linear-gradient(135deg, #e2b65c, #b8892f); font-weight: 800; border-color: transparent; }

.the-map { width: calc(100% - 48rpx); height: 640rpx; margin: 16rpx 24rpx; border-radius: 28rpx; overflow: hidden;
  border: 1rpx solid rgba(var(--ln-rgb, 148,163,184),.18); box-shadow: 0 14rpx 40rpx rgba(3,7,18,.42); }
.spot { display: flex; align-items: center; padding: 18rpx 6rpx; border-bottom: 1rpx solid rgba(var(--ln-rgb, 148,163,184),.07); }
.spot:active { background: rgba(var(--ln-rgb, 138,165,192),.05); border-radius: 14rpx; }
.spot:last-child { border-bottom: none; }
.seq { width: 38rpx; height: 38rpx; border-radius: 50%; display: flex; align-items: center; justify-content: center;
  background: linear-gradient(135deg, #e2b65c, #b8892f); color: #14100a; font-size: calc(21rpx * var(--fs, 1)); font-weight: 800;
  margin-right: 14rpx; flex-shrink: 0; box-shadow: 0 4rpx 12rpx rgba(212,169,78,.3); }
.seq.approx-seq { background: rgba(var(--ln-rgb, 148,163,184),.16); color: var(--t3, #8fa3bc); font-weight: 600; box-shadow: none; }
.p { font-size: calc(20rpx * var(--fs, 1)); background: rgba(212,169,78,.13); color: var(--chip-tx, #d4a94e); border-radius: 99rpx; padding: 4rpx 14rpx; margin-right: 16rpx; min-width: 96rpx; text-align: center; }
.n { font-size: calc(27rpx * var(--fs, 1)); flex: 1; }
.approx { font-size: calc(18rpx * var(--fs, 1)); color: var(--t4, #5b6b82); border: 1rpx solid rgba(var(--ln-rgb, 148,163,184),.25); border-radius: 99rpx; padding: 2rpx 12rpx; margin-left: 10rpx; }
.nav { margin-left: 16rpx; font-size: calc(32rpx * var(--fs, 1)); }
.tip-inner { font-size: calc(22rpx * var(--fs, 1)); line-height: 1.6; margin-top: 12rpx; }

.food { padding: 18rpx 6rpx; border-bottom: 1rpx solid rgba(var(--ln-rgb, 148,163,184),.07); display: flex; flex-direction: column; gap: 4rpx; border-radius: 14rpx; }
.food:active { background: rgba(212,169,78,.08); }
.f-em { font-size: calc(24rpx * var(--fs, 1)); color: var(--chip-tx, #d4a94e); font-weight: 700; }
.f-shop { font-size: calc(28rpx * var(--fs, 1)); color: var(--t1, #eaeff7); }
.f-addr { font-size: calc(21rpx * var(--fs, 1)); }
.f-price { font-size: calc(21rpx * var(--fs, 1)); color: var(--green, #7dd3a8); }

.hotel { padding: 24rpx 6rpx; border-radius: 16rpx; }
.hotel:active { background: rgba(212,169,78,.08); }
.h-em { font-size: calc(30rpx * var(--fs, 1)); font-weight: 700; color: var(--chip-tx, #d4a94e); display: block; }
.h-sub { font-size: calc(21rpx * var(--fs, 1)); display: block; margin-top: 6rpx; }
.h-price { font-size: calc(21rpx * var(--fs, 1)); display: block; margin-top: 8rpx; color: var(--acc, #d4a94e); }
.dim { color: var(--t4, #5b6b82); }
.portal-t { font-size: calc(22rpx * var(--fs, 1)); color: var(--t3, #8495ad); margin: 22rpx 0 12rpx; }
.portals { display: flex; flex-wrap: wrap; gap: 14rpx; }
.portal { font-size: calc(23rpx * var(--fs, 1)); color: var(--on-gold, #d4a94e); background: rgba(212,169,78,.12); border: 1rpx solid rgba(212,169,78,.35); border-radius: 999rpx; padding: 10rpx 24rpx; }
.portal:active { background: rgba(212,169,78,.22); }

/* v1.8.4 B11 顺路度评分条 */
.route-bar { display: flex; align-items: center; gap: 18rpx; margin: 0 0 18rpx; }
.rb-score { width: 84rpx; height: 84rpx; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: calc(34rpx * var(--fs, 1)); font-weight: 800; color: var(--on-gold, #fff); flex-shrink: 0; }
.rb-good { background: linear-gradient(135deg, #59b87b, #3f9d5c); }
.rb-mid { background: linear-gradient(135deg, #d4a94e, #b3872e); }
.rb-low { background: linear-gradient(135deg, #d9806a, #c2452e); }
.rb-na { background: rgba(var(--ln-rgb, 100,116,139), .25); color: var(--dim, #7b8aa0); }
.rb-main { flex: 1; min-width: 0; }
.rb-t { font-size: calc(26rpx * var(--fs, 1)); font-weight: 700; }
.rb-s { font-size: calc(22rpx * var(--fs, 1)); }

/* v1.15 当天景点标签筛选 */
.tag-bar { display: flex; flex-wrap: wrap; gap: 12rpx; margin: 14rpx 0 4rpx; }
.tag-chip { font-size: calc(22rpx * var(--fs, 1)); color: var(--t3, #8fa3bc); border: 1rpx solid rgba(var(--ln-rgb, 148,163,184),.28); border-radius: 99rpx; padding: 6rpx 20rpx; background: rgba(var(--ln-rgb, 148,163,184),.06); }
.tag-chip.on { color: var(--chip-tx, #d4a94e); border-color: rgba(212,169,78,.55); background: rgba(212,169,78,.12); }
/* v1.20.6：无坐标美食店显式标注 */
.f-nocoord { font-size: calc(19rpx * var(--fs, 1)); color: var(--t3, #8fa3bc); border: 1rpx dashed rgba(var(--ln-rgb, 148,163,184), .4); border-radius: 999rpx; padding: 2rpx 12rpx; }
