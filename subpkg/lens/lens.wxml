<view class="page {{td ? 'td' : ''}} fz{{fz}}">
  <!-- 头部说明 -->
  <view class="card head">
    <view class="h2"><image lazy-load class="ic" src="/images/icons/camera.png"/>AI 识物 · 旅途科普</view>
    <view class="sub">拍一张或多张（不同角度）旅途中的花草、地标或美食，AI 帮你认一认，并讲讲能碰不能碰、值不值得看的小知识。</view>
    <view class="cloud-tag {{cloudOn ? 'on' : 'off'}}">{{cloudOn ? '云端 AI 已就绪' : '云端未开启 · 可先「文字问」'}}</view>
  </view>

  <!-- 拍照 / 相册（支持多张不同角度，提升识别准确率） -->
  <view class="card pick">
    <view class="grid" wx:if="{{imgs.length}}">
      <view class="cell" wx:for="{{imgs}}" wx:key="*this">
        <image lazy-load class="cell-img" src="{{item}}" mode="aspectFill"/>
        <view class="cell-x" catchtap="removeImg" data-i="{{index}}">✕</view>
      </view>
      <view class="cell cell-add" wx:if="{{imgs.length < 3}}" bindtap="pickAlbum">
        <text class="add-t">＋ 再加一张</text>
      </view>
    </view>
    <view class="placeholder" wx:else>
      <image lazy-load class="ph-ic" src="/images/icons/camera.png"/>
      <text class="ph-t">还没有照片（最多 3 张不同角度）</text>
    </view>
    <view class="pick-ops">
      <view class="op op-main" bindtap="takePhoto"><image lazy-load class="op-ic" src="/images/icons/camera.png"/>拍照</view>
      <view class="op" bindtap="pickAlbum"><image lazy-load class="op-ic" src="/images/icons/search.png"/>相册</view>
      <view class="op op-go {{imgs.length ? '' : 'op-dis'}}" bindtap="identify">识别</view>
    </view>
  </view>

  <!-- 识别 / 回答结果 -->
  <view class="card result" wx:if="{{result}}">
    <view class="h3">识别结果<text class="ai-badge" wx:if="{{source}}">AI 生成</text><text class="vote-badge" wx:if="{{voted}}">二次核验</text></view>
    <text class="r-txt">{{result}}</text>
    <view class="r-ops">
      <view class="ai-copy" bindtap="copyResult">复制</view>
      <view class="ai-copy" bindtap="clearImgs">重选图片</view>
    </view>
    <!-- 识别联动：查这个景点 / 加入行程（仅在解析出明确名称时显示） -->
    <view class="spot-ops" wx:if="{{spotName}}">
      <view class="sp-btn" bindtap="onLookupSpot">查这个景点</view>
      <view class="sp-btn sp-primary" bindtap="onAddToTrip">加入行程</view>
      <text class="sp-hint">识别为「{{spotName}}」</text>
    </view>
    <view class="spot-info" wx:if="{{spotInfo}}">
      <view class="si-h"><text class="si-name">{{spotInfo.name}}</text><text class="si-city" wx:if="{{spotInfo.city}}">{{spotInfo.city}}</text></view>
      <text class="si-txt" wx:if="{{spotInfo.intro}}">{{spotInfo.intro}}</text>
      <text class="si-txt" wx:if="{{spotInfo.how}}">怎么去：{{spotInfo.how}}</text>
      <text class="si-txt" wx:if="{{spotInfo.route}}">{{spotInfo.route}}</text>
      <view class="si-close" bindtap="onCloseSpot">收起</view>
    </view>
    <view class="spot-err" wx:if="{{spotErr}}">{{spotErr}}</view>
  </view>
  <view class="card loading" wx:if="{{loading}}">AI 思考中…</view>
  <view class="card err" wx:if="{{err}}">{{err}}</view>

  <!-- 文字问（视觉不可用时的科普兜底） -->
  <view class="card textq">
    <view class="tq-head" bindtap="toggleText">
      <text class="h3">不想拍照？用文字问 {{textMode ? '▴' : '▾'}}</text>
    </view>
    <block wx:if="{{textMode}}">
      <view class="tq-row">
        <input class="tq-inp" placeholder="如：金银花能泡茶吗？这是什么树的叶子？" value="{{textInput}}" bindinput="onTextInput" bindconfirm="askText" confirm-type="send"/>
        <view class="tq-btn" bindtap="askText">问</view>
        <view class="ai-copy" bindtap="aiClearChat">清空会话</view>
      </view>
    </block>
  </view>

  <view class="foot">
    <text class="foot-t">识别由云端多模态模型完成，可能存在误差；涉及食用、药用、有毒物种请以专业鉴定为准，切勿仅凭 AI 结论入口。</text>
    <view class="foot-a" bindtap="goAssistant">去本地速查 →</view>
  </view>
</view>
