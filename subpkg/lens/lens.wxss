.page { display: flex; flex-direction: column; min-height: 100vh; box-sizing: border-box; padding-bottom: 40rpx; }

/* 头部 */
.head .h2 { font-size: calc(32rpx * var(--fs, 1)); display: flex; align-items: center; }
.head .h2 .ic { width: 36rpx; height: 36rpx; vertical-align: -4rpx; margin-right: 10rpx; }
.head .sub { font-size: calc(24rpx * var(--fs, 1)); color: var(--t3, #8fa3bc); line-height: 1.65; margin: 12rpx 0 14rpx; }
.cloud-tag { display: inline-block; font-size: calc(21rpx * var(--fs, 1)); border-radius: 999rpx; padding: 4rpx 18rpx; }
.cloud-tag.on { color: #14100a; background: linear-gradient(135deg, #e2b65c, #d4a94e); font-weight: 700; }
.cloud-tag.off { color: var(--t3, #8fa3bc); border: 1rpx dashed rgba(var(--ln-rgb, 148, 163, 184), .4); }

/* 拍照区 */
.pick { padding: 0; overflow: hidden; }
.preview { position: relative; }
.pv-img { width: 100%; height: 460rpx; display: block; }
.pv-clear { position: absolute; right: 18rpx; top: 18rpx; font-size: calc(22rpx * var(--fs, 1)); color: #fff; background: rgba(0, 0, 0, .52); border-radius: 999rpx; padding: 8rpx 20rpx; }
.placeholder { height: 300rpx; display: flex; flex-direction: column; align-items: center; justify-content: center; color: var(--t3, #8fa3bc); }
.ph-ic { width: 72rpx; height: 72rpx; opacity: .7; margin-bottom: 12rpx; }
.ph-t { font-size: calc(24rpx * var(--fs, 1)); }
.pick-ops { display: flex; gap: 14rpx; padding: 18rpx; }
.op { flex: 1; display: flex; align-items: center; justify-content: center; gap: 8rpx; padding: 18rpx 0; border-radius: 16rpx;
  background: var(--panel, #18233a); border: 1rpx solid rgba(var(--ln-rgb, 148, 163, 184), .16);
  font-size: calc(26rpx * var(--fs, 1)); color: var(--t1, #dce5f0); }
.op:active { opacity: .82; }
.op-ic { width: 32rpx; height: 32rpx; }
.op-main { color: var(--chip-tx, #d4a94e); }
.op-go { flex: none; padding-left: 34rpx; padding-right: 34rpx; background: linear-gradient(135deg, #e2b65c, #d4a94e 45%, #b8892f); color: #14100a; font-weight: 800; }
.op-dis { opacity: .5; }

/* 多图网格（v1.20.7 增强：最多 3 张不同角度） */
.grid { display: flex; flex-wrap: wrap; gap: 12rpx; padding: 18rpx 18rpx 0; }
.cell { position: relative; width: calc((100% - 24rpx) / 3); aspect-ratio: 1 / 1; border-radius: 16rpx; overflow: hidden; background: var(--panel, #18233a); border: 1rpx solid rgba(var(--ln-rgb, 148, 163, 184), .16); }
.cell-img { width: 100%; height: 100%; display: block; }
.cell-x { position: absolute; right: 8rpx; top: 8rpx; width: 40rpx; height: 40rpx; line-height: 40rpx; text-align: center; font-size: calc(24rpx * var(--fs, 1)); color: #fff; background: rgba(0, 0, 0, .52); border-radius: 999rpx; }
.cell-add { display: flex; align-items: center; justify-content: center; border: 1rpx dashed rgba(var(--chip-rgb, 212, 169, 78), .5); background: rgba(212, 169, 78, .08); }
.cell-add .add-t { font-size: calc(23rpx * var(--fs, 1)); color: var(--chip-tx, #d4a94e); text-align: center; }

/* 结果 */
.result .h3 { display: flex; align-items: center; gap: 14rpx; font-size: calc(28rpx * var(--fs, 1)); margin-bottom: 12rpx; }
.vote-badge { font-size: calc(20rpx * var(--fs, 1)); font-weight: 700; color: #d4a94e; border: 1rpx solid rgba(var(--chip-rgb, 212, 169, 78), .5); border-radius: 999rpx; padding: 2rpx 16rpx; }
.r-ops { display: flex; gap: 14rpx; margin-top: 16rpx; }
.ai-copy { font-size: calc(22rpx * var(--fs, 1)); color: var(--t3, #8fa3bc); border: 1rpx dashed rgba(var(--ln-rgb, 148, 163, 184), .35); border-radius: 999rpx; padding: 8rpx 22rpx; }
.ai-copy:active { color: var(--chip-tx, #d4a94e); }
.result .h3 { display: flex; align-items: center; gap: 14rpx; font-size: calc(28rpx * var(--fs, 1)); margin-bottom: 12rpx; }
.ai-badge { font-size: calc(20rpx * var(--fs, 1)); font-weight: 700; color: #14100a; background: linear-gradient(135deg, #e2b65c, #d4a94e); border-radius: 999rpx; padding: 2rpx 16rpx; }
.r-txt { display: block; font-size: calc(27rpx * var(--fs, 1)); color: var(--t1, #dce5f0); line-height: 1.78; white-space: pre-wrap; word-break: break-word; }

/* 识别联动：查景点 / 加入行程 */
.spot-ops { display: flex; align-items: center; flex-wrap: wrap; gap: 14rpx; margin-top: 18rpx; padding-top: 16rpx; border-top: 1rpx solid rgba(var(--ln-rgb, 148, 163, 184), .14); }
.sp-btn { font-size: calc(25rpx * var(--fs, 1)); border-radius: 999rpx; padding: 12rpx 28rpx; background: var(--panel, #18233a); border: 1rpx solid rgba(var(--ln-rgb, 148, 163, 184), .22); color: var(--t1, #dce5f0); }
.sp-btn:active { opacity: .82; }
.sp-primary { background: linear-gradient(135deg, #e2b65c, #d4a94e 45%, #b8892f); color: #14100a; font-weight: 800; border: none; }
.sp-hint { font-size: calc(21rpx * var(--fs, 1)); color: var(--t3, #8fa3bc); margin-left: auto; }
.spot-info { margin-top: 16rpx; padding: 18rpx; border-radius: 16rpx; background: rgba(var(--chip-rgb, 212, 169, 78), .08); border: 1rpx solid rgba(var(--chip-rgb, 212, 169, 78), .28); }
.si-h { display: flex; align-items: center; gap: 12rpx; margin-bottom: 10rpx; }
.si-name { font-size: calc(28rpx * var(--fs, 1)); font-weight: 800; color: var(--chip-tx, #d4a94e); }
.si-city { font-size: calc(22rpx * var(--fs, 1)); color: var(--t3, #8fa3bc); }
.si-txt { display: block; font-size: calc(25rpx * var(--fs, 1)); color: var(--t1, #dce5f0); line-height: 1.7; margin-top: 6rpx; }
.si-close { margin-top: 12rpx; font-size: calc(22rpx * var(--fs, 1)); color: var(--t3, #8fa3bc); text-align: right; }
.spot-err { margin-top: 14rpx; font-size: calc(23rpx * var(--fs, 1)); color: var(--red, #e56a6a); line-height: 1.6; }

/* 加载 / 错误 */
.loading { font-size: calc(25rpx * var(--fs, 1)); color: var(--t3, #8fa3bc); }
.err { font-size: calc(25rpx * var(--fs, 1)); color: var(--red, #e56a6a); line-height: 1.65; }

/* 文字问 */
.textq .tq-head { padding: 4rpx 0; }
.textq .h3 { font-size: calc(27rpx * var(--fs, 1)); color: var(--t1, #dce5f0); }
.tq-row { display: flex; align-items: center; gap: 12rpx; margin-top: 14rpx; }
.tq-inp { flex: 1; background: var(--card, #131d31); border: 1rpx solid rgba(var(--ln-rgb, 148, 163, 184), .18); border-radius: 999rpx; padding: 16rpx 26rpx; font-size: calc(26rpx * var(--fs, 1)); color: var(--t1, #eaeff7); }
.tq-btn { flex: none; background: linear-gradient(135deg, #e2b65c, #d4a94e 45%, #b8892f); color: #14100a; font-weight: 800; border-radius: 999rpx; padding: 16rpx 30rpx; font-size: calc(26rpx * var(--fs, 1)); }

/* 脚注 */
.foot { padding: 8rpx 8rpx 0; }
.foot-t { display: block; font-size: calc(21rpx * var(--fs, 1)); color: var(--t3, #8fa3bc); line-height: 1.6; }
.foot-a { margin-top: 12rpx; font-size: calc(24rpx * var(--fs, 1)); color: var(--chip-tx, #d4a94e); }
