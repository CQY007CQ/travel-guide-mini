.page { padding: 28rpx 24rpx 60rpx; min-height: 100vh; background: var(--bg, #f5f6f8); }
.td.page { background: #0d0d0d; }
.head { margin: 8rpx 6rpx 22rpx; }
.h-t { font-size: calc(40rpx * var(--fs, 1)); font-weight: 800; color: var(--t1, #18233a); }
.h-s { margin-top: 8rpx; font-size: calc(24rpx * var(--fs, 1)); }

.dim { color: var(--tx-2, #6b7689); }

.card {
  background: var(--card-bg, #fff);
  border-radius: 20rpx;
  padding: 26rpx 26rpx 22rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(20,30,50,.06);
}
.td .card { background: #1a1a1a; box-shadow: none; border: 1rpx solid rgba(255,255,255,.06); }

.mg-item { transition: transform .18s ease, opacity .18s ease; }
.mg-item:active { transform: scale(.985); opacity: .92; }
.mg-top { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; }
.mg-title { flex: 1; font-size: calc(31rpx * var(--fs, 1)); font-weight: 700; color: var(--t1, #18233a); }
.td .mg-title { color: #f2f3f5; }
.mg-del { flex: none; font-size: calc(24rpx * var(--fs, 1)); color: #c0563f; padding: 6rpx 14rpx; border-radius: 999rpx; background: rgba(192,86,63,.1); }
.td .mg-del { color: #e08c78; background: rgba(224,140,120,.14); }
.mg-meta { margin-top: 12rpx; font-size: calc(24rpx * var(--fs, 1)); }
.mg-go { margin-top: 16rpx; font-size: calc(26rpx * var(--fs, 1)); font-weight: 600; color: var(--gold, #d4a94e); }

.tip { margin-top: 12rpx; padding: 0 6rpx; font-size: calc(22rpx * var(--fs, 1)); color: var(--tx-2, #6b7689); }

/* 空态改用全局 .empty 卡片（app.wxss），与「今日」页一致；图标悬浮动效由 em-float 提供 */

@media (prefers-reduced-motion: reduce) {
  .mg-item, .mg-item:active { transition: none; }
}
