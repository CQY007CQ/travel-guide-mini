.page { padding-bottom: 100rpx; }

.summary { background: linear-gradient(135deg, rgba(212,169,78,.14), var(--card, #131d31)); border-color: rgba(212,169,78,.3); }

.sum-title { font-size: calc(30rpx * var(--fs, 1)); font-weight: 800; line-height: 1.35; }

.sum-sub { font-size: calc(22rpx * var(--fs, 1)); color: var(--t3, #8fa3bc); margin-top: 8rpx; }

.day-txt { flex: 1; min-width: 0; }

.mc-n { flex: 1; min-width: 0; }

.day-card { padding: 26rpx 26rpx 20rpx; }

/* 头：金色编号方块（对齐网页 day-num） */
.day-head { display: flex; align-items: center; gap: 18rpx; margin-bottom: 16rpx; padding-right: 2rpx; }

.day-num {
  flex: none; width: 74rpx; height: 74rpx; border-radius: 22rpx;
  display: flex; align-items: center; justify-content: center;
  font-weight: 800; font-size: calc(26rpx * var(--fs, 1)); color: var(--on-gold, #fff);
  background: linear-gradient(160deg, #e6bb62, #d4a94e 55%, #b8892f);
  box-shadow: 0 8rpx 20rpx rgba(212, 169, 78, .32), inset 0 1rpx 0 rgba(255,255,255,.35);
  letter-spacing: 1rpx;
}

.day-title-row { display: flex; align-items: center; gap: 12rpx; flex-wrap: wrap; }

.day-theme { font-size: calc(30rpx * var(--fs, 1)); font-weight: 800; letter-spacing: .5rpx; }

.day-date { font-size: calc(21rpx * var(--fs, 1)); margin-top: 4rpx; letter-spacing: .5rpx; }

/* 时间线：竖线 + 发光圆点（对齐网页 .timeline/.tl-item） */
.tl { position: relative; padding-left: 26rpx; margin-top: 4rpx; }

.tl::before {
  content: ""; position: absolute; left: 9rpx; top: 16rpx; bottom: 8rpx;
  width: 3rpx; border-radius: 3rpx;
  background: linear-gradient(180deg, rgba(212,169,78,.55), rgba(212,169,78,.18) 60%, rgba(212,169,78,0));
}

.tl-item {
  position: relative; padding: 14rpx 4rpx 16rpx;
  display: flex; align-items: flex-start;
  border-radius: 18rpx;
  transition: background .25s;
}

.tl-item::before {
  content: ""; position: absolute; left: -25rpx; top: 30rpx;
  width: 13rpx; height: 13rpx; border-radius: 50%;
  background: linear-gradient(160deg, #e6bb62, #b8892f);
  box-shadow: 0 0 0 4rpx rgba(212,169,78,.14), 0 0 12rpx rgba(212,169,78,.28);
}


.tl-item:last-child { padding-bottom: 6rpx; }

.tl-item.open { background: linear-gradient(90deg, rgba(212,169,78,.08), rgba(var(--ln-rgb, 138,165,192),.04)); box-shadow: inset 4rpx 0 0 #d4a94e; }

.tl-main { flex: 1; min-width: 0; }

.tl-top { display: flex; align-items: flex-start; flex-wrap: wrap; row-gap: 8rpx; }

.tl-period {
  flex: none; align-self: center; font-size: calc(21rpx * var(--fs, 1)); font-weight: 700;
  color: var(--chip-tx, #d4a94e); background: rgba(212,169,78,.14);
  border: 1rpx solid rgba(212,169,78,.26);
  padding: 4rpx 14rpx; border-radius: 99rpx; margin-right: 12rpx;
}

.tl-period.p-f { background: rgba(var(--ln-rgb, 148,163,184),.12); border-color: transparent; color: var(--t3, #8fa3bc); }

.tl-name { font-size: calc(27rpx * var(--fs, 1)); font-weight: 600; line-height: 1.5; flex: 1; min-width: 0; }

.tl-name.n-f { color: var(--t3, #8fa3bc); font-weight: 500; }

/* 体力 / 时长徽章 */
.badge { flex: none; align-self: center; font-size: calc(17rpx * var(--fs, 1)); line-height: 1;
  border-radius: 99rpx; padding: 5rpx 11rpx; margin-left: 8rpx; font-weight: 700; letter-spacing: .5rpx; }

.badge.eff.e2 { color: var(--gold-tx, #e8b56a); background: rgba(212,169,78,.12); border: 1rpx solid rgba(212,169,78,.3); }

.badge.eff.e1 { color: var(--chip-tx, #d4a94e); background: rgba(212,169,78,.1); border: 1rpx solid rgba(212,169,78,.24); }

.badge.eff.e0 { color: var(--green, #7dd3a8); background: rgba(95,185,138,.1); border: 1rpx solid rgba(95,185,138,.26); }

.eff-sep { color: var(--t3, #8fa3bc); font-weight: 500; margin: 0 1rpx; }

.tl-note { font-size: calc(21rpx * var(--fs, 1)); color: var(--t3, #8fa3bc); margin: 8rpx 0 0 2rpx; line-height: 1.55; }
/* v1.19.135：已打卡景点的个人评价，金边浅底区别于行程建议备注 */
.tl-fnote { font-size: calc(21rpx * var(--fs, 1)); color: var(--t1, #1b2330); margin: 8rpx 0 0 2rpx; line-height: 1.55; padding: 8rpx 12rpx; border-left: 4rpx solid #d4a94e; background: rgba(212,169,78,.10); border-radius: 6rpx; }

/* 详情面板：原地展开（对齐网页 .spot-detail，淡入） */
.spot-detail {
  margin: 14rpx 0 2rpx; padding: 18rpx 20rpx 16rpx;
  background: rgba(var(--ln-rgb, 148,163,184),.06);
  border: 1rpx solid rgba(var(--ln-rgb, 148,163,184),.14);
  border-left: 5rpx solid #d4a94e;
  border-radius: 16rpx;
  box-shadow: inset 0 1rpx 0 rgba(var(--ln-rgb, 148,163,184),.04);
  animation: sdIn .28s ease-out;
}

@keyframes sdIn { from { opacity: 0; transform: translateY(-6rpx); } to { opacity: 1; transform: none; } }

.detail-acts { display: flex; gap: 16rpx; margin-bottom: 12rpx; flex-wrap: wrap; }

.d-btn { font-size: calc(22rpx * var(--fs, 1)); color: var(--blue, #7dd3fc); background: rgba(56,189,248,.1); border: 1rpx solid rgba(56,189,248,.25); border-radius: 99rpx; padding: 7rpx 22rpx; }

.d-btn:active { opacity: .6; }

.d-btn.d-btn-main { color: var(--gold-tx, #e8c877); background: rgba(212,169,78,.16); border-color: rgba(212,169,78,.45); font-weight: 700; }

.sd-body { font-size: calc(23rpx * var(--fs, 1)); color: var(--t2, #c9d4e4); line-height: 1.75; white-space: pre-line; word-break: break-word; }
/* v1.19.33：离线百科兜底时附带的「怎么去」交通提示（来自 SPOT_DETAILS.how） */
.sd-how { display: flex; align-items: flex-start; gap: 12rpx; margin-top: 14rpx; padding-top: 12rpx; border-top: 1rpx dashed rgba(var(--ln-rgb, 148,163,184),.2); }
.sd-how-l { flex: none; font-size: calc(19rpx * var(--fs, 1)); font-weight: 700; color: var(--gold-tx, #e8b56a); background: rgba(212,169,78,.12); border: 1rpx solid rgba(212,169,78,.28); padding: 3rpx 12rpx; border-radius: 99rpx; margin-top: 2rpx; }
.sd-how-tx { flex: 1; font-size: calc(21rpx * var(--fs, 1)); color: var(--t3, #8fa3bc); line-height: 1.6; }

/* 行尾操作组（竖排轻量钮） */
.tl-ops { display: flex; flex-direction: column; gap: 6rpx; margin-left: 14rpx; flex-shrink: 0; align-items: center; padding-top: 2rpx; }

.op { font-size: calc(22rpx * var(--fs, 1)); width: 44rpx; height: 44rpx; display: flex; align-items: center; justify-content: center;
  background: rgba(var(--ln-rgb, 148,163,184),.04); border-radius: 12rpx; color: var(--t3, #8fa3bc); }

.op:active { background: rgba(212,169,78,.18); color: var(--chip-tx, #d4a94e); }

.op.del { color: var(--t4, #5b6b82); }

.op.del:active { background: rgba(204,61,61,.15); color: var(--red, #cc3d3d); }

/* 顶部操作 + 攻略速览 */
.sum-row { display: flex; align-items: flex-start; }

.sum-main { flex: 1; min-width: 0; }

.sum-ops { display: flex; gap: 10rpx; flex-shrink: 0; margin-left: 14rpx; }

.sop { min-width: 66rpx; height: 58rpx; border-radius: 14rpx; display: flex; flex-direction: column; align-items: center; justify-content: center;
  background: rgba(var(--ln-rgb, 148,163,184),.06); border: 1rpx solid rgba(var(--ln-rgb, 148,163,184),.18); padding: 0 10rpx; }

.sop:active { background: rgba(212,169,78,.2); }

.sop-ic { font-size: calc(24rpx * var(--fs, 1)); line-height: 1.15; }

.sop-tx { font-size: calc(17rpx * var(--fs, 1)); color: var(--t3, #9fb0c5); margin-top: 2rpx; }

.sop-end .sop-tx, .sop-end .sop-ic { color: var(--red, #e56a6a); }

.guide { margin-top: 18rpx; border-top: 1rpx dashed rgba(var(--ln-rgb, 148,163,184),.22); padding-top: 12rpx; }

.guide-head { display: flex; justify-content: space-between; align-items: center; padding: 6rpx 0; }

.guide-title { font-size: calc(24rpx * var(--fs, 1)); font-weight: 700; color: var(--chip-tx, #d4a94e); }

.guide-toggle { font-size: calc(21rpx * var(--fs, 1)); color: var(--t3, #8fa3bc); }

.guide-body { display: flex; flex-direction: column; gap: 10rpx; margin-top: 6rpx; }

.gb { font-size: calc(22rpx * var(--fs, 1)); color: var(--t2, #b9c6d8); line-height: 1.65; }

.pre { white-space: pre-line; word-break: break-all; }

/* 元信息 chips（日期段/倒计时/季节/最佳/模式/预算） */
.chips { display: flex; flex-wrap: wrap; gap: 10rpx; margin-top: 16rpx; }

.chip { font-size: calc(20rpx * var(--fs, 1)); color: var(--t2, #c9d4e4); background: rgba(var(--ln-rgb, 148,163,184),.09);
  border: 1rpx solid rgba(var(--ln-rgb, 148,163,184),.22); border-radius: 99rpx; padding: 5rpx 16rpx; line-height: 1.5; }
/* v1.19.145：酒店门户 chip（金色强调，区别于普通标签） */
.chip.portal { color: var(--on-gold, #d4a94e); background: rgba(212,169,78,.12); border-color: rgba(212,169,78,.35); }
.chip.portal:active { background: rgba(212,169,78,.22); }

/* 只玩勾选提示条 */
.pickonly-strip { margin-top: 14rpx; font-size: calc(21rpx * var(--fs, 1)); color: var(--chip-tx, #d4a94e);
  background: rgba(212,169,78,.1); border: 1rpx dashed rgba(212,169,78,.4);
  border-radius: 12rpx; padding: 10rpx 16rpx; line-height: 1.5; }

/* 收藏按钮态 */
.sop-fav-on { background: rgba(229,106,106,.16); border-color: rgba(229,106,106,.4); }

.sop-fav-on .sop-ic { color: var(--red, #e56a6a); }

.sop-fav-on .sop-tx { color: var(--red, #e56a6a); }

/* 想玩清单面板 */
.wish { border-color: rgba(212,169,78,.3); }

.wish-head { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; flex-wrap: wrap; }

.wish-txt { flex: 1; min-width: 0; }

.wish-title { font-size: calc(27rpx * var(--fs, 1)); font-weight: 800; color: var(--chip-tx, #d4a94e); }

.wish-sub { font-size: calc(21rpx * var(--fs, 1)); color: var(--t3, #8fa3bc); margin-top: 6rpx; }

.wish-acts { display: flex; gap: 12rpx; flex-shrink: 0; }

.w-btn { font-size: calc(21rpx * var(--fs, 1)); font-weight: 600; color: #131d31; background: #d4a94e;
  border-radius: 99rpx; padding: 10rpx 22rpx; }

.w-btn:active { opacity: .75; }

.w-btn.ghost { color: var(--chip-tx, #d4a94e); background: transparent; border: 1rpx solid rgba(212,169,78,.5); }

.wish-miss { margin-top: 16rpx; border-top: 1rpx dashed rgba(var(--ln-rgb, 148,163,184),.2); padding-top: 14rpx; }

.wm-tx { font-size: calc(21rpx * var(--fs, 1)); color: var(--t2, #b9c6d8); }

.miss-chips { display: flex; flex-wrap: wrap; gap: 10rpx; margin-top: 12rpx; }

.miss-chip { display: flex; align-items: center; gap: 8rpx; font-size: calc(21rpx * var(--fs, 1)); color: var(--t1, #e8edf4);
  background: rgba(var(--ln-rgb, 148,163,184),.05); border: 1rpx solid rgba(var(--ln-rgb, 148,163,184),.2);
  border-radius: 99rpx; padding: 7rpx 8rpx 7rpx 18rpx; }

.mc-x { width: 34rpx; height: 34rpx; border-radius: 50%; display: flex; align-items: center; justify-content: center;
  background: rgba(229,106,106,.18); color: var(--red, #e56a6a); font-size: calc(20rpx * var(--fs, 1)); }

.mc-x:active { background: rgba(229,106,106,.4); }

.wish-done { margin-top: 14rpx; font-size: calc(22rpx * var(--fs, 1)); color: var(--green, #7dd3a8);
  background: rgba(125,211,168,.08); border-radius: 10rpx; padding: 12rpx 16rpx; }

/* 路段徽章 + 当天地图入口（右对齐操作组） */
/* 预算 gauge：进度条 + 文案（数据来自 budgetGauge，JS 预计算） */
.bud-bar { margin-top: 16rpx; }

.bud-track { height: 12rpx; border-radius: 99rpx; background: rgba(var(--ln-rgb, 148,163,184),.14); overflow: hidden; }

.bud-fill { height: 100%; border-radius: 99rpx; background: linear-gradient(90deg, #d4a94e, #e8c05e); transition: width .4s ease; }

.bud-fill.over { background: linear-gradient(90deg, #cc3d3d, #e56a6a); }

.bud-tx { display: block; font-size: calc(20rpx * var(--fs, 1)); margin-top: 8rpx; color: var(--t3, #8fa3bc); }

.bud-tx.bud-over-tx { color: var(--red, #cc3d3d); }

.d-btn.d-visit-on { color: var(--green, #15855c); background: rgba(21,133,92,.1); border-color: rgba(21,133,92,.32); }

.dh-ops { margin-left: auto; display: flex; align-items: center; gap: 10rpx; flex-shrink: 0; }

.seg-tag { font-size: calc(19rpx * var(--fs, 1)); color: var(--chip-tx, #d4a94e); background: rgba(212,169,78,.13);
  border: 1rpx solid rgba(212,169,78,.3); border-radius: 99rpx; padding: 3rpx 14rpx; flex-shrink: 0; }

.day-map { font-size: calc(21rpx * var(--fs, 1)); color: var(--chip-tx, #d4a94e); background: rgba(212,169,78,.13);
  border: 1rpx solid rgba(212,169,78,.32); border-radius: 99rpx; padding: 4rpx 16rpx; flex-shrink: 0; }

.day-map:active { background: rgba(212, 169, 78, 0.3); }

.day-map.day-copy { color: var(--green, #7dd3a8); background: rgba(95,185,138,.1);
  border-color: rgba(95,185,138,.32); }

.day-map.day-copy:active { background: rgba(95,185,138,.26); }

/* 行体力徽章已迁移为 .badge.eff（见时间线区） */

/* 预算餐食参考条（budget × 行程一致） */
.day-meal { margin: 4rpx 0 14rpx; padding: 10rpx 14rpx; border-radius: 12rpx;
  background: linear-gradient(90deg, rgba(212,169,78,.12), rgba(212,169,78,.04));
  border: 1rpx dashed rgba(212,169,78,.35);
  font-size: calc(21rpx * var(--fs, 1)); color: var(--t3, #9fb0c8); line-height: 1.6; }

/* 时间线想玩高亮（对齐网页 ☆→★ on 金色态）：命中行整行高亮 + 行尾 ★ 按钮 + 详情按钮 */
.tl-item.wish-hit {
  background: linear-gradient(90deg, rgba(212,169,78,.13), rgba(212,169,78,.02) 72%);
  box-shadow: inset 5rpx 0 0 #d4a94e;
  border-radius: 16rpx;
}

.tl-item.wish-hit .tl-name { color: var(--gold-tx, #e8c877); }

.op.wish-on {
  background: rgba(212,169,78,.2); color: var(--gold-tx, #e8c877);
  box-shadow: 0 0 0 1rpx rgba(212,169,78,.45), 0 4rpx 10rpx rgba(212,169,78,.18);
}

.d-btn.d-wish-on {
  color: var(--gold-tx, #e8c877); background: rgba(212,169,78,.16); border-color: rgba(212,169,78,.5);
}

/* 行程天气卡（和风天气 QWeather 实时 · 首站城市） */
.wx-card { border-color: rgba(var(--ln-rgb, 148,163,184),.16); }

/* C2：天气降级显式提示条（拉取失败时替代天气卡出现） */
.wx-off { margin: 20rpx 24rpx; padding: 20rpx 24rpx; display: flex; align-items: center; gap: 16rpx;
  border-radius: 22rpx; border: 1rpx dashed rgba(var(--ln-rgb, 148,163,184), .24);
  background: rgba(var(--ln-rgb, 148,163,184), .06); }

.wx-off .ic { opacity: .5; flex-shrink: 0; }

.wx-off-t { flex: 1; min-width: 0; }

.wx-off-h { font-size: calc(24rpx * var(--fs, 1)); font-weight: 700; color: var(--t2, #c3cfe0); }

.wx-off-d { font-size: calc(20rpx * var(--fs, 1)); margin-top: 4rpx; line-height: 1.5; }

.wx-close { width: 44rpx; height: 44rpx; border-radius: 50%; flex-shrink: 0; color: var(--t4, #9aa7ba);
  font-size: calc(22rpx * var(--fs, 1)); display: flex; align-items: center; justify-content: center;
  background: rgba(var(--ln-rgb, 148,163,184), .10); }

.wx-close:active { background: rgba(var(--ln-rgb, 148,163,184), .22); }

/* v1.19.49：天气失败卡「重试」按钮 */
.wx-off-acts { display: flex; align-items: center; gap: 12rpx; flex-shrink: 0; }

.wx-retry { padding: 8rpx 26rpx; border-radius: 99rpx; font-size: calc(22rpx * var(--fs, 1)); font-weight: 700;
  color: var(--chip-tx, #14100a); background: linear-gradient(135deg, #e6bb62, #d4a94e);
  box-shadow: 0 6rpx 16rpx rgba(212, 169, 78, .26); }

.wx-retry:active { opacity: .85; }

.wx-head { display: flex; align-items: center; justify-content: space-between; gap: 12rpx; margin-bottom: 16rpx; }

.wx-h { font-size: calc(27rpx * var(--fs, 1)); font-weight: 800; color: var(--t1, #eaeff7); }

.wx-m { font-size: calc(19rpx * var(--fs, 1)); flex-shrink: 0; }

.wx-scroll { width: 100%; white-space: nowrap; }

.wx-days { display: inline-flex; gap: 14rpx; padding: 2rpx 2rpx 6rpx; }

.wx-day {
  flex: 0 0 auto; min-width: 200rpx; box-sizing: border-box;
  padding: 16rpx 16rpx 14rpx; text-align: left;
  background: rgba(var(--ln-rgb, 148,163,184),.045);
  border: 1rpx solid rgba(var(--ln-rgb, 148,163,184),.16); border-radius: 20rpx;
}

.wx-day.risk { border-color: rgba(229,106,106,.4); background: rgba(229,106,106,.07); }

.wxd-date { font-size: calc(21rpx * var(--fs, 1)); color: var(--t3, #8fa3bc); margin-bottom: 8rpx; }

.wxd-city { color: var(--acc, #7fa8d9); font-weight: 600; }

.wxd-main { display: flex; align-items: center; gap: 6rpx; margin-bottom: 4rpx; }

.wxd-desc { font-size: calc(22rpx * var(--fs, 1)); color: var(--t1, #eaeff7); font-weight: 600; }

.wxd-temp { display: flex; align-items: baseline; gap: 4rpx; font-size: calc(23rpx * var(--fs, 1)); }

.wxd-temp .tmax { color: var(--gold-tx, #e8c877); font-weight: 700; font-size: calc(26rpx * var(--fs, 1)); }

.wxd-temp .tmin { color: var(--blue, #7fa8d9); }

.wxd-feels { font-size: calc(18rpx * var(--fs, 1)); color: var(--t3, #7d8fa6); margin-left: auto; }

 /* v1.11：meta 行已合并日出日落（JS 预计算 metaLine），删掉 .wm-it / .wxd-sun 两条死样式 */
 .wxd-meta { margin-top: 6rpx; font-size: calc(18rpx * var(--fs, 1)); color: var(--t3, #9fb0c5); }

.wxd-risk { margin-top: 10rpx; font-size: calc(19rpx * var(--fs, 1)); font-weight: 600; border-radius: 99rpx; padding: 5rpx 0; text-align: center; }

.wxd-risk.r-ok { background: rgba(125,211,168,.1); color: var(--green, #7dd3a8); border: 1rpx solid rgba(125,211,168,.22); }

.wxd-risk.r-bad { background: rgba(229,106,106,.16); color: var(--red, #f39b9b); border: 1rpx solid rgba(229,106,106,.35); }

/* v1.19.150：雨雪天备选卡（目的地有雨/雪时，离线推荐室内 / 雨·雪景友好景点） */
.rainy-card { border-color: rgba(var(--ln-rgb, 148,163,184),.16); }

.rainy-hd { display: flex; align-items: center; margin-bottom: 12rpx; }

.rainy-sub { font-size: calc(20rpx * var(--fs, 1)); line-height: 1.5; margin: -4rpx 0 14rpx; }

.rainy-list { display: flex; flex-direction: column; gap: 12rpx; }

.rainy-item { display: flex; align-items: center; justify-content: space-between; gap: 16rpx;
  padding: 12rpx 16rpx; border-radius: 16rpx; background: rgba(var(--ln-rgb, 148,163,184),.045);
  border: 1rpx solid rgba(var(--ln-rgb, 148,163,184),.14); }

.rainy-n { font-size: calc(23rpx * var(--fs, 1)); color: var(--t2, #c3cfe0); font-weight: 600; flex: 1; min-width: 0; }

.rainy-r.chip { color: var(--blue, #7fa8d9); background: rgba(127,168,217,.12); border: 1rpx solid rgba(127,168,217,.3); flex-shrink: 0; }

/* 打卡进度条（绿色系，与金色预算条区分） */
.bud-fill.foot-fill { background: linear-gradient(90deg, #5fb98a, #7dd3a8); }

/* 工具行：换方案 / 加入日历 / 旅行拼图（一行多钮） */
.tool-row {
  display: flex; flex-wrap: wrap; gap: 12rpx; margin-top: 18rpx; padding-top: 16rpx;
  border-top: 1rpx dashed rgba(var(--ln-rgb, 148,163,184), .18);
}

.tool {
  font-size: calc(22rpx * var(--fs, 1)); line-height: 1.4; color: var(--t2, #b9c6d8);
