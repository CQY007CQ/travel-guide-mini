.limited-notice .ln-ic { flex: none; margin-top: 2rpx; font-weight: 800; color: var(--chip-tx, #d4a94e); }

/* v1.19.76：分享长图离屏画布 —— 不参与布局也不触发滚动
   v1.19.199：原 left:-10000rpx 把节点放到视口外，部分安卓真机会做渲染剔除，
   fields({node:true}) 拿不到节点 → 稳定「生成失败」。改为视口内 z-index:-1 垫底。
   ⚠️ v1.19.202 可见性回归根治（用户模拟器截图报障：每日行程页整屏被深蓝黑金卡片盖住）：
   v1.19.199 只挪了位置，却把 600×2400px 的 CSS 尺寸一起留在视口内。canvas type="2d"
   是同层渲染的原生组件，部分基础库 / 模拟器不服从 opacity 与负 z-index —— 画布照常
   绘制到最上层。_ensureShareCard() 在页面有行程时会自动画 750×600 分享卡（深蓝渐变 +
   品牌名 + 金线），位图被 CSS 拉伸成 600×2400 后正好铺满视口，行程内容全被遮住，
   居中文字又落在屏幕右缘被裁掉一半 —— 即截图所见。
   修复：CSS 尺寸收到 1×1px。节点仍在视口内、仍参与渲染（查询不会失败），但即使
   opacity/z-index 完全失效也只占左上角 1 像素，绝无可能遮挡页面。绘制与导出走
   canvas.width/height（由 _posterModel / _shareCardModel 决定），与 CSS 尺寸解耦；
   canvasToTempFilePath 已显式给出 x/y/width/height/destWidth/destHeight，不受影响。 */
.share-canvas {
  position: fixed;
  left: 0;
  top: 0;
  width: 1px;
  height: 1px;
  opacity: 0.01;
  pointer-events: none;
  z-index: -1;
}

/* ── v1.19.78：城市深度玩法（内容随 subai 分包懒加载） ───────────────── */
.dpp-card { margin-top: 20rpx; padding: 24rpx 26rpx 22rpx; background: var(--strip-bg, linear-gradient(135deg, rgba(212,169,78,.18) 0%, rgba(212,169,78,.05) 60%, #fff 100%)); }
.dpp-head { display: flex; align-items: baseline; justify-content: space-between; gap: 12rpx; }
.dpp-t { display: flex; align-items: center; gap: 10rpx; font-size: calc(29rpx * var(--fs, 1)); font-weight: 700; color: var(--t1, #18233a); }
.dpp-u { flex: none; font-size: calc(22rpx * var(--fs, 1)); }
.dpp-li { display: flex; align-items: flex-start; gap: 12rpx; margin-top: 12rpx; color: var(--tx-2, #46536b); font-size: calc(26rpx * var(--fs, 1)); line-height: 1.65; }
.dpp-dot { flex: none; width: 10rpx; height: 10rpx; margin-top: 16rpx; border-radius: 50%; background: var(--gold, #d4a94e); }
.dpp-more {
  margin-top: 18rpx; padding: 14rpx 22rpx; border-radius: 999rpx; text-align: center;
  background: var(--gold, #d4a94e); color: var(--on-gold, #fff);
  font-size: calc(26rpx * var(--fs, 1)); font-weight: 600;
  transition: transform .18s ease, opacity .18s ease;
}
.dpp-more:active { transform: scale(.965); opacity: .9; }
@media (prefers-reduced-motion: reduce) { .dpp-more { transition: none; } }

/* ── v1.19.179：保存到「我的攻略」本地库 ───────────────── */
.save-bar { margin-top: 20rpx; padding: 0 4rpx 8rpx; }
.save-btn {
  padding: 22rpx 26rpx; border-radius: 18rpx; text-align: center;
  background: linear-gradient(135deg, var(--gold, #d4a94e) 0%, #e7c578 100%);
  color: #fff; font-size: calc(29rpx * var(--fs, 1)); font-weight: 700;
  box-shadow: 0 6rpx 18rpx rgba(212,169,78,.28);
  transition: transform .18s ease, opacity .18s ease;
}
.save-btn:active { transform: scale(.97); opacity: .9; }
/* 已保存：金描边 + 透明底，单一金色调内区分状态，不引入新色相 */
.save-btn.saved { background: transparent; color: var(--gold, #d4a94e); border: 2rpx solid var(--gold, #d4a94e); box-shadow: none; }
@media (prefers-reduced-motion: reduce) { .save-btn { transition: none; } }

/* ── v1.19.188：攻略自评分卡（算法 v1.19.177）───────────────── */
.score-card { padding-bottom: 22rpx; }
.sc-head-r { display: flex; align-items: center; gap: 14rpx; }
.sc-grade { font-size: calc(21rpx * var(--fs, 1)); font-weight: 700; padding: 4rpx 16rpx; border-radius: 99rpx; }
.sc-grade.excellent { background: rgba(95, 185, 138, .14); color: var(--green, #5fb98a); }
.sc-grade.good { background: rgba(212, 169, 78, .16); color: var(--gold-tx, #d4a94e); }
.sc-grade.fair { background: rgba(212, 169, 78, .12); color: var(--gold-tx, #d4a94e); }
.sc-grade.weak { background: rgba(229, 106, 106, .14); color: var(--red, #e56a6a); }
.sc-grade.na { background: rgba(148, 163, 184, .14); color: var(--t4, #7d92ab); }
.sc-score { font-size: calc(42rpx * var(--fs, 1)); font-weight: 800; color: var(--t1, #eaeff7); line-height: 1; }
.sc-u { font-size: calc(20rpx * var(--fs, 1)); font-weight: 600; color: var(--t4, #7d92ab); margin-left: 2rpx; }
.sc-metrics { display: flex; align-items: stretch; margin: 18rpx 0 2rpx; padding: 18rpx 0; background: rgba(var(--ln-rgb, 148, 163, 184), .05); border-radius: 14rpx; }
.sc-m { flex: 1; display: flex; flex-direction: column; align-items: center; gap: 8rpx; }
.sc-mv { font-size: calc(31rpx * var(--fs, 1)); font-weight: 700; color: var(--t1, #eaeff7); line-height: 1; }
.sc-ml { font-size: calc(20rpx * var(--fs, 1)); color: var(--t4, #7d92ab); }
.sc-sep { width: 1rpx; background: rgba(var(--ln-rgb, 148, 163, 184), .14); }
.sc-sugs { margin-top: 16rpx; display: flex; flex-direction: column; gap: 11rpx; }
.sc-sug { display: flex; align-items: flex-start; gap: 10rpx; font-size: calc(22rpx * var(--fs, 1)); line-height: 1.6; color: var(--t3, #b9c6da); }
.sc-sug-dot { color: var(--gold, #d4a94e); flex-shrink: 0; font-weight: 700; }
.sc-sug-tx { flex: 1; min-width: 0; }
