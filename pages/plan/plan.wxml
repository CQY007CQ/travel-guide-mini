<view class="page {{td ? 'td' : ''}} fz{{fz}}">
  <!-- 头部：标题 + 元信息 chips + 收藏/复制/结束 -->
  <view class="summary card">
    <view class="sum-row">
      <view class="sum-main">
        <view class="sum-title"><image class="ic ic-title" src="/images/icons/pin.png"/> {{summary}}</view>
        <view class="sum-sub">{{stats}}</view>
        <!-- 构成统计作为次指标紧邻 stats，与标题同组，弱化层级 -->
        <view class="mix-line dim" wx:if="{{mixTxt}}"><image class="ic ic-sm" src="/images/icons/pie.png"/>{{mixTxt}}</view>
      </view>
      <!-- 有限数据层：诚实提示内容收集中 -->
      <view class="limited-notice" wx:if="{{limitedNotice}}"><text class="ln-ic">✦</text><text>该城攻略采集中，先给你框架，补齐后自动更新</text></view>
      <view class="sum-ops">
        <view class="sop {{isFav ? 'sop-fav-on' : ''}}" wx:if="{{!segs.length && !isProv}}" catchtap="onFav">
          <image class="sop-ic" src="/images/icons/{{isFav ? 'heart-on' : 'heart'}}.png"/>
          <text class="sop-tx">{{isFav ? '已收藏' : '收藏'}}</text>
        </view>
        <view class="sop" catchtap="onCopy"><image class="sop-ic" src="/images/icons/copy.png"/><text class="sop-tx">复制</text></view>
        <view class="sop sop-end" catchtap="onEnd"><image class="sop-ic" src="/images/icons/close.png"/><text class="sop-tx">结束</text></view>
      </view>
    </view>

    <!-- 元信息 chips（对齐网页 banner：日期段/倒计时/季节/最佳月份/出行模式/预算） -->
    <view class="chips" wx:if="{{metaChips.length}}">
      <text class="chip" wx:for="{{metaChips}}" wx:key="*this">{{item}}</text>
    </view>

    <!-- v1.8.4 A1：人流提示（公假 / 暑假 / 周末） -->
    <view class="hint-strip {{hint.lv}}" wx:for="{{hints}}" wx:key="date">
      <text class="hint-d">{{hint.dateTx}}</text>
      <text class="hint-t">{{hint.txt}}</text>
    </view>

    <!-- 出发倒计时 D-day（label 不含城市名，城市已在标题；tip 不再重复大数字） -->
    <view class="cd-strip" wx:if="{{countdown}}">
      <view class="cd-big {{countdown.phase}}">{{countdown.big}}<text class="cd-unit">{{countdown.unit}}</text><text class="cd-label">{{countdown.label}}</text></view>
      <view class="cd-tip dim">{{countdown.tip}}</view>
    </view>

    <!-- 打卡进度（与旅行足迹联动） -->
    <view class="bud-bar" wx:if="{{foot && foot.total}}">
      <view class="bud-track">
        <view class="bud-fill foot-fill" style="width:{{foot.pct}}%;"/>
      </view>
      <view class="bud-tx-row"><image class="ic" src="/images/icons/foot.png"/><text class="bud-tx">已打卡 {{foot.done}}/{{foot.total}}{{foot.done ? ' · 继续点亮' : ' · 点开景点详情打卡'}}</text></view>
    </view>

    <!-- 预算 gauge：账本实际花费 vs 行程总预算参考 -->
    <view class="bud-bar" wx:if="{{gauge}}">
      <view class="bud-track">
        <view class="bud-fill {{gauge.over ? 'over' : ''}}" style="width:{{gauge.pct}}%;"/>
      </view>
      <text class="bud-tx {{gauge.over ? 'bud-over-tx' : ''}}">{{gauge.txt}}</text>
    </view>

    <!-- 工具行（换方案 / 加入日历 / 分享长图） -->
    <view class="tool-row">
      <view class="tool" wx:if="{{!segs.length && !isProv}}" catchtap="onSwitchAlt"><image class="ic" src="/images/icons/shuffle.png"/>换方案 · {{altNames[altIdx]}}</view>
      <view class="tool" catchtap="onExportICS"><image class="ic" src="/images/icons/calendar.png"/>一键加入日历</view>
      <view class="tool" catchtap="onShareImg"><image class="ic" src="/images/icons/export.png"/>生成分享图</view>
      <view class="tool" catchtap="onRemind"><image class="ic" src="/images/icons/clock.png"/>出发提醒</view>
    </view>

    <!-- 只玩勾选提示条 -->
    <view class="pickonly-strip" wx:if="{{pickTxt}}"><image class="ic" src="/images/icons/target.png"/>{{pickTxt}}</view>

    <!-- 2026-10-29 去重：原「攻略速览」里的花费/住宿/适宜时节与下方「城市速览」和顶部 chips 重复，
         这里只保留两块独有的：怎么穿、怎么去。花费归 chips+城市速览，住宿归城市速览。 -->
    <view class="guide" wx:if="{{clothText || goText}}">
      <view class="guide-head" bindtap="toggleGuide">
        <text class="guide-title guide-title-row"><image class="ic" src="/images/icons/compass.png"/>穿衣与交通</text>
        <text class="guide-toggle">{{guideOpen ? '收起 ▴' : '展开 ▾'}}</text>
      </view>
      <view class="guide-body" wx:if="{{guideOpen}}">
        <text wx:if="{{clothText}}" class="gb pre">{{clothText}}</text>
        <text wx:if="{{goText}}" class="gb pre">{{goText}}</text>
      </view>
    </view>
  </view>

  <!-- v1.8.5 C5：顶部天数快速导航（sticky，点某天跳到对应卡） -->
  <view class="day-strip" wx:if="{{topDays.length > 1}}">
    <scroll-view scroll-x class="ds-scroll" enhanced show-scrollbar="{{false}}">
      <view class="ds-row">
        <view class="ds-chip {{dsActive === item.i ? 'on' : ''}}" wx:for="{{topDays}}" wx:key="i"
              data-i="{{item.i}}" bindtap="onJumpDay">
          <text class="ds-n">D{{item.n}}</text>
          <text class="ds-seg" wx:if="{{item.seg}}">{{item.seg}}</text>
          <text class="ds-th" wx:else>{{item.theme}}</text>
          <text class="ds-now" wx:if="{{item.today}}">今</text>
        </view>
      </view>
    </scroll-view>
  </view>

  <!-- v1.8.4 B17：这座城的经验（你上次来写的 / 结束时打分留话） -->
  <view class="card cnote-card" wx:if="{{!segs.length && !isProv}}">
    <view class="h3 row-between" bindtap="onCnToggle">
      <view class="h3-l"><image class="ic" src="/images/icons/star.png"/>这座城的经验</view>
      <text class="guide-toggle">{{cnToggleTx}}</text>
    </view>
    <view wx:if="{{cityNote && !cnOpen}}" class="cn-read">
      <view class="cn-stars">评分
        <text class="cn-s on" wx:for="{{[1,2,3,4,5]}}" wx:key="*this">{{cityNote.score >= item ? '★' : '☆'}}</text>
        <text class="cn-del" catchtap="onCnDel">删除</text>
      </view>
      <view class="cn-tips" wx:if="{{cityNote.tips.length}}">
        <view class="cn-tip" wx:for="{{cityNote.tips}}" wx:key="*this">· {{item}}</view>
      </view>
    </view>
    <view wx:if="{{cnOpen}}" class="cn-edit">
      <view class="cn-stars">这次给几分？
        <text class="cn-s {{cnScore >= item ? 'on' : ''}}" wx:for="{{[1,2,3,4,5]}}" wx:key="*this" data-s="{{item}}" bindtap="onCnScore">{{cnScore >= item ? '★' : '☆'}}</text>
      </view>
      <textarea class="cn-ta" placeholder="写点避坑小贴士，下次再来这座城市会提醒你（每行一条）" value="{{cnTips}}" bindinput="onCnTips" maxlength="300"/>
      <view class="cn-save" bindtap="onCnSave">保存经验</view>
    </view>
    <view wx:if="{{!cityNote && !cnOpen}}" class="dim cn-hint">回来后给这座城打分、记两句</view>
  </view>

  <!-- 城市速览（最佳季节 / 建议天数 / 气候 / 必吃 / 住宿交通） -->
  <view class="card brief-card" wx:if="{{brief}}">
    <view class="h3 row-between" bindtap="toggleBrief">
      <view class="h3-l"><image class="ic" src="/images/icons/city.png"/>{{brief.name}} 速览</view>
      <text class="guide-toggle">{{briefOpen ? '收起 ▴' : '展开 ▾'}}</text>
    </view>
    <view class="bf-meta">
      <view class="bf-m"><image class="ic ic-sm" src="/images/icons/calendar2.png"/>建议 {{brief.days}} 天</view>
      <view class="bf-m"><image class="ic ic-sm" src="/images/icons/sun.png"/>{{brief.climateTxt}}</view>
      <view class="bf-m"><image class="ic ic-sm" src="/images/icons/wallet.png"/>{{brief.costTxt}}</view>
    </view>
    <view class="bf-best"><image class="ic ic-sm" src="/images/icons/target.png"/>最佳季节 · {{brief.best}}</view>
    <view class="bf-body" wx:if="{{briefOpen}}">
      <view class="bf-sec" wx:if="{{brief.foods.length}}">
        <view class="bf-t"><image class="ic ic-sm" src="/images/icons/food.png"/>必吃</view>
        <view class="chips"><text class="chip" wx:for="{{brief.foods}}" wx:key="*this">{{item}}</text></view>
      </view>
      <view class="bf-sec" wx:if="{{brief.areas.length}}">
        <view class="bf-t"><image class="ic ic-sm" src="/images/icons/home.png"/>住哪儿</view>
        <view class="bf-area" wx:for="{{brief.areas}}" wx:key="name">
          <text class="bf-an">{{item.name}}</text><text class="bf-ax dim">{{item.note}}</text>
          <text class="bf-ap" wx:if="{{item.price}}">参考价 · {{item.price}}</text>
        </view>
      </view>
      <view class="bf-sec" wx:if="{{brief.stayTip}}">
        <view class="bf-t"><image class="ic ic-sm" src="/images/icons/home.png"/>住宿建议</view>
        <view class="bf-x">{{brief.stayTip}}</view>
      </view>
      <view class="bf-sec" wx:if="{{hotelPortals.length}}">
        <view class="bf-t"><image class="ic ic-sm" src="/images/icons/home.png"/>酒店门户（点按复制搜索词）</view>
        <view class="chips"><text class="chip portal" wx:for="{{hotelPortals}}" wx:key="platform" data-term="{{item.term}}" data-platform="{{item.platform}}" catchtap="copyPortal">{{item.platform}}</text></view>
      </view>
      <view class="bf-sec" wx:if="{{brief.travel}}">
        <view class="bf-t"><image class="ic ic-sm" src="/images/icons/route.png"/>市内交通</view>
        <view class="bf-x">{{brief.travel}}</view>
      </view>
    </view>
  </view>

  <!-- 行程天气（和风天气 QWeather 实时） -->
  <!-- C2：拉取失败时显式提示（可点 ✕ 关闭，换行程后重新提示） -->
  <view class="wx-off" wx:if="{{wxOff}}">
    <image class="ic ic-sm" src="/images/icons/cloud.png"/>
    <view class="wx-off-t">
      <view class="wx-off-h">{{wxErrType === 'no_key' ? '天气服务未启用' : (wxErrType === 'window' ? '暂无可用预报' : '天气暂不可用')}}</view>
      <view class="wx-off-d dim">{{wxErrMsg || '离线或超预报期 · 其他功能不受影响'}}</view>
    </view>
    <view class="wx-off-acts">
      <view class="wx-retry" wx:if="{{wxErrRetry}}" catchtap="onWxRetry">重试</view>
      <view class="wx-close" catchtap="closeWxOff">✕</view>
    </view>
  </view>
  <view class="tip" wx:if="{{wxLoading}}">天气加载中…</view>
  <view class="card wx-card" wx:if="{{wxShow}}">
    <view class="wx-head" bindtap="toggleWx">
      <text class="wx-h wx-h-row"><image class="ic" src="/images/icons/sun.png"/>行程天气</text>
      <view class="wx-head-r">
        <text class="wx-m dim">{{wxIsMulti ? '多站 · 各站按所在城市预报' : '和风天气实时预报'}}</text>
        <text class="guide-toggle">{{wxOpen ? '收起 ▴' : '展开 ▾'}}</text>
      </view>
    </view>
    <scroll-view wx:if="{{wxOpen}}" scroll-x class="wx-scroll" show-scrollbar="{{false}}">
      <view class="wx-days">
        <view class="wx-day {{d.risk ? 'risk' : ''}}" wx:for="{{wxList}}" wx:key="date">
          <view class="wxd-date">{{d.dateText}}{{d.isToday ? ' · 今' : ''}}<text wx:if="{{wxIsMulti && d.cityTx}}" class="wxd-city"> · {{d.cityTx}}</text></view>
          <view class="wxd-main"><text class="wxd-desc">{{d.desc}}</text></view>
          <view class="wxd-temp">
            <text class="tmax">{{d.tmaxTx}}</text><text class="tmin">{{d.tminTx}}</text>
            <text wx:if="{{d.feels != null}}" class="wxd-feels">体感{{d.feels}}°</text>
          </view>
           <!-- v1.11 UI 减法：湿度/UV/风 + 日出日落 合并为一行（JS 预计算 metaLine） -->
           <view wx:if="{{d.metaLine}}" class="wxd-meta">{{d.metaLine}}</view>
           <view class="wxd-risk {{d.risk ? 'r-bad' : 'r-ok'}}">
             <image class="ic ic-sm" src="/images/icons/{{d.riskIcon}}.png"/>
             <text>{{d.riskTx}}</text>
           </view>
           <!-- 出行指数：带伞 / 防晒 / 保暖（block 不产生节点，比 view wx:for 少一层语义） -->
           <view class="wxd-idx">
             <block wx:for="{{d.idx}}" wx:for-item="ix2" wx:key="t">
               <view class="idx-chip">
                 <image class="ic ic-sm" src="/images/icons/{{ix2.icon}}.png"/>{{ix2.t}}
               </view>
             </block>
           </view>
        </view>
      </view>
    </scroll-view>
  </view>

  <!-- 雨雪天备选：目的地有雨/雪时，推荐室内或雨/雪景友好的景点（离线，不依赖天气请求） -->
  <view class="card rainy-card" wx:if="{{rainyShow}}">
    <view class="h3 rainy-hd"><image class="ic" src="/images/icons/umbrella.png"/>雨雪天备选</view>
    <view class="rainy-sub dim">{{rainyKindsTx}} · 这些景点受天气影响小，或在雨/雪中更有味道</view>
    <view class="rainy-list">
      <view class="rainy-item" wx:for="{{rainySpots}}" wx:key="name">
        <text class="rainy-n">{{item.name}}</text>
        <text class="rainy-r chip">{{item.reason}}</text>
      </view>
    </view>
  </view>

  <!-- 行程体检：排得太满 / 需预约未订 / 无留白 / 转场日 等提醒（无问题项时整体收起） -->
  <view class="card check-card" wx:if="{{tripCheck.items.length}}">
    <view class="h3 row-between" bindtap="toggleCheck">
      <view class="h3-l"><image class="ic" src="/images/icons/shield.png"/>行程体检</view>
      <view class="ck-head-r">
        <view class="ck-slim" wx:if="{{tripCheck.needSlim}}" catchtap="onSlim">一键减负</view>
        <view class="ck-copy" catchtap="onHealthCopy">复制摘要</view>
        <text class="ck-lv {{tripCheck.level}}">{{tripCheck.lvTx}}</text>
        <text class="guide-toggle">{{checkOpen ? '收起 ▴' : '展开 ▾'}}</text>
      </view>
    </view>
    <block wx:if="{{checkOpen}}">
    <view class="ck-item" wx:for="{{tripCheck.items}}" wx:key="t">
      <view class="ck-dot {{item.lv}}"></view>
      <view class="ck-txt">
        <view class="ck-t">{{item.t}}</view>
        <view class="ck-x dim">{{item.x}}</view>
      </view>
    </view>
    </block>
  </view>

  <!-- 想玩清单：统计 + 未排上列表 + 两种重排（对齐网页 pickField/pickOnly） -->
  <view class="wish card" wx:if="{{wishAll > 0}}">
    <view class="wish-head" bindtap="toggleWish">
      <view class="wish-txt">
        <view class="wish-title wish-title-row"><image class="ic" src="/images/icons/star.png"/>想玩清单</view>
        <view class="wish-sub">共 {{wishAll}} 个 · 已安排 {{wishPlan.length}} 个<text wx:if="{{wishMiss.length}}"> · 未排上 {{wishMiss.length}} 个</text></view>
      </view>
      <view class="wish-head-r">
        <view class="wish-acts">
          <view class="w-btn ghost" data-only="0" catchtap="rebuild"><image class="ic" src="/images/icons/shuffle.png"/>想玩优先重排</view>
          <view class="w-btn" data-only="1" catchtap="rebuild"><image class="ic" src="/images/icons/target.png"/>只玩想玩</view>
        </view>
        <text class="guide-toggle">{{wishOpen ? '收起 ▴' : '展开 ▾'}}</text>
      </view>
    </view>
    <view class="wish-miss" wx:if="{{wishOpen && wishMiss.length}}">
      <view class="wm-tx">未排上的（✕ 移出后可重排）：</view>
      <view class="miss-chips">
        <view class="miss-chip" wx:for="{{wishMiss}}" wx:key="name">
          <text class="mc-n">{{item.name}}</text>
          <text class="mc-x" data-name="{{item.name}}" catchtap="removeWish">✕</text>
        </view>
      </view>
    </view>
    <view class="wish-done" wx:if="{{wishOpen && !wishMiss.length}}">✓ 想玩的都已安排进行程，可以直接出发了</view>
  </view>

  <!-- 每日行程 -->
  <block wx:for="{{view}}" wx:key="di" wx:for-index="di" wx:for-item="day">
    <!-- v1.19.77：仅首次进入行程页时错落入场；编辑/打卡重渲染不再重放，避免整页闪一下 -->
    <view class="day-card card {{day.anim}}" id="d{{di}}" style="{{day.ads}}">
      <!-- 头：金色编号 + 主题/日期 + 操作组（多站徽章/地图/复制当天） -->
      <view class="day-head">
        <view class="day-num">D{{di + 1}}</view>
        <view class="day-txt">
          <view class="day-title-row">
            <view class="day-theme">{{day.theme || '行程'}}</view>
            <view wx:if="{{segs.length && day.segName}}" class="seg-tag"><image class="ic ic-sm" src="/images/icons/pin.png"/>{{day.segName}}</view>
          </view>
          <view class="day-date dim">{{day.dateText}}<text wx:if="{{day.dayTag && day.dayTag !== '休整日' && day.dayTag !== '轻松日' && day.dayTag !== '均衡日'}}" class="day-tag">{{day.dayTag}}</text></view>
        </view>
        <view class="dh-ops">
          <view class="day-map" catchtap="jumpMap" data-di="{{di}}"><image class="ic ic-sm" src="/images/icons/map.png"/>地图</view>
          <view class="day-map day-copy" catchtap="onDayCopy" data-di="{{di}}"><image class="ic ic-sm" src="/images/icons/copy.png"/>当天</view>
        </view>
      </view>

      <view wx:if="{{day.meal}}" class="day-meal"><image class="ic" src="/images/icons/food.png"/>{{day.meal}}</view>

      <!-- v1.8.4 B12：单日卡点（参考停留合计 / 超时预警） -->
      <view wx:if="{{day.load && day.load.n > 0}}" class="day-load {{day.load.over > 0 ? 'load-over' : 'load-ok'}}">
        <image class="ic ic-sm" src="/images/icons/clock.png"/>
        <text class="dl-txt">{{day.load.txt}}</text>
      </view>

      <!-- 时间线（竖线 + 发光圆点，对齐网页版） -->
      <view class="tl">
        <!-- v1.19.77：dd{{di}} 供 createSelectorQuery 按天定位；dragSh[i] 为 JS 预计算的位移（WXML 零逻辑） -->
        <view class="tl-item dd{{di}} {{open === i + di * 100 ? 'open' : ''}}{{it.wished ? ' wish-hit' : ''}}{{dragOn && dragDi === di && dragI === i ? ' dragging' : ''}}"
              wx:for="{{day.items}}" wx:key="ix" wx:for-index="i" wx:for-item="it"
              style="{{dragOn && dragDi === di ? dragSh[i] : ''}}"
              data-di="{{di}}" data-ix="{{it.ix}}" bindtap="onToggle">
          <view class="tl-main">
            <view class="tl-top">
              <text class="tl-period {{it.f ? 'p-f' : ''}}">{{it.period}}</text>
              <text class="tl-name {{it.f ? 'n-f' : ''}}">{{it.disp || it.name}}</text>
              <text wx:if="{{!it.f && it.effort !== undefined}}" class="badge eff e{{it.effort}}">{{it.effortTx}}<text wx:if="{{it.hour}}" class="eff-sep"> · {{it.hour}}</text></text>
            </view>
            <view wx:if="{{it.note && !it.f}}" class="tl-note">{{it.note}}</view>
            <view wx:if="{{it.fnote && !it.f}}" class="tl-fnote">我评：{{it.fnote}}</view>
            <view wx:if="{{open === i + di * 100 && detailText}}" class="spot-detail">
              <view class="detail-acts">
                <text wx:if="{{!it.f}}" class="d-btn d-btn-main" data-di="{{di}}" data-ix="{{it.ix}}" catchtap="onSwap">换一个</text>
                <text wx:if="{{!it.f}}" class="d-btn d-btn-del" data-di="{{di}}" data-ix="{{it.ix}}" catchtap="onDelSpot">删掉</text>
                <text class="d-btn" data-di="{{di}}" data-ix="{{it.ix}}" catchtap="onBaike">百科</text>
                <text class="d-btn {{it.wished ? 'd-wish-on' : ''}}" data-di="{{di}}" data-ix="{{it.ix}}" catchtap="onWish">{{it.wished ? '已在想玩' : '加想玩'}}</text>
                <text wx:if="{{!it.f}}" class="d-btn {{it.visited ? 'd-visit-on' : ''}}" data-di="{{di}}" data-ix="{{it.ix}}" catchtap="onVisited">{{it.visited ? '已打卡' : '打卡'}}</text>
                <text wx:if="{{!it.f && it.visited}}" class="d-btn" data-di="{{di}}" data-ix="{{it.ix}}" catchtap="onFootNote">{{it.fnote ? '改评价' : '写评价'}}</text>
                <text wx:if="{{!it.f && i > 0}}" class="d-btn" data-di="{{di}}" data-ix="{{it.ix}}" data-dir="-1" catchtap="onMove">↑ 上移</text>
                <text wx:if="{{!it.f && i < day.items.length - 1}}" class="d-btn" data-di="{{di}}" data-ix="{{it.ix}}" data-dir="1" catchtap="onMove">↓ 下移</text>
              </view>
              <view class="sd-tags" wx:if="{{detailTags.length}}">
                <text class="sd-tag" wx:for="{{detailTags}}" wx:key="*this" data-di="{{di}}" data-ix="{{it.ix}}" data-tag="{{item}}" catchtap="onTagSwap">{{item}} · 换同类</text>
              </view>
              <view class="sd-timing" wx:if="{{timing}}">
                <image class="ic ic-sm" src="/images/icons/clock.png"/>
                <text class="sd-tm-b">最佳 {{timing.best}}</text>
                <text class="sd-tm-c">人流 {{timing.crowd}}</text>
              </view>
              <view class="sd-tip dim" wx:if="{{timing}}">{{timing.tip}}</view>
              <view class="sd-info" wx:if="{{showInfo}}">
                <image class="ic ic-sm" src="/images/icons/clock.png"/>
                <text class="sd-info-tx">{{infoTx}}</text>
              </view>
              <view class="sd-body">{{detailText}}</view>
              <view class="sd-how" wx:if="{{offlineHow}}">
                <text class="sd-how-l">怎么去</text>
                <text class="sd-how-tx">{{offlineHow}}</text>
              </view>
            </view>
          </view>
          <!-- 行尾只留最常用的「导航 / 移除」，其余操作收进展开面板，减少视觉噪音 -->
          <view class="tl-ops">
            <!-- v1.19.77：拖动排序手柄。刻意只挂在这颗小按钮上 —— 若把 catchtouchmove 挂到整个条目，
                 手指按在行程上就没法滑页面了。手柄很小、且本身没有点击语义，按住即拖。 -->
            <view wx:if="{{!it.f}}" class="op grip" data-di="{{di}}" data-i="{{i}}"
                  catchtouchstart="onDragStart" catchtouchmove="onDragMove"
                  catchtouchend="onDragEnd" catchtouchcancel="onDragEnd">
              <view class="grip-col"><view class="gd"></view><view class="gd"></view><view class="gd"></view></view>
              <view class="grip-col"><view class="gd"></view><view class="gd"></view><view class="gd"></view></view>
            </view>
            <view wx:if="{{!it.f}}" class="op {{it.wished ? 'wish-on' : ''}}" data-di="{{di}}" data-ix="{{it.ix}}" catchtap="onWish" title="想玩"><image class="op-ic" src="/images/icons/{{it.wished ? 'star-on' : 'star'}}.png"/></view>
            <view wx:if="{{!it.f}}" class="op" data-di="{{di}}" data-ix="{{it.ix}}" catchtap="onNav" title="导航"><image class="op-ic" src="/images/icons/compass.png"/></view>
            <view wx:if="{{!it.f}}" class="op del" data-di="{{di}}" data-ix="{{it.ix}}" catchtap="onDel" title="移除"><image class="op-ic" src="/images/icons/close.png"/></view>
          </view>
        </view>
      </view>

      <!-- v1.9：本日动线与步行量估算 -->
      <view class="mv-line dim" wx:if="{{day.mv && day.mv.legs > 0}}"><image class="ic ic-sm" src="/images/icons/route.png"/>动线约 {{day.mv.km}} km<text wx:if="{{day.mv.steps}}"> · 预计步行 {{day.mv.steps}} 步</text></view>

      <!-- 行尾：加个景点 / 怎么去 -->
      <view class="day-foot">
        <view class="df-btn df-add" data-di="{{di}}" catchtap="onDayAdd"><image class="ic ic-sm" src="/images/icons/plus.png"/>加个景点</view>
        <view class="df-btn {{routeOpen === di ? 'on' : ''}}" wx:if="{{day.route}}" data-di="{{di}}" catchtap="onRoute"><image class="ic ic-sm" src="/images/icons/bus.png"/>怎么去</view>
      </view>

      <!-- 交通建议（相邻点位怎么串） -->
      <view class="rt-box" wx:if="{{routeOpen === di && day.route}}">
        <view class="rt-sum"><image class="ic ic-sm" src="/images/icons/bus.png"/>{{day.route.text}}</view>
        <view class="rt-leg" wx:for="{{day.route.legs}}" wx:for-item="lg" wx:key="from">
          <view class="rt-l1">
            <text class="rt-a">{{lg.from}}</text>
            <text class="rt-ar">→</text>
            <text class="rt-b">{{lg.to}}</text>
          </view>
          <view class="rt-l2">
            <text class="rt-mode">{{lg.mode}}</text>
            <text class="rt-min">{{lg.minutes}} 分钟</text>
          </view>
          <view class="rt-tip dim">{{lg.tip}}</view>
        </view>
      </view>
    </view>
  </block>

  <!-- v1.19.78：城市深度玩法（内容随 subai 分包懒加载；未收录城市自动不显示） -->
  <view class="card dpp-card" wx:if="{{deep}}">
    <view class="dpp-head">
      <view class="dpp-t"><image class="ic" src="/images/icons/bulb.png"/>{{deep.city}} · 深度玩法</view>
      <text class="dpp-u dim">{{deep.updated}} 整理</text>
    </view>
    <view class="dpp-li" wx:for="{{deep.teasers}}" wx:key="*this"><text class="dpp-dot"></text>{{item}}</view>
    <view class="dpp-more" bindtap="onDeep">看全部 {{deep.total}} 条本地玩法 ›</view>
  </view>

  <view class="tip">点行展开可换景点/调序 · 按住右侧拖动</view>

  <!-- v1.19.76：分享长图离屏画布（不参与布局，仅用于生成分享图片） -->
  <canvas type="2d" id="shareCanvas" class="share-canvas"></canvas>
</view>
