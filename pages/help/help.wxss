/* help：旅途应急 —— 深色优先的"急救卡"观感
   配色全部走语义变量，浅色/深色主题都适配；字号经 calc(* var(--fs,1)) 跟随全局缩放 */
.page { padding-bottom: 60rpx; }

/* ── 120 主行动区 ── */
.eh-hero {
  margin: 22rpx 24rpx 0;
  padding: 30rpx 28rpx;
  border-radius: 28rpx;
  background: linear-gradient(160deg, rgba(204, 61, 61, .16), rgba(204, 61, 61, .06));
  border: 1rpx solid rgba(204, 61, 61, .34);
}
.eh-t {
  display: block;
  font-size: calc(34rpx * var(--fs, 1));
  font-weight: 900;
  color: var(--tx, #18233a);
  letter-spacing: 1rpx;
}
.eh-s {
  display: block;
  margin-top: 10rpx;
  font-size: calc(22rpx * var(--fs, 1));
  line-height: 1.6;
  color: var(--t2, #5b6b82);
}
.eh-call {
  margin-top: 22rpx;
  height: 140rpx;
  border-radius: 22rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 34rpx;
  box-sizing: border-box;
  background: var(--red, #cc3d3d);
  color: #fff;
}
.eh-call:active { opacity: .9; }
.eh-call-left { display: flex; flex-direction: column; gap: 8rpx; }
.eh-call-l {
  font-size: calc(26rpx * var(--fs, 1));
  font-weight: 700;
  letter-spacing: 3rpx;
  opacity: .92;
}
.eh-num {
  font-size: calc(74rpx * var(--fs, 1));
  font-weight: 900;
  letter-spacing: 6rpx;
  line-height: 1;
}
.eh-call-r {
  font-size: calc(28rpx * var(--fs, 1));
  font-weight: 800;
  opacity: .95;
}
.eh-others {
  margin-top: 18rpx;
  display: flex;
  gap: 16rpx;
}
.eh-o {
  flex: 1;
  height: 96rpx;
  border-radius: 16rpx;
  background: rgba(204, 61, 61, .10);
  border: 1rpx solid rgba(204, 61, 61, .28);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 5rpx;
}
.eh-o:active { background: rgba(204, 61, 61, .18); }
.eh-o-n {
  font-size: calc(36rpx * var(--fs, 1));
  font-weight: 900;
  color: var(--red, #cc3d3d);
  letter-spacing: 2rpx;
}
.eh-o-l {
  font-size: calc(20rpx * var(--fs, 1));
  color: var(--t2, #5b6b82);
}

/* ── 通用卡内标题 ── */
.er-h {
  font-size: calc(24rpx * var(--fs, 1));
  font-weight: 800;
  color: var(--gold-tx, #8f6a1f);
  letter-spacing: 1rpx;
  margin-bottom: 16rpx;
}

/* ── 分诊输入 ── */
.er-chips { display: flex; flex-wrap: wrap; gap: 12rpx; }
.er-chip {
  padding: 10rpx 20rpx;
  border-radius: 99rpx;
  background: var(--well, #ffffff);
  border: 1rpx solid rgba(var(--ln-rgb, 19, 29, 49), .16);
  font-size: calc(21rpx * var(--fs, 1));
  color: var(--t2, #5b6b82);
}
.er-chip:active { background: rgba(var(--ln-rgb, 19, 29, 49), .08); }

.er-input {
  margin-top: 18rpx;
  height: 76rpx;
  padding: 0 22rpx;
  box-sizing: border-box;
  border-radius: 16rpx;
  background: var(--well, #ffffff);
  border: 1rpx solid rgba(var(--ln-rgb, 19, 29, 49), .16);
  font-size: calc(24rpx * var(--fs, 1));
  color: var(--tx, #18233a);
}
.er-go {
  margin-top: 16rpx;
  height: 76rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(212, 169, 78, .16);
  border: 1rpx solid rgba(212, 169, 78, .45);
  color: var(--gold-tx, #8f6a1f);
  font-size: calc(25rpx * var(--fs, 1));
  font-weight: 800;
}
.er-go:active { background: rgba(212, 169, 78, .3); }

/* ── 科室结果 ── */
.er-item { padding: 18rpx 0; border-bottom: 1rpx solid rgba(var(--ln-rgb, 19, 29, 49), .1); }
.er-item:last-child { border-bottom: none; padding-bottom: 4rpx; }
.er-line { display: flex; align-items: center; flex-wrap: wrap; gap: 12rpx; }
.er-dept {
  font-size: calc(30rpx * var(--fs, 1));
  font-weight: 900;
  color: var(--tx, #18233a);
}
.er-badge {
  padding: 4rpx 14rpx;
  border-radius: 99rpx;
  font-size: calc(19rpx * var(--fs, 1));
  color: var(--t3, #64748b);
  background: rgba(var(--ln-rgb, 19, 29, 49), .08);
}
.er-er {
  color: #fff;
  background: var(--red, #cc3d3d);
  font-weight: 700;
}
.er-tip {
  margin-top: 10rpx;
  font-size: calc(22rpx * var(--fs, 1));
  line-height: 1.65;
  color: var(--t2, #5b6b82);
}

/* ── 医院列表 ── */
.er-hrow {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 20rpx 4rpx;
  border-bottom: 1rpx solid rgba(var(--ln-rgb, 19, 29, 49), .1);
}
.er-hrow:last-of-type { border-bottom: none; }
.er-hrow:active { background: rgba(var(--ln-rgb, 19, 29, 49), .05); }
.er-hl { flex: 1; min-width: 0; }
.er-hn {
  display: block;
  font-size: calc(26rpx * var(--fs, 1));
  font-weight: 800;
  color: var(--tx, #18233a);
  line-height: 1.4;
}
.er-hm {
  display: block;
  margin-top: 6rpx;
  font-size: calc(20rpx * var(--fs, 1));
  color: var(--t3, #64748b);
}
.er-nav {
  flex: none;
  font-size: calc(22rpx * var(--fs, 1));
  font-weight: 700;
  color: var(--gold-tx, #8f6a1f);
}
.er-pick {
  margin-top: 18rpx;
  text-align: center;
  font-size: calc(21rpx * var(--fs, 1));
  color: var(--t3, #64748b);
  padding: 12rpx 0;
}
.er-pick-only { padding: 26rpx 28rpx; }

/* ── 空态与免责 ── */
.er-nt {
  display: block;
  font-size: calc(25rpx * var(--fs, 1));
  font-weight: 700;
  color: var(--tx, #18233a);
}
.er-ns {
  display: block;
  margin-top: 8rpx;
  font-size: calc(21rpx * var(--fs, 1));
  line-height: 1.6;
  color: var(--t3, #64748b);
}
.er-disclaim {
  margin: 24rpx 36rpx 0;
  font-size: calc(19rpx * var(--fs, 1));
  line-height: 1.7;
  color: var(--t4, #7d92ab);
}

/* ── 降级态：地图搜索按钮（不列具名医院，给可执行动作） ── */
.er-mapbtn {
  margin-top: 20rpx;
  height: 84rpx;
  line-height: 84rpx;
  text-align: center;
  border-radius: 18rpx;
  font-size: calc(25rpx * var(--fs, 1));
  font-weight: 700;
  color: var(--gold-tx, #8f6a1f);
  background: var(--gold-bg, rgba(201, 162, 74, .12));
  border: 1rpx solid var(--gold-line, rgba(201, 162, 74, .42));
}
.er-mapbtn:active { opacity: .86; }

/* ── 城市选择弹层 ── */
.pk-mask {
  position: fixed;
  left: 0; right: 0; top: 0; bottom: 0;
  background: rgba(6, 10, 18, .5);
  z-index: 60;
  display: flex;
  align-items: flex-end;
}
.pk-panel {
  width: 100%;
  max-height: 76vh;
  display: flex;
  flex-direction: column;
  border-radius: 26rpx 26rpx 0 0;
  background: var(--card-bg, #fff);
  padding-bottom: env(safe-area-inset-bottom);
  box-sizing: border-box;
}
.pk-top {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 22rpx 24rpx;
  border-bottom: 1rpx solid var(--line, rgba(125, 146, 171, .18));
}
.pk-input {
  flex: 1;
  height: 68rpx;
  padding: 0 20rpx;
  border-radius: 14rpx;
  font-size: calc(25rpx * var(--fs, 1));
  color: var(--tx, #18233a);
  background: var(--input-bg, rgba(125, 146, 171, .1));
}
.pk-x {
  flex: none;
  font-size: calc(24rpx * var(--fs, 1));
  color: var(--t3, #64748b);
  padding: 8rpx 4rpx;
}
.pk-list { flex: 1; max-height: 62vh; }
.pk-item {
  display: flex;
  align-items: center;
  height: 84rpx;
  padding: 0 28rpx;
  border-bottom: 1rpx solid var(--line, rgba(125, 146, 171, .12));
}
.pk-item:active { background: rgba(125, 146, 171, .1); }
.pk-n {
  font-size: calc(26rpx * var(--fs, 1));
  color: var(--tx, #18233a);
}
.pk-tag {
  margin-left: 14rpx;
  font-size: calc(18rpx * var(--fs, 1));
  color: var(--t4, #7d92ab);
  border: 1rpx solid var(--line, rgba(125, 146, 171, .3));
  border-radius: 8rpx;
  padding: 2rpx 8rpx;
}
.pk-empty {
  padding: 44rpx 0;
  text-align: center;
  font-size: calc(23rpx * var(--fs, 1));
  color: var(--t4, #7d92ab);
}
