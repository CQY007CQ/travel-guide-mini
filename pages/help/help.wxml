<view class="page {{td ? 'td' : ''}} fz{{fz}}">

  <!-- 第一屏：120 优先。急症场景下"叫救护车"永远排在"查信息"之前 -->
  <view class="eh-hero">
    <text class="eh-t">旅途受伤 / 突发不适</text>
    <text class="eh-s">急危重症请先拨打 120，说清位置与伤情；不要先查攻略，也不要自己开车</text>
    <view class="eh-call" bindtap="onCall120">
      <view class="eh-call-left">
        <text class="eh-call-l">急救电话</text>
        <text class="eh-num">120</text>
      </view>
      <text class="eh-call-r">点击拨打 ›</text>
    </view>
    <view class="eh-others">
      <view class="eh-o" bindtap="onCallNum" data-num="110"><text class="eh-o-n">110</text><text class="eh-o-l">报警</text></view>
      <view class="eh-o" bindtap="onCallNum" data-num="119"><text class="eh-o-n">119</text><text class="eh-o-l">火警</text></view>
      <view class="eh-o" bindtap="onCallNum" data-num="122"><text class="eh-o-n">122</text><text class="eh-o-l">交通事故</text></view>
    </view>
  </view>

  <!-- 第二步：分诊 -->
  <view class="card er-card">
    <view class="er-h">第一步 · 是什么情况</view>
    <view class="er-chips">
      <view class="er-chip" wx:for="{{quick}}" wx:key="*this" data-t="{{item}}" bindtap="onQuick">{{item}}</view>
    </view>
    <input class="er-input" value="{{text}}" placeholder="也可以直接描述：腿摔了站不起来 / 开水烫到手"
           confirm-type="search" bindinput="onInput" bindconfirm="onAsk"/>
    <view class="er-go" bindtap="onAsk">看该挂什么科</view>
  </view>

  <!-- 结果：科室建议 -->
  <view class="card er-res" wx:if="{{res.length}}">
    <view class="er-h">第二步 · 该挂的科室</view>
    <view class="er-item" wx:for="{{res}}" wx:key="dept">
      <view class="er-line">
        <text class="er-dept">{{item.dept}}</text>
        <text class="er-badge {{item.er ? 'er-er' : ''}}">{{item.er ? '急症 · 尽快就医' : '非急症'}}</text>
      </view>
      <view class="er-tip">{{item.tip}}</view>
    </view>
  </view>

  <!-- 第三步：就近医院（仅展示已核验的具名医院） -->
  <view class="card er-hos" wx:if="{{city && hos.length}}">
    <view class="er-h">第三步 · 就近医院（{{city}}）</view>
    <view class="er-hrow" wx:for="{{hos}}" wx:key="n" data-i="{{index}}" bindtap="onNav">
      <view class="er-hl">
        <text class="er-hn">{{item.n}}</text>
        <text class="er-hm">{{item.lv}} · 距城中心约 {{item.kmc}} km</text>
      </view>
      <text class="er-nav">导航 ›</text>
    </view>
    <view class="er-pick" bindtap="onPickCity">切换城市</view>
  </view>

  <!-- 降级态：本城无已核验医院名单。不编造机构名，改为地图搜索 -->
  <view class="card er-none" wx:if="{{city && !hos.length}}">
    <text class="er-nt">{{city}} 暂无已核验的医院名单</text>
    <text class="er-ns">为避免给出并不存在的机构，这里不列具体医院名。请在地图中搜索「医院」或「急诊」，就近前往；急危重症直接拨打 120。</text>
    <view class="er-mapbtn" wx:if="{{apLat}}" bindtap="onMapSearch">在地图中搜索附近医院</view>
    <view class="er-pick" bindtap="onPickCity">切换城市</view>
  </view>

  <view class="card er-pick-only" wx:if="{{!city}}">
    <view class="er-pick" bindtap="onPickCity">选择城市</view>
  </view>

  <!-- 城市选择弹层：可搜索（451 城超出 showActionSheet 的 6 项上限） -->
  <view class="pk-mask" wx:if="{{pickOpen}}" bindtap="onPickClose">
    <view class="pk-panel" catchtap="noop">
      <view class="pk-top">
        <input class="pk-input" value="{{kw}}" placeholder="搜索城市名" focus="{{pickOpen}}" bindinput="onPickInput"/>
        <text class="pk-x" bindtap="onPickClose">关闭</text>
      </view>
      <scroll-view class="pk-list" scroll-y>
        <view class="pk-item" wx:for="{{cityList}}" wx:key="*this" data-c="{{item}}" bindtap="onPickTap">
          <text class="pk-n">{{item}}</text>
          <text class="pk-tag" wx:if="{{apSet[item]}}">仅位置</text>
        </view>
        <view class="pk-empty" wx:if="{{!cityList.length}}">没有匹配的城市</view>
      </scroll-view>
    </view>
  </view>

  <view class="er-disclaim">
    以上为分诊常识与医院位置，急危重症请直接拨打 120。
  </view>

  <!-- v1.19.186 · 离线数据来源 · 规模（从 more 页迁移：普通用户价值低，移至帮助页作为透明说明） -->
  <view class="card" wx:if="{{corpus}}">
    <view class="er-h">离线数据来源 · 规模</view>
    <view class="cp-head">{{corpus.headline}}</view>
    <view class="cp-grid">
      <view class="cp-n"><text class="cp-v">{{corpus.cities}}</text><text class="cp-l">真实城市</text></view>
      <view class="cp-n"><text class="cp-v">{{corpus.cityEntries}}</text><text class="cp-l">城市池条目</text></view>
      <view class="cp-n"><text class="cp-v">{{corpus.spots}}</text><text class="cp-l">景点</text></view>
      <view class="cp-n"><text class="cp-v">{{corpus.foods}}</text><text class="cp-l">有美食店城</text></view>
      <view class="cp-n"><text class="cp-v gold">{{corpus.hospitals}}</text><text class="cp-l">具名医院</text></view>
      <view class="cp-n"><text class="cp-v">{{corpus.approxCities}}</text><text class="cp-l">搜索降级城</text></view>
      <view class="cp-n"><text class="cp-v">{{corpus.provinces}}</text><text class="cp-l">省级区</text></view>
    </view>
    <view class="cp-tip dim">城市池 {{corpus.cityEntries}} 条 = {{corpus.cities}} 座不同城市 + {{corpus.aliasEntries}} 条全称别名（如「阿坝 / 阿坝藏族羌族自治州」指向同一地）。其中 {{corpus.foods}} 城有真实美食店、{{corpus.spotCities}} 城有景点坐标；未收录具体店铺或坐标的城市走城心降级，不编造店名与坐标。</view>
    <view class="cp-sec" wx:if="{{corpus.climate.length}}">
      <view class="cp-h">气候带分布</view>
      <view class="cp-row" wx:for="{{corpus.climate}}" wx:key="k">
        <view class="cp-lab">{{item.label}}<text class="cp-amt"> {{item.n}}</text></view>
        <view class="cp-bar"><view class="cp-fill" style="width:{{item.pct}}%"></view></view>
      </view>
    </view>
    <view class="cp-chips" wx:if="{{corpus.region.length}}">
      <text class="cp-chip" wx:for="{{corpus.region}}" wx:key="k">{{item.label}} {{item.n}}</text>
    </view>
    <view class="cp-tip dim">全部为随包下发的离线结构化数据，无需联网即可规划</view>
  </view>

  <!-- AI 多轮问答 -->
  <view class="card ai-card">
    <view class="ai-h">
      <image class="ic" src="/images/icons/sparkle.png"/>
      <text class="ai-t">AI 应急问答</text>
      <text class="ai-badge" wx:if="{{aiSource}}">AI 生成</text>
      <view class="ai-clear" bindtap="aiClear">清空</view>
    </view>
    <view class="ai-tip dim">带上当前行程上下文的多轮问答；不给诊疗结论，急症请拨 120。无网络时自动回落本地资料。</view>
    <view class="ai-row">
      <input class="ai-inp" placeholder="如：爬山崴脚了该先怎么处理？" value="{{aiQ}}"
             bindinput="onAIInput" bindconfirm="aiAsk" confirm-type="send"/>
      <view class="ai-btn {{aiLoading ? 'ai-busy' : ''}}" bindtap="aiAsk">{{aiLoading ? '思考中…' : '问'}}</view>
    </view>
    <view class="ai-ans" wx:if="{{aiAnswer}}">{{aiAnswer}}</view>
    <view class="ai-copy" wx:if="{{aiAnswer}}" bindtap="aiCopy">复制回答</view>
    <view class="ai-err" wx:if="{{aiErr}}">{{aiErr}}</view>
  </view>
  <!-- 全站 AI 入口：应急场景深链，自动带入具名医院 / 降级城真实口径 -->
  <ai-entry inline topic="help-emergency" label="问问 AI 应急分诊"/>
</view>
