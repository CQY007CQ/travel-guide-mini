/* 首页：高端化 + 减法
   三段玩法（城市/全省精华/多站）· 高级设置折叠 · 想玩池折叠 · 快捷回填合并一卡 */
.page { padding-bottom: 60rpx; }

/* ── 品牌头（无 slogan）── */
.head {
  position: relative;
  padding: 34rpx 44rpx 22rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.head::after {
  content: ""; position: absolute; left: 48rpx; right: 48rpx; bottom: 6rpx; height: 1rpx;
  background: linear-gradient(90deg, rgba(212,169,78,0), rgba(212,169,78,.55), rgba(212,169,78,0));
}

/* 使用指南入口（金色胶囊，悬在品牌头右） */
.head-guide {
  display: flex; align-items: center; gap: 6rpx;
  padding: 10rpx 20rpx; margin-bottom: 6rpx;
  border-radius: 99rpx;
  background: rgba(212, 169, 78, .14);
  border: 1rpx solid rgba(212, 169, 78, .4);
  color: var(--gold-tx, #8f6a1f);
  font-size: calc(22rpx * var(--fs, 1)); font-weight: 700;
}

.head-guide:active { background: rgba(212, 169, 78, .26); }

.head-guide .ic { width: 24rpx; height: 24rpx; margin-right: 4rpx; }

.logo {
  font-size: calc(40rpx * var(--fs, 1));
  font-weight: 900;
  letter-spacing: 3rpx;
  line-height: 1.3;
  background: linear-gradient(120deg, var(--gold, #d4a94e), #eed392 60%, var(--gold, #d4a94e));
  -webkit-background-clip: text;
  color: transparent;
  filter: drop-shadow(0 6rpx 16rpx rgba(212,169,78,.22));
}

/* ── 玩法三段切换 ── */
.seg {
  display: flex;
  background: rgba(var(--ln-rgb, 19, 29, 49), 0.07);
  border-radius: 20rpx;
  padding: 7rpx;
  margin-bottom: 6rpx;
}

.seg-it {
  flex: 1;
  text-align: center;
  padding: 18rpx 0;
  border-radius: 16rpx;
  font-size: calc(26rpx * var(--fs, 1));
  font-weight: 600;
  color: var(--t3, #8fa3bc);
  transition: all .18s ease;
}

.seg-it:active { opacity: .8; }

.seg-it.on {
  color: #171107;
  font-weight: 800;
  background: linear-gradient(135deg, #e6bb62, #d4a94e 55%, #c19337);
  box-shadow: 0 8rpx 20rpx rgba(212, 169, 78, .28);
}

/* 主卡微调 */
.card.hero { padding: 26rpx 28rpx 20rpx; }

/* 目的地行：精选星标 */
.gstar { color: var(--gold-tx, #d4a94e); font-size: calc(26rpx * var(--fs, 1)); }

/* ── 全省精华游卡片 ── */
.prov-banner {
  margin: 6rpx 0 4rpx;
  padding: 20rpx 24rpx;
  border-radius: 20rpx;
  background: linear-gradient(135deg, rgba(212, 169, 78, 0.16), rgba(212, 169, 78, 0.04) 62%);
  border: 1rpx solid rgba(212, 169, 78, 0.3);
  display: flex;
  flex-direction: column;
}

.prov-t { font-size: calc(26rpx * var(--fs, 1)); font-weight: 800; color: var(--gold-tx, #d4a94e); letter-spacing: 1rpx; }

.prov-s { font-size: calc(21rpx * var(--fs, 1)); color: var(--t3, #8fa3bc); margin-top: 8rpx; line-height: 1.65; }

/* ── 高级设置折叠 ── */
.adv-bar {
  display: flex;
  align-items: center;
  margin-top: 8rpx;
  padding: 22rpx 2rpx 6rpx;
  border-top: 1rpx dashed rgba(var(--ln-rgb, 148, 163, 184), .16);
}

/* v1.19 P0-1：发现灵感折叠栏（减负首屏，默认收起） */
.disc-bar {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-top: 8rpx;
  padding: 18rpx 2rpx 16rpx;
  border-top: 1rpx dashed rgba(var(--ln-rgb, 148, 163, 184), .16);
  cursor: pointer;
}
.disc-t {
  font-size: calc(24rpx * var(--fs, 1));
  font-weight: 800;
  color: var(--t2, #5b6b82);
  letter-spacing: 1rpx;
}
.disc-hint {
  flex: 1;
  min-width: 0;
  font-size: calc(21rpx * var(--fs, 1));
  color: var(--t4, #7d92ab);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.disc-che {
  font-size: calc(24rpx * var(--fs, 1));
  color: var(--t4, #7d92ab);
}

.adv-t {
  font-size: calc(24rpx * var(--fs, 1));
  font-weight: 800;
  color: var(--t2, #5b6b82);
  letter-spacing: 2rpx;
}

.adv-hint { font-size: calc(20rpx * var(--fs, 1)); color: var(--t4, #7d92ab); margin-left: 16rpx; flex: 1; }

.adv-che { font-size: calc(24rpx * var(--fs, 1)); color: var(--t4, #7d92ab); padding: 6rpx 0 6rpx 14rpx; }

.adv-ex {
  margin-top: 14rpx;
  text-align: center;
  font-size: calc(22rpx * var(--fs, 1));
  color: var(--t4, #7d92ab);
  padding: 12rpx 0;
}

.adv-ex:active { color: var(--gold-tx, #d4a94e); }

/* 收藏当前目的地（轻量小行） */
.fav-mini {
  margin-top: 16rpx;
  text-align: right;
  font-size: calc(22rpx * var(--fs, 1));
  color: var(--t4, #7d92ab);
  padding: 4rpx 2rpx 0;
}

.fav-mini:active { color: var(--gold-tx, #d4a94e); }

/* ── 想玩景点池（折叠卡） ── */
.pool-bar { display: flex; align-items: center; justify-content: space-between; }

.pool-l { flex: 1; min-width: 0; display: flex; flex-direction: column; }

.pool-t { font-size: calc(25rpx * var(--fs, 1)); font-weight: 800; color: var(--t2, #5b6b82); letter-spacing: 1rpx; }

.pool-s { font-size: calc(21rpx * var(--fs, 1)); color: var(--t4, #7d92ab); margin-top: 6rpx; }

.pool-r { display: flex; align-items: center; padding-left: 16rpx; }

.pool-r .arrow { font-size: calc(22rpx * var(--fs, 1)); }

.pk-sub { font-size: calc(21rpx * var(--fs, 1)); color: var(--t4, #7d92ab); line-height: 1.6; margin-top: 2rpx; }

.pk-search { margin-top: 16rpx; background: rgba(var(--ln-rgb, 19, 29, 49), .05); border-radius: 14rpx;
  padding: 14rpx 20rpx; font-size: calc(25rpx * var(--fs, 1)); color: var(--t1, #18233a); }

/* v1.15 想玩池按标签筛选 */
.pk-tagbar { display: flex; flex-wrap: wrap; gap: 12rpx; margin-top: 14rpx; }
.pk-tagchip { font-size: calc(21rpx * var(--fs, 1)); padding: 6rpx 18rpx; border-radius: 99rpx; color: var(--t3, #64748b);
  background: rgba(var(--ln-rgb, 19, 29, 49), .05); border: 1rpx solid rgba(var(--ln-rgb, 19, 29, 49), .10); }
.pk-tagchip.on { color: var(--gold-tx, #d4a94e); border-color: rgba(212, 169, 78, .5); background: rgba(212, 169, 78, .14); font-weight: 600; }

.pk-tools { display: flex; align-items: center; gap: 26rpx; margin-top: 14rpx; }

.pk-tool { font-size: calc(23rpx * var(--fs, 1)); color: var(--t3, #64748b); padding: 6rpx 22rpx; border-radius: 99rpx;
  background: rgba(var(--ln-rgb, 19, 29, 49), .06); }

.pk-tool:active { color: var(--gold-tx, #d4a94e); }

.pk-chips { display: flex; flex-wrap: wrap; gap: 12rpx; margin-top: 14rpx; max-height: 460rpx; overflow-y: auto; }

.pk-chip { padding: 10rpx 20rpx; border-radius: 99rpx; font-size: calc(23rpx * var(--fs, 1)); color: var(--t2, #5b6b82);
  background: rgba(var(--ln-rgb, 19, 29, 49), .05); border: 1rpx solid rgba(var(--ln-rgb, 19, 29, 49), .10); }

.pk-chip.on { background: rgba(212, 169, 78, .18); border-color: rgba(212, 169, 78, .5); color: var(--gold-tx, #8f6a1f); font-weight: 600; }

.pk-empty { width: 100%; text-align: center; color: var(--t4, #7d92ab); font-size: calc(24rpx * var(--fs, 1)); padding: 20rpx 0; }

.pk-only { display: flex; align-items: center; margin-top: 20rpx; padding-top: 18rpx;
  border-top: 1rpx solid rgba(var(--ln-rgb, 19, 29, 49), .08); }

/* ── 快捷回填（收藏 + 最近合并） ── */
.quick .q-head { display: flex; align-items: baseline; justify-content: space-between; margin-bottom: 6rpx; }

.q-title { font-size: calc(25rpx * var(--fs, 1)); font-weight: 800; color: var(--t2, #5b6b82); letter-spacing: 1rpx; }

.q-sub { font-size: calc(19rpx * var(--fs, 1)); color: var(--t4, #7d92ab); }

.q-sec { margin-top: 14rpx; }

.q-sec + .q-sec { margin-top: 18rpx; }

.q-lab { font-size: calc(21rpx * var(--fs, 1)); color: var(--t4, #7d92ab); margin-bottom: 10rpx; letter-spacing: 1rpx; }

/* v1.8：玩几天「－ 数字 ＋」步进（v1.8.1 移除快捷天数 chip，回归减法） */
.day-ctl { flex: 1; display: flex; align-items: center; justify-content: flex-end; }

.day-stepper .step-num { min-width: 96rpx; font-size: calc(30rpx * var(--fs, 1)); color: var(--gold-tx, #b8860b); }

.action-area { padding: 40rpx 40rpx 0; }

.note { text-align: center; color: var(--t4, #7d92ab); font-size: calc(20rpx * var(--fs, 1)); margin-top: 22rpx; line-height: 1.7; }

/* 自定义预算输入 */
.amt-inp { flex: 1; max-width: 260rpx; text-align: right; color: var(--gold-tx, #d4a94e); font-size: calc(28rpx * var(--fs, 1));
  background: rgba(var(--ln-rgb, 19, 29, 49), .05); border-radius: 12rpx; padding: 6rpx 16rpx; }

/* 人数 stepper */
.stepper { display: flex; align-items: center; gap: 22rpx; }

.step-btn { width: 56rpx; height: 56rpx; border-radius: 14rpx; display: flex; align-items: center; justify-content: center;
  background: rgba(var(--ln-rgb, 19, 29, 49), .05); border: 1rpx solid rgba(var(--ln-rgb, 19, 29, 49), .12); color: var(--t2, #5b6b82); font-size: calc(30rpx * var(--fs, 1)); }

.step-btn:active { background: rgba(212, 169, 78, .2); }

.step-num { font-size: calc(28rpx * var(--fs, 1)); color: var(--t1, #18233a); min-width: 90rpx; text-align: center; font-weight: 700; }

/* 名山过夜 */
.sw-col { flex: 1; }

.field-sub { display: block; font-size: calc(21rpx * var(--fs, 1)); color: var(--t4, #7d92ab); margin-top: 4rpx; }

/* 快捷 chips（收藏 / 最近共用） */
.recent-wrap { display: flex; flex-wrap: wrap; gap: 14rpx; }

.recent-chip { display: flex; align-items: center; gap: 10rpx; padding: 10rpx 8rpx 10rpx 20rpx;
  background: rgba(var(--ln-rgb, 19, 29, 49), .06); border: 1rpx solid rgba(var(--ln-rgb, 19, 29, 49), .10); border-radius: 99rpx; }

.recent-chip:active { background: rgba(212, 169, 78, .16); }

.rc-main { font-size: calc(23rpx * var(--fs, 1)); color: var(--t2, #5b6b82); }

.rc-x { width: 36rpx; height: 36rpx; border-radius: 50%; display: flex; align-items: center; justify-content: center;
  background: rgba(var(--ln-rgb, 19, 29, 49), .06); color: var(--t4, #7d92ab); font-size: calc(20rpx * var(--fs, 1)); }

.rc-x:active { background: rgba(229, 106, 106, .25); color: var(--red, #cc3d3d); }

/* 多站路线 */
.multi-hint { font-size: calc(23rpx * var(--fs, 1)); color: var(--t3, #64748b); padding: 14rpx 0; text-align: center; }

.multi-list { display: flex; flex-direction: column; gap: 12rpx; padding: 6rpx 0; }

.multi-row { display: flex; align-items: center; gap: 14rpx; padding: 14rpx 16rpx;
  background: rgba(var(--ln-rgb, 19, 29, 49), .03); border: 1rpx solid rgba(var(--ln-rgb, 19, 29, 49), .12); border-radius: 16rpx; }

.mr-no { width: 42rpx; height: 42rpx; border-radius: 50%; display: flex; align-items: center; justify-content: center;
  background: linear-gradient(135deg, #e2b65c, #b8892f); color: #14100a; font-size: calc(22rpx * var(--fs, 1)); font-weight: 800; flex-shrink: 0; }

.mr-info { flex: 1; min-width: 0; display: flex; flex-direction: column; }

.mr-name { font-size: calc(26rpx * var(--fs, 1)); color: var(--t1, #18233a); font-weight: 600; }

.mr-guide { color: var(--gold-tx, #d4a94e); font-size: calc(22rpx * var(--fs, 1)); }

.mr-prov { font-size: calc(20rpx * var(--fs, 1)); color: var(--t3, #64748b); margin-top: 2rpx; }

.mr-step { display: flex; align-items: center; gap: 6rpx; flex-shrink: 0; }

.mr-step .step { width: 52rpx; height: 52rpx; border-radius: 50%; display: flex; align-items: center; justify-content: center;
  background: rgba(var(--ln-rgb, 19, 29, 49), .10); color: var(--t2, #5b6b82); font-size: calc(30rpx * var(--fs, 1)); }

.mr-step .step:active { background: rgba(212, 169, 78, .3); }

.days-num { min-width: 72rpx; text-align: center; font-size: calc(22rpx * var(--fs, 1)); color: var(--t2, #5b6b82); }

.mr-x { width: 38rpx; height: 38rpx; border-radius: 50%; display: flex; align-items: center; justify-content: center;
  background: rgba(229, 106, 106, .14); color: var(--red, #cc3d3d); font-size: calc(22rpx * var(--fs, 1)); flex-shrink: 0; }

.mr-x:active { background: rgba(229, 106, 106, .35); }

.multi-add { margin-top: 14rpx; padding: 16rpx 0; text-align: center; font-size: calc(25rpx * var(--fs, 1));
  color: var(--gold-tx, #8f6a1f); border: 1rpx dashed rgba(212, 169, 78, .55); border-radius: 14rpx; }

.multi-add:active { background: rgba(212, 169, 78, .16); }

.multi-add.dim { color: var(--t3, #64748b); border-color: rgba(var(--ln-rgb, 19, 29, 49), .2); }

/* 城市搜索选择器弹层 */
.mask { position: fixed; left: 0; top: 0; right: 0; bottom: 0; background: rgba(5, 8, 16, .5); z-index: 99;
  display: flex; align-items: flex-end; }

.picker-sheet { position: relative; width: 100%; background: linear-gradient(180deg, var(--panel, #ffffff), var(--card, #ffffff));
  border-radius: 36rpx 36rpx 0 0; padding: 30rpx 32rpx 40rpx; box-sizing: border-box;
  max-height: 78vh; display: flex; flex-direction: column;
  box-shadow: 0 -20rpx 60rpx rgba(3, 7, 18, .18); }

.picker-sheet::before { content: ""; position: absolute; top: 14rpx; left: 50%; transform: translateX(-50%);
  width: 72rpx; height: 8rpx; border-radius: 8rpx; background: rgba(var(--ln-rgb, 19, 29, 49), .18); }

.ps-head { display: flex; align-items: center; justify-content: space-between; margin: 6rpx 0 18rpx; }

.ps-title { font-size: calc(30rpx * var(--fs, 1)); font-weight: 800; color: var(--t1, #18233a); }

.ps-close { width: 52rpx; height: 52rpx; border-radius: 50%; background: rgba(var(--ln-rgb, 19, 29, 49), .06);
  display: flex; align-items: center; justify-content: center; color: var(--t3, #64748b); }

.ps-provs { display: flex; gap: 10rpx; margin: 0 0 16rpx; white-space: nowrap; padding: 2rpx 2rpx 4rpx; }

.ps-p { display: inline-flex; padding: 14rpx 26rpx; border-radius: 999rpx; font-size: calc(23rpx * var(--fs, 1)); color: var(--t2, #c3cfe0);
  background: rgba(var(--ln-rgb, 19, 29, 49), .05); border: 1rpx solid rgba(var(--ln-rgb, 19, 29, 49), .08); flex-shrink: 0; }

.ps-p.on { color: var(--on-gold, #fff); background: linear-gradient(135deg, #e6c065, #d4a94e); border-color: transparent; font-weight: 600; }

.ps-search { background: rgba(var(--ln-rgb, 19, 29, 49), .05); border: 1rpx solid rgba(var(--ln-rgb, 19, 29, 49), .12); border-radius: 16rpx;
  padding: 16rpx 22rpx; font-size: calc(27rpx * var(--fs, 1)); color: var(--t1, #18233a); }

.ps-list { margin-top: 18rpx; max-height: 54vh; }

.ps-item { display: flex; align-items: center; justify-content: space-between;
  padding: 26rpx 14rpx; border-bottom: 1rpx solid rgba(var(--ln-rgb, 19, 29, 49), .05); border-radius: 12rpx; }

.ps-item:active { background: rgba(var(--ln-rgb, 19, 29, 49), .05); }

.ps-item.guide .ps-name { color: var(--gold-tx, #8f6a1f); }

.ps-item.all { background: linear-gradient(90deg, rgba(212, 169, 78, .10), transparent 70%); }

.ps-item.all .ps-name { color: var(--gold-tx, #8f6a1f); font-weight: 700; }

.ps-item.all .ps-sub { color: var(--gold-tx, #8f6a1f); font-size: calc(19rpx * var(--fs, 1)); }

.ps-item.guide .ps-sub { color: var(--t3, #64748b); }

.ps-name { font-size: calc(28rpx * var(--fs, 1)); color: var(--t1, #18233a); }

.ps-sub { font-size: calc(21rpx * var(--fs, 1)); color: var(--t4, #7d92ab); }

/* 有限数据层城市：选择器中标「内容收集中」徽标（诚实降级，不假装已有攻略） */
.ps-item.limited .ps-name { color: var(--t1, #18233a); }
.ps-badge { flex: none; margin-left: 14rpx; padding: 4rpx 14rpx; border-radius: 999rpx;
  font-size: calc(19rpx * var(--fs, 1)); line-height: 1.4; color: var(--gold-tx, #8f6a1f);
  background: rgba(212, 169, 78, .12); border: 1rpx solid rgba(212, 169, 78, .35); }

.ps-empty { text-align: center; color: var(--t4, #7d92ab); padding: 60rpx 0; font-size: calc(25rpx * var(--fs, 1)); }

/* ===== 行程状态：出发倒计时 + 预约提醒 合并一卡（v1.19.59） ===== */
.plan-status { padding: 6rpx 28rpx; overflow: hidden; }
.plan-status .ps-row { display: flex; align-items: center; gap: 12rpx; padding: 16rpx 0; }
.plan-status .ps-row + .ps-row { border-top: 1rpx solid rgba(var(--ln-rgb, 19, 29, 49), .08); }
.plan-status .ic { width: 40rpx; height: 40rpx; flex-shrink: 0; opacity: .85; }
.plan-status .ps-row .arrow { margin-left: auto; }

.cd-mini-big { font-size: calc(40rpx * var(--fs, 1)); font-weight: 800; color: var(--gold-tx, #d4a94e); line-height: 1; }

.cd-mini-big.after { color: var(--t3, #8fa3bc); }

.cd-mini-big.during { font-size: calc(32rpx * var(--fs, 1)); }

.cd-mini-u { font-size: calc(21rpx * var(--fs, 1)); font-weight: 600; color: var(--t2, #c3cfe0); margin-left: -4rpx; }

.cd-mini-s { flex: 1; font-size: calc(23rpx * var(--fs, 1)); color: var(--t2, #c3cfe0); margin-left: 8rpx; }

/* ===== v1.7 · 快捷入口 ===== */
.quick-bar {
  display: flex; flex-direction: column; gap: 10rpx;
  padding: 20rpx 22rpx !important;
}
.qb-head { display: flex; align-items: center; justify-content: space-between; width: 100%; }
.qb-h-t { font-size: calc(24rpx * var(--fs, 1)); font-weight: 700; color: var(--t1, #eaeff7); }
.qb-h-c { font-size: calc(21rpx * var(--fs, 1)); color: var(--t4, #5b6b82); display: flex; align-items: center; }
.qb-grid { display: flex; flex-wrap: wrap; gap: 10rpx; width: 100%; }

.qb-item {
  display: flex; align-items: center; gap: 8rpx;
  font-size: calc(21rpx * var(--fs, 1)); color: var(--t2, #c3cfe0);
  background: rgba(var(--ln-rgb, 148, 163, 184), .08);
  border: 1rpx solid rgba(var(--ln-rgb, 148, 163, 184), .13);
  border-radius: 99rpx; padding: 12rpx 22rpx;
}

.qb-ic { width: 28rpx; height: 28rpx; }

.qb-t { font-size: calc(21rpx * var(--fs, 1)); }

/* v1.8.4 A8 盲盒（B18 预约提醒已并入 plan-status） */

.rm-main { flex: 1; display: flex; flex-direction: column; gap: 4rpx; min-width: 0; }

.rm-t { font-size: calc(26rpx * var(--fs, 1)); font-weight: 700; color: #b3541e; }

.rm-s { font-size: calc(22rpx * var(--fs, 1)); color: var(--dim, #5b6b82); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }

.blind-row { display: flex; align-items: center; gap: 10rpx; padding: 14rpx 4rpx 4rpx; color: var(--acc, #b3872e); font-size: calc(25rpx * var(--fs, 1)); }

.blind-sheet { padding-bottom: 26rpx; }

.blind-note { font-size: calc(23rpx * var(--fs, 1)); color: var(--dim, #5b6b82); margin: -4rpx 0 16rpx; }

.blind-list { display: flex; flex-direction: column; gap: 14rpx; }

.blind-card { border: 1rpx solid rgba(var(--ln-rgb, 100,116,139), .16); border-radius: 20rpx; padding: 20rpx 24rpx; background: rgba(var(--ln-rgb, 100,116,139), .05); }

.blind-card:active { background: rgba(212,169,78,.12); }

.bc-top { display: flex; align-items: center; gap: 14rpx; }

.bc-no { font-size: calc(22rpx * var(--fs, 1)); color: var(--on-gold, #fff); background: var(--acc, #b3872e); border-radius: 12rpx; padding: 2rpx 12rpx; font-weight: 700; }

.bc-name { font-size: calc(32rpx * var(--fs, 1)); font-weight: 800; }

.bc-prov { font-size: calc(22rpx * var(--fs, 1)); margin-left: auto; }

.bc-why { font-size: calc(24rpx * var(--fs, 1)); color: var(--tx-2, #46536b); margin: 10rpx 0 12rpx; line-height: 1.5; }

.bc-meta { display: flex; gap: 18rpx; align-items: center; }

.bc-days { font-size: calc(22rpx * var(--fs, 1)); color: var(--acc, #b3872e); font-weight: 600; }

.bc-best { font-size: calc(21rpx * var(--fs, 1)); color: var(--dim, #5b6b82); }

.blind-refresh { margin-top: 18rpx; text-align: center; font-size: calc(26rpx * var(--fs, 1)); color: var(--acc, #b3872e); padding: 10rpx; }

/* v1.9.0：假期提醒 / 同省顺路 */
.holi-line { display: flex; align-items: center; gap: 8rpx; font-size: calc(21rpx * var(--fs, 1)); color: var(--tx-2, #46536b); margin: 4rpx 34rpx 10rpx; line-height: 1.5; }

.holi-line.holi-big { color: #a0402b; background: rgba(194,69,46,.07); border-radius: 12rpx; padding: 10rpx 14rpx; margin: 0 30rpx 12rpx; }

.sib-row { display: flex; flex-wrap: wrap; align-items: center; gap: 10rpx; margin: 4rpx 30rpx 16rpx; }

.sib-l { font-size: calc(20rpx * var(--fs, 1)); color: var(--tx-3, #64748b); }

.sib-chip { display: flex; align-items: center; gap: 6rpx; font-size: calc(21rpx * var(--fs, 1)); color: var(--tx-2, #46536b); background: rgba(var(--ln-rgb,100,116,139),.08); border-radius: 20rpx; padding: 5rpx 16rpx; }

.sib-d { font-size: calc(18rpx * var(--fs, 1)); opacity: .65; }

.pk-line { display: flex; align-items: center; gap: 8rpx; font-size: calc(21rpx * var(--fs, 1)); color: var(--tx-2, #46536b); margin: 0 34rpx 16rpx; line-height: 1.5; }

/* ═══ v1.19.2 新增：天数快捷预设 / 池子搜索行 / 截断提示 ═══ */
.day-preset { display: flex; align-items: center; flex-wrap: wrap; gap: 10rpx; margin: 4rpx 0 10rpx; }
.day-preset .dp-t { font-size: calc(22rpx * var(--fs, 1)); color: var(--tx-3, #64748b); margin-right: 2rpx; }
.day-preset .dp-chip { font-size: calc(23rpx * var(--fs, 1)); padding: 6rpx 20rpx; border-radius: 22rpx; color: var(--tx-2, #46536b); background: rgba(var(--ln-rgb, 100, 116, 139), .08); border: 1rpx solid transparent; }
.day-preset .dp-chip.on { color: var(--chip-tx, #14100a); background: var(--gold, #d4a94e); font-weight: 700; }
.day-preset .dp-hint { font-size: calc(20rpx * var(--fs, 1)); color: var(--tx-3, #64748b); margin-left: auto; }
.pk-search-row { display: flex; align-items: center; gap: 12rpx; }
.pk-search-row .pk-search { flex: 1; }
.pk-search-row .pk-clear { font-size: calc(22rpx * var(--fs, 1)); color: var(--gold-tx, #8f6a1f); padding: 8rpx 14rpx; flex-shrink: 0; }
.pk-more { font-size: calc(21rpx * var(--fs, 1)); padding: 10rpx 4rpx 0; }

/* ═══ v1.19.x · 首次进入「使用指南」引导浮层 ═══ */
.gm-mask {
  position: fixed; left: 0; top: 0; right: 0; bottom: 0;
  background: rgba(5, 8, 16, .52);
  z-index: 120;
  display: flex; align-items: center; justify-content: center;
  padding: 0 44rpx; box-sizing: border-box;
}
.gm-card {
  width: 100%; max-width: 620rpx;
  background: var(--card, #ffffff);
  border: 1rpx solid rgba(var(--ln-rgb, 19, 29, 49), .12);
  border-radius: 32rpx;
  padding: 40rpx 38rpx 34rpx;
  box-shadow: var(--card-shadow, 0 12rpx 36rpx rgba(3, 7, 18, .32)), var(--card-inset, inset 0 1rpx 0 rgba(255, 255, 255, .035));
  box-sizing: border-box;
  animation: gmIn .26s ease;
}
@keyframes gmIn { from { opacity: 0; transform: translateY(22rpx) scale(.965); } to { opacity: 1; transform: none; } }
.gm-head { display: flex; align-items: center; gap: 16rpx; }
.gm-ic { width: 58rpx; height: 58rpx; flex-shrink: 0; }
.gm-title { font-size: calc(33rpx * var(--fs, 1)); font-weight: 900; color: var(--t1, #18233a); letter-spacing: 1rpx; }
.gm-sub { display: block; font-size: calc(23rpx * var(--fs, 1)); color: var(--t3, #64748b); margin: 16rpx 2rpx 8rpx; line-height: 1.6; }
.gm-points { display: flex; flex-direction: column; gap: 22rpx; margin: 22rpx 2rpx 30rpx; }
.gm-p { display: flex; align-items: center; gap: 18rpx; }
.gm-pi {
  width: 64rpx; height: 64rpx; flex-shrink: 0; border-radius: 18rpx;
  display: flex; align-items: center; justify-content: center;
  background: rgba(212, 169, 78, .16);
}
.gm-pi-img { width: 36rpx; height: 36rpx; }
.gm-pt { display: flex; flex-direction: column; min-width: 0; }
.gm-pt-t { font-size: calc(27rpx * var(--fs, 1)); font-weight: 800; color: var(--t1, #18233a); }
.gm-pt-s { font-size: calc(21rpx * var(--fs, 1)); color: var(--t3, #64748b); margin-top: 5rpx; line-height: 1.55; }
.gm-actions { display: flex; gap: 18rpx; }
.gm-btn {
  flex: 1; height: 84rpx; line-height: 84rpx; text-align: center;
  border-radius: 20rpx; font-size: calc(27rpx * var(--fs, 1)); font-weight: 800; padding: 0; margin: 0;
}
.gm-btn::after { border: none; }
.gm-btn-ghost {
  color: var(--t2, #5b6b82);
  background: rgba(var(--ln-rgb, 19, 29, 49), .06);
  border: 1rpx solid rgba(var(--ln-rgb, 19, 29, 49), .14);
}
.gm-btn-ghost:active { background: rgba(var(--ln-rgb, 19, 29, 49), .12); }
.gm-btn-gold {
  color: var(--on-gold, #ffffff);
  background: linear-gradient(135deg, #e6bb62, #d4a94e 55%, #c19337);
  box-shadow: 0 10rpx 24rpx rgba(212, 169, 78, .28);
}
.gm-btn-gold:active { filter: brightness(.95); }

/* v1.19.58：行程草稿（保存 / 恢复首页配置） */
.action-row { display: flex; gap: 20rpx; align-items: stretch; }
.action-row .btn-primary { flex: 1; margin: 0; }
.btn-ghost {
  flex: 0 0 auto;
  padding: 26rpx 34rpx;
  border-radius: 22rpx;
  font-size: calc(32rpx * var(--fs, 1));
  font-weight: 800;
  line-height: 1.4;
  color: var(--t2, #5b6b82);
  background: rgba(var(--ln-rgb, 19, 29, 49), .06);
  border: 1rpx solid rgba(var(--ln-rgb, 19, 29, 49), .14);
}
.btn-ghost::after { border: none; }
.btn-ghost:active { background: rgba(var(--ln-rgb, 19, 29, 49), .12); }
.draft-link {
  display: flex; align-items: center; justify-content: center; gap: 8rpx;
  margin-top: 22rpx; color: var(--t3, #64748b);
  font-size: calc(24rpx * var(--fs, 1)); font-weight: 700;
}
.draft-link .ic { width: 28rpx; height: 28rpx; opacity: .82; }
.draft-sheet { max-height: 76vh; display: flex; flex-direction: column; }
.draft-empty { padding: 64rpx 40rpx; text-align: center; color: var(--t3, #64748b); font-size: calc(24rpx * var(--fs, 1)); line-height: 1.7; }
.draft-list { max-height: 60vh; }
.draft-item {
  display: flex; align-items: center; justify-content: space-between;
  padding: 26rpx 30rpx; border-bottom: 1rpx solid rgba(var(--ln-rgb, 19, 29, 49), .08);
}
.di-main { display: flex; flex-direction: column; min-width: 0; }
.di-name { color: var(--t1, #18233a); font-size: calc(27rpx * var(--fs, 1)); font-weight: 800; }
.di-time { color: var(--t4, #7d92ab); font-size: calc(21rpx * var(--fs, 1)); margin-top: 6rpx; }
.di-ops { display: flex; align-items: center; gap: 22rpx; }
.di-apply {
  color: var(--on-gold, #fff);
  background: linear-gradient(135deg, #e6bb62, #d4a94e 55%, #c19337);
  font-size: calc(23rpx * var(--fs, 1)); font-weight: 800;
  padding: 10rpx 26rpx; border-radius: 14rpx;
}
.di-apply:active { filter: brightness(.95); }
.di-x { color: var(--t4, #7d92ab); font-size: calc(30rpx * var(--fs, 1)); padding: 6rpx 10rpx; }

/* v1.19.60：数据加载失败兜底卡片（避免空白死页被误判白屏） */
.data-fail {
  display: flex; align-items: center; gap: 20rpx;
  padding: 26rpx 30rpx;
  border: 1rpx solid rgba(204, 61, 61, .35);
  background: rgba(204, 61, 61, .07);
}
.df-badge {
  flex: 0 0 auto; width: 52rpx; height: 52rpx; border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
  background: var(--red, #cc3d3d); color: #fff;
  font-size: calc(34rpx * var(--fs, 1)); font-weight: 900;
}
.df-main { flex: 1 1 auto; min-width: 0; display: flex; flex-direction: column; }
.df-t { color: var(--tx, #18233a); font-size: calc(27rpx * var(--fs, 1)); font-weight: 800; }
.df-s { color: var(--dim, #5b6b82); font-size: calc(22rpx * var(--fs, 1)); margin-top: 4rpx; line-height: 1.5; }
.df-btn {
  flex: 0 0 auto; padding: 16rpx 30rpx; border-radius: 14rpx;
  background: linear-gradient(135deg, #e6bb62, #d4a94e 55%, #c19337);
  color: #fff; font-size: calc(25rpx * var(--fs, 1)); font-weight: 800;
}
.df-btn:active { filter: brightness(.95); }
.df-btn.df-loading { opacity: .6; }

/* ═══ v1.19.77 · 模板路线（热门城市一键套用） ═══ */
.tpl-row { margin: 10rpx 0 4rpx; }
.tpl-hd { display: flex; align-items: baseline; gap: 12rpx; padding: 0 2rpx 12rpx; }
.tpl-t { font-size: calc(24rpx * var(--fs, 1)); font-weight: 800; color: var(--t2, #5b6b82); letter-spacing: 1rpx; }
.tpl-s { flex: 1; min-width: 0; font-size: calc(21rpx * var(--fs, 1)); color: var(--t4, #7d92ab); overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
.tpl-scroll { width: 100%; white-space: nowrap; }
.tpl-card {
  display: inline-flex; flex-direction: column; align-items: flex-start; justify-content: center;
  gap: 4rpx; min-width: 148rpx; height: 104rpx; padding: 0 22rpx; margin-right: 12rpx;
  border-radius: 20rpx; box-sizing: border-box;
  background: rgba(var(--ln-rgb, 100, 116, 139), .07);
  border: 1rpx solid rgba(var(--ln-rgb, 100, 116, 139), .16);
  transition: transform .18s ease, background .18s ease, border-color .18s ease;
}
.tpl-card:active { transform: scale(.96); }
.tpl-card.on {
  background: linear-gradient(135deg, rgba(230, 187, 98, .22), rgba(212, 169, 78, .12));
  border-color: rgba(212, 169, 78, .55);
}
.tpl-city { font-size: calc(27rpx * var(--fs, 1)); font-weight: 800; color: var(--tx, #18233a); letter-spacing: .5rpx; }
.tpl-card.on .tpl-city { color: var(--gold-tx, #8f6a1f); }
.tpl-meta { font-size: calc(19rpx * var(--fs, 1)); color: var(--dim, #5b6b82); }
