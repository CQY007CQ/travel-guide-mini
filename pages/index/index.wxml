<view class="page {{td ? 'td' : ''}} fz{{fz}}">

  <!-- 品牌头（减法：去 slogan，只留名称 + 右侧使用指南入口） -->
  <view class="head">
    <text class="logo">旅行攻略生成器</text>
    <view class="head-guide" bindtap="goGuide">
      <image class="ic ic-sm" src="/images/icons/book.png"/><text>使用指南</text>
    </view>
  </view>

  <!-- v1.19.60：城市数据分包加载失败兜底 —— 展示重试卡片，避免空白死页被误判白屏 -->
  <view class="card data-fail" wx:if="{{dataFailed}}">
    <view class="df-badge">!</view>
    <view class="df-main">
      <text class="df-t">城市数据加载失败</text>
      <text class="df-s">网络不稳，点下方重试</text>
    </view>
    <view class="df-btn {{loadingData ? 'df-loading' : ''}}" bindtap="retryData">{{loadingData ? '重试中…' : '重试加载'}}</view>
  </view>

  <!-- v1.7 · 快捷入口（更多页可自定义显示哪些；老用户默认折叠，减负首屏） -->
  <view class="quick-bar card" wx:if="{{tiles.length}}">
    <view class="qb-head" bindtap="toggleQuick">
      <text class="qb-h-t">快捷入口</text>
      <text class="qb-h-c">{{quickCollapsed ? '展开' : '收起'}}<text class="arrow">{{quickCollapsed ? '▾' : '▴'}}</text></text>
    </view>
    <view class="qb-grid" wx:if="{{!quickCollapsed}}">
      <view class="qb-item" wx:for="{{tiles}}" wx:key="k" data-url="{{item.url}}" bindtap="goTile">
        <image class="qb-ic" src="/images/icons/{{item.ic}}.png"/>
        <text class="qb-t">{{item.t}}</text>
      </view>
    </view>
  </view>



  <!-- 智能推荐：一句话描述需求 → 端侧推荐引擎给候选城市；点城市名预填表单 -->
  <view class="card rec-bar">
    <view class="rb-head">
      <text class="rb-t">智能推荐</text>
      <text class="rb-s">说说你想怎么玩，帮你挑城市</text>
    </view>
    <view class="rb-input-row">
      <input class="rb-input" value="{{recText}}" placeholder="例：人少的古镇，三天，预算省一点"
             confirm-type="search" bindinput="onRecInput" bindconfirm="onRecRun"/>
      <view class="rb-go {{recBusy ? 'rb-busy' : ''}}" bindtap="onRecRun">{{recBusy ? '推荐中' : '推荐'}}</view>
    </view>
    <view class="rb-chips" wx:if="{{recExamples.length && !recList.length}}">
      <view class="rb-chip" wx:for="{{recExamples}}" wx:key="*this" data-t="{{item}}" bindtap="onRecExample">{{item}}</view>
    </view>
    <view class="rb-list" wx:if="{{recList.length}}">
      <view class="rb-item" wx:for="{{recList}}" wx:key="name" data-name="{{item.name}}" bindtap="onRecPick">
        <view class="rb-l">
          <text class="rb-city">{{item.name}}</text>
          <text class="rb-prov">{{item.province}}</text>
        </view>
        <text class="rb-score">{{item.score}}分</text>
        <text class="rb-why">{{item.summary}}</text>
      </view>
      <view class="rb-foot">点城市名填入表单</view>
    </view>
    <view class="rb-empty" wx:if="{{recTried && !recList.length}}">没找到合适的，换个说法试试</view>
  </view>
  <!-- v1.19.139：为你推荐（基于本机真实数据的个性化，冷启动可见，无数据不显示） -->
  <view class="card foryou" wx:if="{{forYou.show}}">
    <view class="fy-head">
      <text class="fy-t">为你推荐</text>
      <text class="fy-s">{{forYou.summary}}</text>
    </view>
    <view class="fy-list">
      <view class="fy-item" wx:for="{{forYou.list}}" wx:key="name" data-name="{{item.name}}" bindtap="onForYouTap">
        <view class="fy-l">
          <text class="fy-city">{{item.name}}</text>
          <text class="fy-prov">{{item.province}}</text>
        </view>
        <text class="fy-why">{{item.why}}</text>
        <text class="fy-score">{{item.score}}</text>
      </view>
    </view>
  </view>
  <!-- 行程状态：出发倒计时 + 预约提醒 合并为一卡（v1.19.59 减法） -->
  <view class="card plan-status" wx:if="{{countdown || remind}}">
    <view class="ps-row" wx:if="{{countdown}}" bindtap="goPlan">
      <image class="ic" src="/images/icons/timer.png"/>
      <text class="cd-mini-big {{countdown.phase}}">{{countdown.big}}</text>
      <text class="cd-mini-u">{{countdown.unit}}</text>
      <text class="cd-mini-s">{{countdown.sub}}</text>
      <text class="arrow">›</text>
    </view>
    <view class="ps-row" wx:if="{{remind}}" bindtap="goPrep">
      <image class="ic" src="/images/icons/ticket.png"/>
      <view class="rm-main">
        <text class="rm-t">预约提醒 · {{remind.n}} 个景点需提前约</text>
        <text class="rm-s">{{remind.txt}}</text>
      </view>
      <text class="arrow">›</text>
    </view>
  </view>

  <!-- ═══ 行程配置主卡 ═══ -->
  <view class="card hero fb-fade-d1">
    <!-- 玩法三段切换：城市 / 全省精华 / 多站串联 -->
    <view class="seg">
      <view class="seg-it {{segIdx == 0 ? 'on' : ''}}" data-mode="city" bindtap="onModeTab"><image class="ic ic-sm" src="/images/icons/pin.png"/>城市</view>
      <view class="seg-it {{segIdx == 1 ? 'on' : ''}}" data-mode="prov" bindtap="onModeTab"><image class="ic ic-sm" src="/images/icons/map.png"/>全省精华</view>
      <view class="seg-it {{segIdx == 2 ? 'on' : ''}}" data-mode="multi" bindtap="onModeTab"><image class="ic ic-sm" src="/images/icons/route.png"/>多站串联</view>
    </view>

    <!-- ── 多站路线编辑态 ── -->
    <block wx:if="{{multiMode}}">
      <view wx:if="{{!multiRoute.length}}" class="multi-hint">点下方「添加城市」（最多 4 城）</view>
      <view class="multi-list">
        <view wx:for="{{multiRoute}}" wx:key="name" class="multi-row">
          <text class="mr-no">{{index + 1}}</text>
          <view class="mr-info">
            <text class="mr-name">{{item.name}}</text>
            <text class="mr-prov">{{item.province}}</text>
          </view>
          <view class="mr-step">
            <text class="step" data-i="{{index}}" data-dir="-1" catchtap="onStationDays">－</text>
            <text class="days-num">{{item.days}} 天</text>
            <text class="step" data-i="{{index}}" data-dir="1" catchtap="onStationDays">＋</text>
          </view>
          <text class="mr-x" data-i="{{index}}" catchtap="onStationDel">✕</text>
        </view>
      </view>
      <view wx:if="{{multiRoute.length < 4}}" class="multi-add" data-mode="multiPick" bindtap="openPicker">＋ 添加城市</view>
      <view wx:else class="multi-add dim">已达 4 站上限</view>
      <picker mode="date" value="{{depart}}" start="{{departMin}}" bindchange="onDateChange">
        <view class="field-row">
          <text class="field-label">第一站出发</text>
          <text class="field-value pick-value">{{depart}}<text class="arrow">›</text></text>
        </view>
      </picker>
    </block>

    <!-- ── 城市 / 全省 表单 ── -->
    <block wx:if="{{!multiMode}}">
      <!-- 全省精华游：省份 + 精华卡片 -->
      <block wx:if="{{provMode}}">
        <picker mode="selector" range="{{provinces}}" value="{{provIdx}}" bindchange="onProvChange">
          <view class="field-row">
            <text class="field-label">精选省份</text>
            <text class="field-value pick-value">{{provinces[provIdx] || '请选择'}}<text class="arrow">›</text></text>
          </view>
        </picker>
        <view class="prov-banner">
          <text class="prov-t">{{provTitle}}</text>
          <text class="prov-s">{{provSub}}</text>
        </view>
      </block>
      <!-- 城市：单个目的地入口（34 省级行政区 · 351 城全量可选，选完自动定省） -->
      <block wx:else>
        <view class="field-row" data-mode="from" bindtap="openPicker">
          <text class="field-label">出发地</text>
          <text class="field-value {{fromCityObj ? 'pick-value' : ''}}">{{fromTxt}}<text class="arrow">›</text></text>
        </view>
        <!-- v1.19.2：默认出发地容易被外地用户忽略，而它决定交通建议 -->
        <view class="pk-sub" wx:if="{{fromHint}}">{{fromHint}}</view>
        <view class="field-row" data-mode="dest" bindtap="openPicker">
          <text class="field-label">目的地</text>
          <text class="field-value {{cityName ? 'pick-value' : ''}}">
            <text>{{destLabel}}</text>
            <text class="arrow">›</text>
          </text>
        </view>
        <!-- v1.19.77：模板路线 —— 热门城市一键套用（省掉 选省 → 搜城 → 调天数 三步） -->
        <view class="tpl-row">
          <view class="tpl-hd">
            <text class="tpl-t">热门路线</text>
            <text class="tpl-s">点一下直接生成，可再改天数</text>
          </view>
          <scroll-view class="tpl-scroll" scroll-x enable-flex show-scrollbar="{{false}}">
            <view class="tpl-card {{cityName === item.city ? 'on' : ''}}" wx:for="{{tpls}}" wx:key="city" data-i="{{index}}" bindtap="onTplPick">
              <text class="tpl-city">{{item.city}}</text>
              <text class="tpl-meta">{{item.days}}天 · {{item.tag}}</text>
            </view>
          </scroll-view>
        </view>
        <!-- v1.19 P0-1：发现灵感（默认折叠，减负首屏） -->
        <view class="disc-bar" bindtap="toggleDiscover">
          <image class="ic ic-sm" src="/images/icons/sparkle.png"/>
          <text class="disc-t">发现灵感</text>
              <text class="disc-che">{{discoverOpen ? '▴' : '▾'}}</text>
        </view>
        <block wx:if="{{discoverOpen}}">
          <!-- v1.8.4 A8：目的地盲盒 -->
          <view class="blind-row" bindtap="onBlindRoll">
            <image class="ic ic-sm" src="/images/icons/shuffle.png"/><text>随机挑 3 个目的地</text>
          </view>
          <!-- v1.9：同省也值得去的精选城 -->
          <view class="sib-row" wx:if="{{sibs.length}}">
            <text class="sib-l">同省顺路</text>
            <view class="sib-chip" wx:for="{{sibs}}" wx:key="name" data-name="{{item.name}}" bindtap="onSibPick">{{item.name}}<text class="sib-d">{{item.days}}天</text></view>
          </view>
          <!-- v1.9：行前携带一句话 -->
          <view class="pk-line" wx:if="{{pkLine}}"><image class="ic ic-sm" src="/images/icons/backpack.png"/><text>{{pkLine}}</text></view>
        </block>
      </block>
      <view class="field-row">
        <text class="field-label">玩几天</text>
        <view class="day-ctl">
          <view class="stepper day-stepper">
            <text class="step-btn" catchtap="onDaysMinus">－</text>
            <text class="step-num">{{days}} 天</text>
            <text class="step-btn" catchtap="onDaysPlus">＋</text>
          </view>
        </view>
      </view>
      <!-- v1.19.2：常用天数一键预设（步进要点 7 次才好；新手也不知道几天合适） -->
      <view class="day-preset">
        <text class="dp-t">常用</text>
        <text class="dp-chip {{days === item ? 'on' : ''}}" wx:for="{{dayPresets}}" wx:key="*this" data-d="{{item}}" bindtap="onDaysPreset">{{item}} 天</text>
        <!-- v1.19.7 UI 减法：天数上限已由 +/- 按钮的行为本身表达，这行说明属于重复解释，移除 -->
      </view>
      <picker mode="date" value="{{depart}}" start="{{departMin}}" bindchange="onDateChange">
        <view class="field-row">
          <text class="field-label">出发日期</text>
          <text class="field-value pick-value">{{depart}}<text class="arrow">›</text></text>
        </view>
      </picker>
      <!-- v1.9：假期客流提醒 -->
      <view wx:if="{{holi}}" class="holi-line {{holi.on ? 'holi-big' : ''}}">
        <image class="ic ic-sm" src="/images/icons/heat.png"/><text>{{holi.txt}}</text>
      </view>
    </block>

    <!-- ── 高级设置（折叠收纳，减法） ── -->
    <view class="adv-bar" bindtap="onAdvTap">
      <text class="adv-t">高级设置</text>
      <text class="adv-hint">{{advHintTx}}</text>
      <text class="adv-che">{{advOpen ? '▴' : '▾'}}</text>
    </view>
    <block wx:if="{{advOpen}}">
      <picker mode="selector" range="{{paces}}" value="{{paceIdx}}" bindchange="onPaceChange">
        <view class="field-row">
          <text class="field-label">行程节奏</text>
          <text class="field-value">{{paces[paceIdx]}}<text class="arrow">›</text></text>
        </view>
      </picker>
      <!-- v1.19.2：把「轻松/平衡/特种兵」翻译成每天几个景点，新手才选得动 -->
      <view class="pk-sub" wx:if="{{paceHint}}">{{paceHint}}</view>
      <picker mode="selector" range="{{biasTxts}}" value="{{biasIdx}}" bindchange="onBiasChange">
        <view class="field-row">
          <text class="field-label">游玩偏好</text>
          <text class="field-value">{{biasTxts[biasIdx]}}<text class="arrow">›</text></text>
        </view>
      </picker>
      <picker mode="selector" range="{{travelModes}}" value="{{travelModeIdx}}" bindchange="onTravelModeChange">
        <view class="field-row">
          <text class="field-label">出行模式</text>
          <text class="field-value">{{travelModes[travelModeIdx]}}<text class="arrow">›</text></text>
        </view>
      </picker>
      <picker mode="selector" range="{{budgets}}" value="{{budgetIdx}}" bindchange="onBudgetChange">
        <view class="field-row">
          <text class="field-label">预算</text>
          <text class="field-value">{{budgets[budgetIdx]}}<text class="arrow">›</text></text>
        </view>
      </picker>
      <block wx:if="{{showCustom}}">
        <view class="field-row">
          <text class="field-label">全行程总预算（元）</text>
          <input class="amt-inp" type="digit" placeholder="如 3000" value="{{customAmt}}" bindinput="onCustomAmt"/>
        </view>
        <view class="pk-sub">{{customHint || (days+'天 × '+people+'人 自动分摊')}}</view>
      </block>
      <!-- v1.19.2：非自定义预算时显示档位金额区间，避免新手猜「舒适型」是多少钱 -->
      <view class="pk-sub" wx:if="{{!showCustom && budgetHint}}">{{budgetHint}}</view>
      <view class="field-row">
        <text class="field-label">出行人数</text>
        <view class="stepper">
          <text class="step-btn" bindtap="onPeopleMinus">－</text>
          <text class="step-num">{{people}} 人</text>
          <text class="step-btn" bindtap="onPeoplePlus">＋</text>
        </view>
      </view>
      <view class="field-row">
        <view class="sw-col">
          <text class="field-label">名山过夜</text>
          <text class="field-sub">住山顶，次日看日出</text>
        </view>
        <switch checked="{{stayMtn}}" color="#d4a94e" bindchange="onStayMtn"/>
      </view>
      <view class="adv-ex" bindtap="fillExample"><image class="ic" src="/images/icons/shuffle.png"/>随机填一个城市示例</view>
    </block>

    <!-- 收藏当前目的地（轻量小行） -->
    <view wx:if="{{cityName && !provMode && !multiMode}}" class="fav-mini" bindtap="onFavToggle">{{isFav ? '已收藏本目的地' : '收藏本目的地'}}</view>
  </view>

  <!-- 想玩景点池（折叠卡片） -->
  <view wx:if="{{cityName && poolCount && !multiMode && !provMode}}" class="card pool fb-fade-d2">
    <view class="pool-bar" bindtap="onPoolTap">
      <view class="pool-l">
        <view class="pool-t"><image class="ic" src="/images/icons/target.png"/>想玩景点</view>
        <text class="pool-s">{{poolSubTx}}</text>
      </view>
      <view class="pool-r">
        <text class="arrow">{{poolOpen ? '收起 ▴' : '展开 ▾'}}</text>
      </view>
    </view>
    <block wx:if="{{poolOpen}}">
      <view class="pk-search-row">
        <input class="pk-search" placeholder="搜索景点名（共 {{poolCount}} 个）" value="{{pickKw2}}" bindinput="onPickKw2"/>
        <text class="pk-clear" wx:if="{{pickKw2}}" catchtap="clearPoolKw">清空</text>
      </view>
      <view class="pk-tagbar" wx:if="{{poolTagList.length}}">
        <view class="pk-tagchip {{poolTag==='' ? 'on' : ''}}" data-tag="" bindtap="onPoolTag">全部</view>
        <view class="pk-tagchip {{poolTag===item ? 'on' : ''}}" wx:for="{{poolTagList}}" wx:key="*this" data-tag="{{item}}" bindtap="onPoolTag">{{item}}</view>
      </view>
      <view class="pk-tools">
        <text class="pk-tool" bindtap="pickAllPool">全选</text>
        <text class="pk-tool" bindtap="pickClearPool">清空</text>
        <text class="pk-tool dim">{{poolOn}}/{{poolCount}}</text>
      </view>
      <view class="pk-chips">
        <view wx:if="{{!poolFiltered.length}}" class="pk-empty">没有匹配的景点，换个关键词试试</view>
        <view wx:for="{{poolFiltered}}" wx:key="name"
              class="pk-chip {{item.on ? 'on' : ''}}" data-name="{{item.name}}" bindtap="togglePool">
          <text>{{item.on ? '✓ ' : ''}}{{item.name}}</text>
        </view>
      </view>
      <!-- v1.19.2：池子被截断时明确告知还剩多少，而不是让用户以为只有这些 -->
      <view class="pk-more dim" wx:if="{{poolMore}}">还有 {{poolMore}} 个未显示 · 输入关键词可精确查找</view>
      <view class="pk-only" wx:if="{{poolOn}}">
        <view class="sw-col">
          <text class="field-label">只玩勾选的</text>
        </view>
        <switch checked="{{pickOnly}}" color="#d4a94e" bindchange="onPickOnly"/>
      </view>
    </block>
  </view>

  <!-- ═══ 快捷回填（收藏 + 最近合并一卡） ═══ -->
  <view wx:if="{{favs.length || recents.length}}" class="card quick fb-fade-d3">
    <view class="q-head">
      <view class="q-title"><image class="ic" src="/images/icons/pin.png"/>快捷回填</view>
      <text class="q-sub">点一下回填 · ✕ 可删除</text>
    </view>
    <view wx:if="{{favs.length}}" class="q-sec">
      <view class="q-lab"><image class="ic ic-sm" src="/images/icons/heart.png"/>我的收藏</view>
      <view class="recent-wrap">
        <view class="recent-chip" wx:for="{{favs}}" wx:key="*this"
              data-i="{{index}}" bindtap="applyFav">
          <text class="rc-main">{{item}}</text>
          <text class="rc-x" data-i="{{index}}" catchtap="delFav">✕</text>
        </view>
      </view>
    </view>
    <view wx:if="{{recents.length}}" class="q-sec">
      <view class="q-lab"><image class="ic ic-sm" src="/images/icons/clock.png"/>最近查过</view>
      <view class="recent-wrap">
        <view class="recent-chip" wx:for="{{recents}}" wx:key="city"
              data-i="{{index}}" bindtap="fillRecent">
          <text class="rc-main">{{item.city}} · {{item.days}}天</text>
          <text class="rc-x" data-i="{{index}}" catchtap="delRecent">✕</text>
        </view>
      </view>
    </view>
  </view>

  <view wx:if="{{hasOld}}" class="tip" bindtap="resumeOld">继续上次行程</view>

  <view class="action-area">
    <view class="action-row">
      <button class="btn-ghost" bindtap="saveDraftNow">存草稿</button>
      <button class="btn-primary" bindtap="generate" disabled="{{loading}}">
        {{btnTx}}
      </button>
    </view>
    <view class="draft-link" bindtap="openDrafts">
      <image class="ic ic-sm" src="/images/icons/copy.png"/>
      <text>草稿箱（{{draftCount}}）</text>
    </view>
  </view>

  <!-- 城市搜索选择器（目的地 / 出发地 / 多站 共用） -->
  <view wx:if="{{showPicker}}" class="mask" bindtap="_closePicker">
    <view class="picker-sheet" catchtap="noop">
      <view class="ps-head">
        <text class="ps-title">{{pickTitle}}</text>
        <image class="ps-close" src="/images/icons/close.png" bindtap="_closePicker"/>
      </view>
      <scroll-view scroll-x class="ps-provs" wx:if="{{pickMode === 'dest'}}" enhanced show-scrollbar="{{false}}">
        <text class="ps-p {{pickProv === '' ? 'on' : ''}}" data-p="" catchtap="onPickProv">全部</text>
        <text wx:for="{{provinces}}" wx:key="*this" class="ps-p {{pickProv === item ? 'on' : ''}}"
              data-p="{{item}}" catchtap="onPickProv">{{item}}</text>
      </scroll-view>
      <input class="ps-search" placeholder="输入城市名 / 省名搜索…" value="{{pickKw}}" bindinput="onPickKw" focus/>
      <scroll-view scroll-y class="ps-list">
        <view wx:for="{{pickList}}" wx:key="name"
              class="ps-item {{item.guide ? 'guide' : ''}} {{item.all ? 'all' : ''}} {{item.limited ? 'limited' : ''}}" data-i="{{index}}" bindtap="chooseFromPicker">
          <text class="ps-name">{{item.name}}</text>
          <text class="ps-sub">{{item.province == item.name ? '' : item.province}}{{item.all ? ' · 全省精华，可多城串联' : ''}}</text>
          <text wx:if="{{item.limited}}" class="ps-badge">内容收集中</text>
        </view>
        <view wx:if="{{!pickList.length}}" class="ps-empty">未找到匹配城市，换个关键词试试</view>
      </scroll-view>
    </view>
  </view>

  <view class="ver dim">旅行攻略生成器</view>

  <!-- v1.8.4 A8：目的地盲盒 -->
  <view wx:if="{{blindOpen}}" class="mask" bindtap="closeBlind">
    <view class="picker-sheet blind-sheet" catchtap="noop">
      <view class="ps-head">
        <text class="ps-title">🎲 这次去哪儿？随机挑三座</text>
        <image class="ps-close" src="/images/icons/close.png" bindtap="closeBlind"/>
      </view>
      <view class="blind-note">3 个随机目的地，选一个生成</view>
      <view class="blind-list">
        <view class="blind-card" wx:for="{{blind3}}" wx:key="name" data-i="{{index}}" bindtap="useBlind">
          <view class="bc-top">
            <text class="bc-no">{{index + 1}}</text>
            <text class="bc-name">{{item.name}}</text>
            <text class="bc-prov dim">{{item.province}}</text>
          </view>
          <view class="bc-why">{{item.why}}</view>
          <view class="bc-meta">
            <text class="bc-days">建议 {{item.days}} 天</text>
            <text class="bc-best">{{item.best}}</text>
          </view>
        </view>
      </view>
      <view class="blind-refresh" bindtap="onBlindRoll">↻ 再摇一次</view>
    </view>
  </view>

  <!-- v1.19.132：首次进入改为直接打开「使用指南」页（见 index.js maybeShowGuideModal → goGuide），不再用此浮层 -->

  <!-- v1.19.58：草稿箱（保存 / 恢复首页配置） -->
  <view wx:if="{{showDraft}}" class="mask" bindtap="closeDrafts">
    <view class="picker-sheet draft-sheet" catchtap="noop">
      <view class="ps-head">
        <text class="ps-title">草稿箱</text>
        <image class="ps-close" src="/images/icons/close.png" bindtap="closeDrafts"/>
      </view>
      <view wx:if="{{!drafts.length}}" class="draft-empty">暂无草稿</view>
      <scroll-view scroll-y class="draft-list">
        <view wx:for="{{drafts}}" wx:key="id" class="draft-item">
          <view class="di-main">
            <text class="di-name">{{item.name}}</text>
            <text class="di-time">{{item.timeTxt}}</text>
          </view>
          <view class="di-ops">
            <text class="di-btn di-apply" data-id="{{item.id}}" bindtap="applyDraft">恢复</text>
            <text class="di-x" data-id="{{item.id}}" catchtap="delDraftItem">✕</text>
          </view>
        </view>
      </scroll-view>
    </view>
  </view>
</view>
