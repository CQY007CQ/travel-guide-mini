<view class="page {{td ? 'td' : ''}} fz{{fz}}">
  <!-- 无行程 -->
  <view wx:if="{{!hasPlan}}" class="empty">
    <!-- v1.8.5 C9：每日一句 -->
    <view wx:if="{{quote}}" class="em-quote">「{{quote.txt}}」</view>
    <view class="em-ic"><image class="em-img" src="/images/icons/compass.png"/></view>
    <view class="em-t">还没有行程</view>
    <view class="em-s">先去「出发」页生成一份攻略<br/>这里会自动告诉你「今天该干嘛」</view>
    <button class="btn-primary em-btn" bindtap="goIndex">去生成攻略</button>
  </view>

  <block wx:if="{{hasPlan}}">

    <!-- 行前 -->
    <block wx:if="{{state === 'before'}}">
      <view class="card badge-before fb-fade">
        <view class="tc-head">
          <text class="tc-badge b-before"><image class="ic ic-sm" src="/images/icons/timer.png"/>距出发 {{view.daysLeft}} 天</text>
          <text class="tc-title">{{view.prepTitle}}</text>
        </view>
        <view class="prep-item {{item.done ? 'done' : ''}}" wx:for="{{view.prepItems}}" wx:key="k"
              data-k="{{item.k}}" bindtap="onPrepTap">
          <view class="box {{item.done ? 'on' : ''}}">{{item.done ? '✓' : ''}}</view>
          <text class="txt">{{item.t}}</text>
        </view>
        <view class="prog">已完成 {{view.prepDone}}/{{view.prepItems.length}}</view>
        <view wx:if="{{view.wishHitTxt}}" class="wish-line" bindtap="goPlan"><image class="ic" src="/images/icons/star.png"/>想玩已安排 · {{view.wishHitTxt}}<text class="wl-go">去行程看 ›</text></view>
      </view>
      <view class="card">
        <view class="tc-head2"><image class="ic" src="/images/icons/backpack.png"/>自动行李清单</view>
        <view class="pk-sub dim">按 {{view.days}} 天 · {{view.packSeason}}季生成，点一下打勾</view>
        <block wx:for="{{view.packGroups}}" wx:key="title" wx:for-item="g">
          <view class="pk-gt">{{g.title}}</view>
          <view class="prep-item {{item.done ? 'done' : ''}}" wx:for="{{g.items}}" wx:key="k"
                data-k="{{item.k}}" bindtap="onPrepTap">
            <view class="box {{item.done ? 'on' : ''}}">{{item.done ? '✓' : ''}}</view>
            <text class="txt">{{item.t}}</text>
          </view>
        </block>
        <view class="prog">
          <view class="bar"><view class="fill" style="width:{{view.packPct}}%"></view></view>
          <text class="prog-t">已装 {{view.packDone}}/{{view.packTotal}}</text>
        </view>
      </view>
      <!-- v1.9：目的地气候补充提醒 -->
      <view class="card" wx:if="{{view.cliAdd.length}}">
        <view class="tc-head2"><image class="ic" src="/images/icons/backpack.png"/>去 {{view.cityName}} 还要带这些</view>
        <view class="cli-row">
          <text class="cli-chip" wx:for="{{view.cliAdd}}" wx:key="*this">{{item}}</text>
        </view>
      </view>
    </block>

      <!-- v1.8.4 A2：穿衣指数卡（按出行当月的当地气候） -->
      <view class="card dress-card" wx:if="{{state !== 'after' && view.dress}}">
        <view class="tc-head2"><image class="ic" src="/images/icons/sun.png"/>去 {{view.cityName}} 怎么穿 · {{view.dress.season}}</view>
        <view class="dress-main">{{view.dress.lines[0]}}</view>
        <view class="dress-sub dim">{{view.dress.weather}}</view>
        <view class="dress-tags">
          <block wx:for="{{view.dress.lines}}" wx:key="*this">
            <view class="dress-tag" wx:if="{{index > 0}}">{{item}}</view>
          </block>
          <view class="dress-tag" wx:if="{{view.dress.acc}}">{{view.dress.acc}}</view>
        </view>
      </view>

    <!-- 途中 -->
    <block wx:if="{{state === 'during'}}">
      <view class="card badge-during fb-fade fb-glow">
        <view class="tc-head">
          <text class="tc-badge b-during"><image class="ic ic-sm" src="/images/icons/timer.png"/>第 {{view.dayNo}} 天 / 共 {{view.total}} 天</text>
          <text class="tc-title">{{view.theme}}</text>
        </view>
        <view wx:if="{{view.now}}" class="now-box">
          <text class="now-tag">{{view.nowTag || '正在玩'}}</text>
          <text class="now-name">{{view.now.clean}}</text>
        </view>
        <view wx:if="{{view.wishHitTxt}}" class="wish-line fb-pulse" bindtap="goPlan"><image class="ic" src="/images/icons/star.png"/>想玩命中 · {{view.wishHitTxt}}<text class="wl-go">去行程看 ›</text></view>
        <view wx:if="{{view.next}}" class="next-line">之后：{{view.next.clean}}</view>
        <view wx:else class="next-line dim"><image class="ic" src="/images/icons/moon.png"/>今天的安排已经走完了</view>
        <view wx:if="{{view.now}}" class="left-line">今天还剩 <text class="gold">{{view.left}}</text> 项安排</view>
        <!-- v1.20.7：今日动线与步行量（与行程页同源的真实坐标估算，点击去行程看逐日动线） -->
        <view wx:if="{{view.walk}}" class="walk-line" bindtap="goPlan">
          <image class="ic ic-sm" src="/images/icons/route.png"/>{{view.walk.txt}}<text class="wl-go">看动线 ›</text>
        </view>
        <!-- v1.9：超支轻提醒 + 今日装备 -->
        <view wx:if="{{view.overHint}}" class="over-line {{view.overHint.lv}}"><image class="ic ic-sm" src="/images/icons/wallet.png"/>{{view.overHint.txt}}</view>
        <view wx:if="{{view.gear.length}}" class="gear-row">
          <text class="gear-t">今天带上</text>
          <view class="gear-chip" wx:for="{{view.gear}}" wx:key="*this">{{item}}</view>
        </view>
      </view>

      <view class="card">
        <view class="tc-head2"><image class="ic" src="/images/icons/wallet.png"/>今日花费 · ¥{{view.spent}}</view>
        <view class="dim u-fs22 u-myx">{{view.budgetTxt}}</view>
        <view wx:if="{{view.gauge}}" class="bud-bar">
          <view class="bud-track">
            <view class="bud-fill {{view.gauge.over ? 'over' : ''}}" style="width:{{view.gauge.pct}}%;"/>
          </view>
          <text class="bud-tx {{view.gauge.over ? 'bud-over-tx' : ''}}">{{view.gauge.txt}}</text>
        </view>
        <view class="ledger-row">
          <input class="amt-inp" placeholder="一句话记账：打车 32" value="{{amt}}" bindinput="onAmtInput" bindconfirm="quickLedger"/>
          <view class="qk-btn" bindtap="quickLedger">记账</view>
        </view>
        <view class="qk-tip" wx:if="{{quickParsed}}">
          识别为 <text class="gold">{{quickParsed.name}}</text> · <text class="gold">¥{{quickParsed.amt}}</text> · {{quickParsed.cat}}
        </view>
        <view class="qk-cats">
          <view class="qk-cat {{cat === item ? 'on' : ''}}" wx:for="{{cats}}" wx:key="*this" data-c="{{item}}" bindtap="onCatPick">{{item}}</view>
        </view>
      </view>

      <!-- 今日手记（每天一句，存本机） -->
      <view class="card">
        <view class="tc-head2"><image class="ic" src="/images/icons/bulb.png"/>今日手记</view>
        <view class="note-row">
          <input class="note-inp" value="{{noteInput}}" placeholder="写一句今天的旅行感觉…" bindinput="onNoteInput" maxlength="120"/>
          <view class="qk-btn" bindtap="onNoteSave">保存</view>
        </view>
        <view wx:if="{{noteSaved}}" class="dim u-fs21 u-mt10">已记下：{{noteSaved}}</view>
      </view>

      <!-- v1.9：明日预告 -->
      <view class="card peek-card" wx:if="{{view.peek}}" bindtap="goPlan">
        <view class="peek-h"><image class="ic" src="/images/icons/sparkle.png"/>明日预告 · D{{view.peek.dayNo}}</view>
        <view class="peek-t dim">{{view.peek.theme}}<block wx:if="{{view.peek.spotsText}}">：{{view.peek.spotsText}}</block></view>
      </view>
    </block>

    <!-- 结束 -->
    <block wx:if="{{state === 'after'}}">
      <view class="card">
        <view class="tc-head">
          <text class="tc-badge b-after">行程已结束</text>
        </view>
        <view class="after-sum">
          {{view.daysSince}} 天前结束了这趟 {{view.cityName}} 之旅<br/>
          一共走了 {{view.spots}} 个景点<block wx:if="{{view.totalMoney > 0}}"> · 记账合计 ¥{{view.totalMoney}}</block>
        </view>
        <!-- v1.8.5 C10：回顾 CTA（足迹 / 年鉴 / 城市经验都在「我的」） -->
        <view class="aft-cta" bindtap="goMore">
          <image class="ic" src="/images/icons/star.png"/>去「我的」看看足迹年鉴，给这座城留条经验
          <text class="wl-go">回顾 ›</text>
        </view>
      </view>

</block>

    <!-- AI 今日建议（云端强模型优先 · 离线兜底） -->
    <view class="card ai-today">
      <view class="ai-h">
        <image class="ic" src="/images/icons/sparkle.png"/>
        <text class="ai-t">AI 今日建议</text>
        <text class="ai-badge" wx:if="{{aiSource}}">AI 生成</text>
        <view class="ai-btn {{aiLoading ? 'ai-busy' : ''}}" bindtap="askTodayAI">{{aiLoading ? '思考中…' : (aiText ? '再问一次' : '生成')}}</view>
      </view>
      <view class="ai-body" wx:if="{{aiText}}">{{aiText}}</view>
      <view class="ai-copy" wx:if="{{aiText}}" bindtap="aiCopy">复制回答</view>
      <view class="ai-tip" wx:else>基于本趟行程的真实数据给 3 条可执行建议（动线/穿搭/预算）；无网络时自动回落离线规则库。</view>
      <view class="ai-err" wx:if="{{aiErr}}">{{aiErr}}</view>
    </view>

    <!-- 减法：行程入口已在底部 tabBar，不再重复提示 -->
  </block>
</view>
