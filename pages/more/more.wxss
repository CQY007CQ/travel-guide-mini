.page { padding: 24rpx 0 80rpx; }

/* ---- 分组 ---- */
.group { margin-top: 30rpx; }

.group-title { font-size: calc(23rpx * var(--fs, 1)); font-weight: 800; color: var(--t3, #8fa3bc); margin: 0 8rpx 14rpx;
  letter-spacing: 2rpx; padding-left: 22rpx; position: relative; }

.group-title::before { content: ""; position: absolute; left: 6rpx; top: 50%; transform: translateY(-50%);
  width: 8rpx; height: 22rpx; border-radius: 4rpx; background: linear-gradient(180deg, #e8c877, #b8892f); }

.group-card { padding: 8rpx 0; overflow: hidden; }

.menu { display: flex; align-items: center; padding: 22rpx 26rpx; border-bottom: 1rpx solid rgba(var(--ln-rgb, 148,163,184),.05); }

.menu:last-child { border-bottom: none; }

.menu:active { background: rgba(212,169,78,.06); }

/* PNG 图标（替换 emoji）：沿用 m-ico 底座，内嵌图标 */
.m-ic { width: 42rpx; height: 42rpx; margin-right: 26rpx; }

.wish-item .m-ic { width: 34rpx; height: 34rpx; margin-right: 18rpx; }

.we-ic { width: 72rpx; height: 72rpx; }

.m-txt { flex: 1; min-width: 0; }

.m-t { font-size: calc(29rpx * var(--fs, 1)); font-weight: 700; }

.m-d { font-size: calc(22rpx * var(--fs, 1)); margin-top: 4rpx; }

.arrow { color: var(--t4, #5b6b82); font-size: calc(34rpx * var(--fs, 1)); }

/* v1.8.4 B13 旅行年鉴数字行（子项复用 .rv-n/.rv-v/.rv-l） */
.rv-nums { display: flex; margin: 0 26rpx; padding: 10rpx 0 6rpx; }

.rv-nums .rv-n { gap: 2rpx; }

.rv-nums .rv-v { font-size: calc(32rpx * var(--fs, 1)); }

.rv-nums .rv-l { font-size: calc(18rpx * var(--fs, 1)); }

/* ---- 想玩清单 ---- */
/* C1：按城市分组头 */
.wg { display: flex; align-items: center; padding: 20rpx 26rpx 6rpx; font-size: calc(20rpx * var(--fs, 1)); font-weight: 800;
  letter-spacing: 2rpx; color: var(--t3, #8fa3bc); }

.wg-dot { width: 8rpx; height: 8rpx; border-radius: 4rpx; margin-right: 12rpx; flex-shrink: 0;
  background: linear-gradient(160deg, #e8c877, #b8892f); }

.wg-n { font-weight: 400; letter-spacing: 0; margin-left: 10rpx; font-size: calc(19rpx * var(--fs, 1)); }

.wg + .wish-item { padding-top: 14rpx; }

.wish-item { display: flex; align-items: center; padding: 20rpx 26rpx; border-bottom: 1rpx solid rgba(var(--ln-rgb, 148,163,184),.05); }

.wish-item:last-of-type { border-bottom: none; }

.wish-item:active { background: rgba(var(--ln-rgb, 138,165,192),.05); }

.w-del { width: 48rpx; height: 48rpx; border-radius: 50%; background: rgba(var(--ln-rgb, 148,163,184),.06); color: var(--t4, #9aa7ba); font-size: calc(22rpx * var(--fs, 1)); display: flex; align-items: center; justify-content: center; }

.w-del:active { background: rgba(229,106,106,.3); color: var(--red, #e56a6a); }

.wish-ops { display: flex; gap: 16rpx; padding: 18rpx 26rpx 26rpx; }

.op-btn { flex: 1; text-align: center; padding: 18rpx 0; border-radius: 14rpx;
  background: rgba(212,169,78,.14); color: var(--chip-tx, #d4a94e); font-size: calc(26rpx * var(--fs, 1)); font-weight: 600; }

.op-btn:active { opacity: .75; }

.op-btn.danger { background: rgba(255,99,99,.10); color: var(--red, #ff6b6b); }

.op-btn.wide { margin: 24rpx 26rpx; }

.wish-empty { padding: 44rpx 30rpx 30rpx; text-align: center; }

.we-t { font-size: calc(29rpx * var(--fs, 1)); font-weight: 700; margin-top: 14rpx; }

.we-d { font-size: calc(22rpx * var(--fs, 1)); margin-top: 8rpx; line-height: 1.7; }

.wish-tip { font-size: calc(21rpx * var(--fs, 1)); margin: 14rpx 8rpx 0; text-align: center; }

.foot { text-align: center; font-size: calc(21rpx * var(--fs, 1)); margin-top: 64rpx; }

/* 行程存档操作钮 */
.ps-restore { flex-shrink: 0; font-size: calc(21rpx * var(--fs, 1)); color: var(--chip-tx, #8f6a1f); background: rgba(212,169,78,.14);
  border: 1rpx solid rgba(212,169,78,.32); border-radius: 99rpx; padding: 6rpx 20rpx; }

.ps-restore:active { background: rgba(212,169,78,.3); }

.ps-del { flex-shrink: 0; width: 48rpx; height: 48rpx; display: flex; align-items: center; justify-content: center;
  color: var(--red, #cc3d3d); font-size: calc(24rpx * var(--fs, 1)); border-radius: 12rpx; background: rgba(204,61,61,.08); }

.ps-del:active { background: rgba(204,61,61,.2); }

.sp-tip { font-size: calc(20rpx * var(--fs, 1)); margin: 12rpx 26rpx 0; line-height: 1.5; }

/* 旅行足迹 */
.foot-line { display: flex; align-items: baseline; padding: 14rpx 26rpx 10rpx; }

.foot-big { font-size: calc(44rpx * var(--fs, 1)); font-weight: 800; color: var(--gold-tx, #8f6a1f); }

.foot-lb { font-size: calc(23rpx * var(--fs, 1)); color: var(--t2, #5b6b82); margin-left: 4rpx; }

.foot-sep { margin: 0 20rpx; color: var(--t4, #b4b2a9); }

.chip.fcity { background: rgba(212,169,78,.12); color: var(--gold-tx, #8f6a1f); border: 1rpx solid rgba(212,169,78,.28); }

.group-card .chips { padding: 2rpx 26rpx 8rpx; box-sizing: border-box; }

/* 外观行：主题切换（并入通用组卡片，与菜单行同内边距对齐） */
.theme-row, .theme-menu {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 22rpx 26rpx;
}

.theme-row .m-txt, .theme-menu .m-txt { flex: 1; margin-right: 16rpx; }

/* ===== v1.5 · 旅行成就徽章 ===== */
.ach-bar { height: 10rpx; border-radius: 99rpx; background: rgba(var(--ln-rgb, 148,163,184),.14);
  overflow: hidden; margin: 0 26rpx 6rpx; }

.ach-fill { height: 100%; border-radius: 99rpx; background: linear-gradient(90deg, #e2b65c, #d4a94e);
  box-shadow: 0 0 12rpx rgba(212,169,78,.35); }

.ach-grid { display: flex; flex-wrap: wrap; gap: 16rpx; padding: 18rpx 26rpx 8rpx; }

.ach-it { width: calc((100% - 32rpx) / 3); display: flex; flex-direction: column; align-items: center;
  padding: 18rpx 6rpx 14rpx; border-radius: 18rpx; box-sizing: border-box;
  background: rgba(var(--ln-rgb, 148,163,184), .06);
  border: 1rpx solid rgba(var(--ln-rgb, 148,163,184), .12); }

.ach-it.on { background: linear-gradient(180deg, rgba(212,169,78,.16), rgba(212,169,78,.03));
  border-color: rgba(212,169,78,.38); }

.ach-ic { width: 44rpx; height: 44rpx; opacity: .28; filter: grayscale(1); }

.ach-it.on .ach-ic { opacity: 1; filter: none; }

.ach-t { font-size: calc(23rpx * var(--fs, 1)); font-weight: 700; margin-top: 8rpx; color: var(--t3, #8fa3bc); text-align: center; }

.ach-it.on .ach-t { color: var(--gold-tx, #8f6a1f); }

.ach-d { font-size: calc(18rpx * var(--fs, 1)); line-height: 1.4; margin-top: 4rpx; text-align: center; }

.ach-p { font-size: calc(18rpx * var(--fs, 1)); margin-top: 6rpx; color: var(--t4, #5b6b82); }

.ach-it.on .ach-p { color: var(--chip-tx, #8f6a1f); font-weight: 700; }

/* ===== v1.6 · 外观三态 ===== */
.theme-row { display: flex; gap: 12rpx; margin: 0 26rpx 20rpx; }

.th-chip {
  flex: 1; text-align: center; font-size: calc(22rpx * var(--fs, 1)); color: var(--t2, #c3cfe0);
  background: rgba(var(--ln-rgb, 148, 163, 184), .09);
  border: 1rpx solid rgba(var(--ln-rgb, 148, 163, 184), .16);
  border-radius: 14rpx; padding: 14rpx 0;
  display: flex; align-items: center; justify-content: center; gap: 6rpx;
}

.th-chip.on {
  color: var(--gold-tx, #d4a94e); font-weight: 700;
  background: rgba(212, 169, 78, .14); border-color: rgba(212, 169, 78, .3);
}

/* v1.19.x：全局阅读字号三档（标准 / 大 / 特大） */
.fz-row { display: flex; gap: 12rpx; margin: 14rpx 26rpx 8rpx; }

/* ===== v1.6 · 旅行小结 ===== */
.rv-title { font-size: calc(28rpx * var(--fs, 1)); font-weight: 700; color: var(--t1, #eaeff7); margin: 0 26rpx 16rpx; }

.rv-grid { display: flex; margin: 0 26rpx; padding: 6rpx 0 14rpx; }

.rv-n { flex: 1; display: flex; flex-direction: column; align-items: center; gap: 4rpx; }

.rv-v { font-size: calc(36rpx * var(--fs, 1)); font-weight: 800; color: var(--t1, #eaeff7); line-height: 1.1; }

.rv-v.gold { color: var(--gold-tx, #d4a94e); }

.rv-l { font-size: calc(19rpx * var(--fs, 1)); color: var(--t3, #8fa3bc); }

.rv-tx { font-size: calc(21rpx * var(--fs, 1)); line-height: 1.7; margin: 0 26rpx; }

.rv-tx:last-child { margin-bottom: 18rpx; }

/* ===== v1.7 · 旅行灵感 ===== */
.insp-card { display: flex; align-items: center; gap: 18rpx; }

.insp-l { flex: 1; display: flex; align-items: flex-start; gap: 14rpx; min-width: 0; }

.insp-txt { flex: 1; min-width: 0; }

.insp-n { font-size: calc(30rpx * var(--fs, 1)); font-weight: 800; color: var(--t1, #eaeff7); }

.insp-pv { font-size: calc(21rpx * var(--fs, 1)); font-weight: 400; }

.insp-d { font-size: calc(20rpx * var(--fs, 1)); line-height: 1.55; margin-top: 6rpx; }

.insp-r { text-align: right; flex-shrink: 0; }

.insp-days {
  font-size: calc(26rpx * var(--fs, 1)); font-weight: 800; color: var(--gold-tx, #d4a94e);
  background: rgba(212, 169, 78, .13); border-radius: 99rpx; padding: 6rpx 20rpx;
}

.insp-best { font-size: calc(18rpx * var(--fs, 1)); margin-top: 8rpx; max-width: 200rpx; }

.insp-ops { display: flex; gap: 12rpx; margin: 0 26rpx 0; flex-wrap: wrap; }

.insp-btn {
  display: flex; align-items: center; gap: 8rpx;
  font-size: calc(21rpx * var(--fs, 1)); color: var(--t2, #c3cfe0);
  background: rgba(var(--ln-rgb, 148, 163, 184), .09);
  border: 1rpx solid rgba(var(--ln-rgb, 148, 163, 184), .16);
  border-radius: 14rpx; padding: 12rpx 22rpx;
}

.insp-btn-main {
  color: var(--gold-tx, #d4a94e); font-weight: 600;
  background: rgba(212, 169, 78, .13); border-color: rgba(212, 169, 78, .28);
}

/* ===== v1.7 · 足迹热力图 ===== */
.heat-grid { display: flex; flex-wrap: wrap; gap: 12rpx; margin: 16rpx 26rpx 0; }

.heat-cell {
  display: flex; flex-direction: column; align-items: center; justify-content: center;
  min-width: 128rpx; padding: 14rpx 10rpx; border-radius: 14rpx;
  background: rgba(var(--ln-rgb, 148, 163, 184), .08);
}

.heat-cell.l1 { background: rgba(212, 169, 78, .12); }

.heat-cell.l2 { background: rgba(212, 169, 78, .26); }

.heat-cell.l3 { background: rgba(212, 169, 78, .45); }

.heat-cell.l4 { background: rgba(212, 169, 78, .72); }

.hc-n { font-size: calc(21rpx * var(--fs, 1)); font-weight: 600; color: var(--t1, #eaeff7); }

.hc-c { font-size: calc(18rpx * var(--fs, 1)); margin-top: 2rpx; color: var(--t2, #c3cfe0); }

.heat-cell.l3 .hc-n, .heat-cell.l4 .hc-n { color: #22262e; }

.heat-cell.l3 .hc-c, .heat-cell.l4 .hc-c { color: rgba(34, 38, 46, .7); }

.heat-legend { display: flex; align-items: center; gap: 10rpx; margin: 16rpx 26rpx 18rpx; }

.hl-t { font-size: calc(19rpx * var(--fs, 1)); }

.hl-c { width: 40rpx; height: 14rpx; border-radius: 99rpx; }

.hl-c.l1 { background: rgba(212, 169, 78, .12); }

.hl-c.l2 { background: rgba(212, 169, 78, .26); }

.hl-c.l3 { background: rgba(212, 169, 78, .45); }

.hl-c.l4 { background: rgba(212, 169, 78, .72); }

/* ===== v1.7 · 界面设置 ===== */
.set-row { display: flex; align-items: center; gap: 16rpx; margin: 0 26rpx; }

.set-l { flex: 1; min-width: 0; }

.set-t { font-size: calc(25rpx * var(--fs, 1)); font-weight: 700; color: var(--t1, #eaeff7); }

.set-block { margin: 0 26rpx; }

.set-d { font-size: calc(20rpx * var(--fs, 1)); line-height: 1.5; margin-top: 4rpx; }

.set-sep { height: 1rpx; background: rgba(var(--ln-rgb, 148, 163, 184), .12); margin: 18rpx 26rpx; }

.tile-grid { display: flex; flex-wrap: wrap; gap: 12rpx; margin: 0 26rpx 18rpx; }

.tile {
  display: flex; align-items: center; gap: 8rpx;
  font-size: calc(21rpx * var(--fs, 1)); color: var(--t3, #8fa3bc);
  background: rgba(var(--ln-rgb, 148, 163, 184), .07);
  border: 1rpx solid rgba(var(--ln-rgb, 148, 163, 184), .12);
  border-radius: 14rpx; padding: 12rpx 20rpx;
}

.tile.on {
  color: var(--gold-tx, #d4a94e); font-weight: 600;
  background: rgba(212, 169, 78, .13); border-color: rgba(212, 169, 78, .28);
}

.tile-ic { width: 26rpx; height: 26rpx; }

.tile-t { font-size: calc(21rpx * var(--fs, 1)); }

/* v1.8.4 B14 全量宫格置灰 + B13 年鉴 */
.heat-cell.l0 { background: rgba(var(--ln-rgb,100,116,139), .07); color: rgba(var(--ln-rgb,100,116,139), .35); border: 1rpx dashed rgba(var(--ln-rgb,100,116,139), .12); }

.heat-cell.l0 .hc-c { color: inherit; }

/* v1.8.5 C11/C12/C13/C15：想玩状态标 / 足迹复制 / 城市 chip 可点 / 关于行 */
.w-tags { display: flex; align-items: center; gap: 6rpx; margin-right: 8rpx; flex-shrink: 0; }

.w-tag { font-size: calc(18rpx * var(--fs, 1)); padding: 3rpx 10rpx; border-radius: 20rpx; line-height: 1.4; }

.w-tag.tp { color: #2f6fce; background: rgba(76, 128, 255, .12); }

.w-tag.tv { color: var(--t3, #64748b); background: rgba(var(--ln-rgb,148,163,184),.12); }

.chip.fcity { padding: 8rpx 20rpx; }

.foot-copy { display: inline-flex; align-items: center; gap: 8rpx; margin: 16rpx 26rpx 4rpx; padding: 12rpx 24rpx; border: 1rpx solid rgba(var(--ln-rgb,148,163,184),.22); border-radius: 30rpx; font-size: calc(22rpx * var(--fs, 1)); color: var(--t2, #5b6b82); }

.foot-copy .ic { opacity: .8; }

.ver-row { display: flex; align-items: center; justify-content: center; gap: 6rpx; padding: 4rpx 0 30rpx; }

.ver-row .arrow { font-size: calc(24rpx * var(--fs, 1)); }

/* v1.9.0：省章进度 / 旅行人格 */
.stamp-row { display: flex; align-items: center; gap: 14rpx; margin: 14rpx 26rpx 0; }

.stamp-track { flex: 1; height: 12rpx; border-radius: 10rpx; background: rgba(var(--ln-rgb,100,116,139),.12); overflow: hidden; }

.stamp-fill { height: 100%; border-radius: 10rpx; background: linear-gradient(90deg, #e2c078, #c9a14a); }

.stamp-t { font-size: calc(20rpx * var(--fs, 1)); flex-shrink: 0; }

.persona-line { display: flex; align-items: flex-start; gap: 8rpx; font-size: calc(22rpx * var(--fs, 1)); color: var(--tx-2, #46536b); margin: 12rpx 26rpx 0; line-height: 1.5; }

/* v1.19.137 本机数据洞察 */
.ins-sub { margin: -2rpx 8rpx 14rpx; }
.ins-empty { padding: 6rpx 8rpx 2rpx; }
.ins-sum { font-size: calc(25rpx * var(--fs, 1)); color: var(--t1, #1b2330); line-height: 1.6; margin: 0 8rpx 18rpx; padding: 14rpx 16rpx; background: rgba(212,169,78,.10); border-left: 4rpx solid #d4a94e; border-radius: 8rpx; }
.ins-sec { margin: 16rpx 8rpx 0; }
.ins-h { font-size: calc(22rpx * var(--fs, 1)); color: var(--t3, #8fa3bc); margin-bottom: 10rpx; }
.ins-row { display: flex; align-items: center; gap: 12rpx; margin-bottom: 10rpx; }
.ins-lab { width: 210rpx; flex-shrink: 0; font-size: calc(23rpx * var(--fs, 1)); color: var(--t2, #3a4759); }
.ins-amt { color: var(--t3, #8fa3bc); font-size: calc(20rpx * var(--fs, 1)); }
.ins-bar { flex: 1; height: 16rpx; background: rgba(var(--ln-rgb, 148,163,184), .12); border-radius: 8rpx; overflow: hidden; }
.ins-fill { height: 100%; background: linear-gradient(90deg, #e2b65c, #b8892f); border-radius: 8rpx; }
.ins-pct { width: 66rpx; text-align: right; font-size: calc(21rpx * var(--fs, 1)); color: var(--t3, #8fa3bc); }
.ins-months { display: flex; align-items: flex-end; gap: 14rpx; height: 180rpx; }
.ins-m { width: 60rpx; height: 180rpx; display: flex; flex-direction: column; align-items: center; }
.ins-mb { width: 38rpx; flex: 1; display: flex; align-items: flex-end; background: rgba(var(--ln-rgb, 148,163,184), .12); border-radius: 6rpx; overflow: hidden; }
.ins-mf { width: 100%; background: linear-gradient(180deg, #e2b65c, #b8892f); border-radius: 6rpx; min-height: 4rpx; }
.ins-my { font-size: calc(18rpx * var(--fs, 1)); color: var(--t3, #8fa3bc); margin-top: 6rpx; line-height: 1; }
.ins-chips { display: flex; flex-wrap: wrap; gap: 12rpx; }
.ins-chip { font-size: calc(22rpx * var(--fs, 1)); color: var(--t2, #3a4759); background: rgba(var(--ln-rgb, 148,163,184), .10); border-radius: 999rpx; padding: 8rpx 18rpx; }
