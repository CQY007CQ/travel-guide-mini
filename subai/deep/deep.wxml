<view class="page fz0">
  <view class="tip" wx:if="{{msg}}">{{msg}}</view>

  <block wx:if="{{ready && cur}}">
    <!-- 头部：城市 + 内容口径 -->
    <view class="card dp-head">
      <view class="dp-title-row">
        <image class="ic" src="/images/icons/city.png"/>
        <text class="dp-title">{{cur.name}}</text>
      </view>
      <view class="dp-sub dim">{{cur.updated}} 整理 · 共 {{cur.total}} 条 · 经验参考，票价与班次以官方当日公告为准</view>
      <view class="dp-copy" bindtap="onCopy"><image class="ic ic-sm" src="/images/icons/copy.png"/>复制这份清单</view>
    </view>

    <!-- 城市切换 -->
    <scroll-view class="dp-cities" scroll-x show-scrollbar="{{false}}" wx:if="{{cities.length > 1}}">
      <view class="dp-row">
        <view class="dp-chip {{item === curName ? 'on' : ''}}" wx:for="{{cities}}" wx:key="*this"
              data-c="{{item}}" bindtap="onPick">{{item}}</view>
      </view>
    </scroll-view>

    <view class="dp-note" wx:if="{{adOn && !allUnlocked && cities.length > 1}}">带进来的这座城免费看 · 切到别的城市需解锁（当天有效）</view>

    <!-- 一句话速览 -->
    <view class="card dp-teaser" wx:if="{{cur.teasers.length}}">
      <view class="tz-li" wx:for="{{cur.teasers}}" wx:key="k"><text class="tz-dot"></text>{{item.x}}</view>
    </view>

    <!-- 内容块 -->
    <view class="card dp-card" wx:for="{{cur.blocks}}" wx:key="k" wx:for-item="bk">
      <view class="dp-bt"><image class="ic ic-sm" src="/images/icons/{{bk.icon}}.png"/>{{bk.t}}</view>
      <view class="dp-li" wx:for="{{bk.items}}" wx:key="k" wx:for-item="li">{{li.x}}</view>
      <view class="dp-trip" wx:for="{{bk.trips}}" wx:key="k" wx:for-item="tp">
        <view class="dp-tname">{{tp.name}}</view>
        <view class="dp-tmeta dim">{{tp.meta}}</view>
        <view class="dp-twhy">{{tp.why}}</view>
      </view>
    </view>

    <view class="tip">内容为本产品的离线经验整理，不随时间自动更新</view>
  </block>
</view>
