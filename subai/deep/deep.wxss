/* deep：城市深度玩法 —— 变量全部走全局双主题 token，不写死颜色 */
.page { padding: 20rpx 24rpx 60rpx; }

.dp-head { padding: 26rpx 28rpx 22rpx; }
.dp-title-row { display: flex; align-items: center; gap: 10rpx; }
.dp-title { font-size: calc(38rpx * var(--fs, 1)); font-weight: 700; color: var(--t1, #18233a); letter-spacing: .5rpx; }
.dp-sub { margin-top: 8rpx; font-size: calc(23rpx * var(--fs, 1)); line-height: 1.6; }
.dp-copy {
  margin-top: 18rpx; display: inline-flex; align-items: center; gap: 8rpx;
  padding: 10rpx 22rpx; border-radius: 999rpx;
  background: rgba(19, 29, 49, .05); color: var(--dim, #5b6b82);
  font-size: calc(24rpx * var(--fs, 1));
  transition: transform .18s ease, background .18s ease;
}
.dp-copy:active { transform: scale(.955); background: rgba(19, 29, 49, .09); }

/* 城市切换 chips */
.dp-cities { margin: 18rpx 0 4rpx; white-space: nowrap; }
.dp-row { display: inline-flex; gap: 14rpx; padding: 4rpx 2rpx 10rpx; }
.dp-chip {
  flex: none; padding: 12rpx 26rpx; border-radius: 999rpx;
  background: var(--card, #fff); color: var(--t2, #5b6b82);
  border: 1rpx solid rgba(var(--ln-rgb, 19, 29, 49), .10);
  font-size: calc(26rpx * var(--fs, 1));
  transition: transform .18s ease, color .18s ease, border-color .18s ease;
}
.dp-chip.on {
  color: var(--gold-tx, #8f6a1f); font-weight: 700;
  border-color: rgba(212, 169, 78, .55);
  box-shadow: inset 0 0 0 1rpx rgba(212, 169, 78, .35);
}
.dp-chip:active { transform: scale(.955); }

/* 一句话速览 */
.dp-teaser { padding: 22rpx 26rpx; background: var(--strip-bg, linear-gradient(135deg, rgba(212,169,78,.18) 0%, rgba(212,169,78,.05) 60%, #fff 100%)); }
.tz-li { display: flex; align-items: flex-start; gap: 12rpx; padding: 6rpx 0; color: var(--tx, #18233a); font-size: calc(26rpx * var(--fs, 1)); line-height: 1.6; }
.tz-dot { flex: none; width: 10rpx; height: 10rpx; margin-top: 16rpx; border-radius: 50%; background: var(--gold, #d4a94e); }

/* 内容块 */
.dp-card { margin-top: 20rpx; padding: 24rpx 26rpx 26rpx; }
.dp-bt { display: flex; align-items: center; gap: 10rpx; font-size: calc(29rpx * var(--fs, 1)); font-weight: 700; color: var(--t1, #18233a); }
.dp-li { margin-top: 14rpx; padding-left: 4rpx; color: var(--tx-2, #46536b); font-size: calc(26rpx * var(--fs, 1)); line-height: 1.7; }

/* 顺手加一日 */
.dp-trip {
  margin-top: 16rpx; padding: 16rpx 20rpx; border-radius: 16rpx;
  background: rgba(19, 29, 49, .04);
  border-left: 4rpx solid var(--gold, #d4a94e);
}
.dp-tname { font-size: calc(27rpx * var(--fs, 1)); font-weight: 700; color: var(--t1, #18233a); }
.dp-tmeta { margin-top: 4rpx; font-size: calc(23rpx * var(--fs, 1)); }
.dp-twhy { margin-top: 8rpx; color: var(--tx-2, #46536b); font-size: calc(25rpx * var(--fs, 1)); line-height: 1.65; }

@media (prefers-reduced-motion: reduce) {
  .dp-chip, .dp-copy { transition: none; }
}
.dp-note { margin: 4rpx 6rpx 0; font-size: calc(22rpx * var(--fs, 1)); color: var(--t4, #7d92ab); line-height: 1.6; }
