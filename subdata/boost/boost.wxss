.page { padding: 24rpx 28rpx 60rpx; }
.hd { margin-bottom: 24rpx; }
.hd-title { display: block; font-size: calc(40rpx * var(--fs, 1)); font-weight: 500; color: var(--color-text-primary, #222); }
.hd-sub { display: block; margin-top: 6rpx; font-size: calc(24rpx * var(--fs, 1)); color: var(--color-text-secondary, #777); }
.card { background: var(--color-background-secondary, #fff); border: 1rpx solid var(--color-border-tertiary, rgba(0,0,0,0.1)); border-radius: 16rpx; padding: 22rpx 24rpx; margin-bottom: 20rpx; }
.card-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 12rpx; }
.card-title { font-size: calc(30rpx * var(--fs, 1)); font-weight: 500; color: var(--color-text-primary, #222); }
.badge { font-size: calc(26rpx * var(--fs, 1)); color: var(--color-success, #0f6e56); font-weight: 500; }
.rows { display: flex; flex-direction: column; gap: 10rpx; }
.row { display: flex; align-items: flex-start; gap: 12rpx; margin: 6rpx 0; }
.dot { width: 14rpx; height: 14rpx; border-radius: 50%; margin-top: 12rpx; flex-shrink: 0; }
.dot.ok { background: var(--color-success, #1d9e75); }
.dot.no { background: var(--color-warning, #ba7517); }
.row-txt { flex: 1; font-size: calc(26rpx * var(--fs, 1)); line-height: 1.5; color: var(--color-text-primary, #333); }
.tip { margin-top: 8rpx; font-size: calc(24rpx * var(--fs, 1)); color: var(--color-text-secondary, #666); }
.empty { margin-top: 12rpx; font-size: calc(24rpx * var(--fs, 1)); color: var(--color-text-tertiary, #999); }
.qbar { display: flex; align-items: center; gap: 12rpx; margin-top: 8rpx; }
.qinput { flex: 1; min-width: 0; height: 64rpx; padding: 0 16rpx; font-size: calc(26rpx * var(--fs, 1)); background: var(--color-background-primary, #f7f7f7); border: 1rpx solid var(--color-border-tertiary, rgba(0,0,0,0.12)); border-radius: 12rpx; }
.mini-btn { margin: 0; flex-shrink: 0; }
.ans { margin-top: 12rpx; padding: 14rpx 16rpx; font-size: calc(26rpx * var(--fs, 1)); line-height: 1.5; color: var(--color-text-primary, #333); background: var(--color-background-info, rgba(24,95,165,0.08)); border-radius: 12rpx; }
.btn-row { display: flex; gap: 12rpx; margin-top: 12rpx; }
